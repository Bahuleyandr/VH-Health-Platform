# VH Health Admin Portal — Environment Variables
# Copy this file to .env.local and fill in the values

# Backend API
NEXT_PUBLIC_API_URL=https://vh-health-backend.onrender.com
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_API_KEY=

# CORS — allowed origin for credentials-based requests
NEXT_PUBLIC_ALLOWED_ORIGIN=https://vh-health-portal.vercel.app

# Sentry error tracking (optional for local dev)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

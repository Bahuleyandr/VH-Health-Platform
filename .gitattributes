.gitattributes text eol=lf
*.sh text eol=lf

# Migration function bodies and fail-closed textual anchors must retain the
# repository's LF bytes on every platform. CRLF checkout changes dollar-quoted
# strings and can make a fresh Windows database reject an otherwise identical
# migration chain.
apps/backend/src/migrations/*.sql text eol=lf

# Generated Dart contracts that a CI gate byte-compares against a freshly
# rendered string (scripts/generate-*.mjs --check, wired into
# scripts/ci/flutter.mjs and .github/workflows/_reusable-flutter-workspace.yml).
# The generators emit '\n'; without an LF pin, core.autocrlf=true checks these
# out as CRLF on Windows and the byte-compare fails on every Windows host even
# though the committed blob has not drifted at all. Any future generated file
# guarded by a `--check` byte-compare needs a line here too.
packages/vhhealth_core/lib/clinical/vital_plausibility_bounds.g.dart text eol=lf
apps/staff/lib/core/config/staff_role_contract.g.dart text eol=lf
apps/patient/lib/core/config/patient_notification_contract.g.dart text eol=lf

# Byte-exact provenance fixtures for the applied-migration immutability gate
# (scripts/ci/check-migration-immutability.test.mjs). The test asserts the raw
# sha256 of each file equals the historical blob it was copied from, which is
# what proves the negative control replays migration 566's REAL 03db4c44f edit
# rather than a hand-written lookalike. Without an LF pin, core.autocrlf=true
# rewrites them on Windows checkout and the provenance assertion fails.
scripts/ci/fixtures/migration-immutability/*.sql text eol=lf

# Melos / pub
.dart_tool/
pubspec_overrides.yaml
.flutter-plugins
.flutter-plugins-dependencies

# Flutter build output
build/

# IDEs
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
melos_*.log
output/

# Node (tooling scripts only — real node_modules live in sibling repos)
node_modules/

# Local environment files and credentials
.env
.env.*
!.env.example
!*.env.example

# Service account keys and private credentials must never be committed.
**/*firebase-adminsdk*.json
**/*service-account*.json
**/*service_account*.json
**/*google-application-credentials*.json
**/*.pem

# Added by ggshield
.cache_ggshield

# Local Claude Code session config (per-developer launch.json + agents).
# Most of .claude/ is gitignored, but team-shared skills carve out
# explicit exceptions. Note the intermediate directories must be
# un-excluded first or git won't descend into them.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/vh-health-qa/

# Playwright / test runner artifacts (screenshots, .last-run.json, etc.)
test-results/

# Backend local object-storage emulator output
apps/backend/storage/

# QA harness run artifacts (raw stdout/stderr, JSON traces). Findings live
# under docs/qa-findings/ and ARE committed.
qa-runs/
  
# dbt (analytics warehouse) - local run artifacts  
infra/kubernetes/optional/analytics-warehouse/dbt/target/
infra/kubernetes/optional/analytics-warehouse/dbt/logs/
infra/kubernetes/optional/analytics-warehouse/dbt/profiles/.user.yml

# VH Health Admin Portal — Environment Variables
# Copy this file to .env.local and fill in the values

# ── Backend API ──────────────────────────────────────────────────────────────
# Public backend URL (browser-visible; the client actually calls same-origin
# /api/proxy, which forwards server-side).
NEXT_PUBLIC_API_URL=https://api.vhhealth.app
# Optional server-side override for the proxy/login routes — set when the pod
# should reach the backend over the cluster-internal Service instead of the
# public URL. Falls back to NEXT_PUBLIC_API_URL when unset.
BACKEND_URL=
# Optional websocket URL override (defaults to NEXT_PUBLIC_API_URL with wss://).
NEXT_PUBLIC_WS_URL=

# Server-only API key used by the /api/proxy and /api/login Next.js routes
# to authenticate to the backend. MUST match one of the backend's
# API_KEY / API_KEY_ADMIN values. Never expose as NEXT_PUBLIC_* — Next.js
# inlines NEXT_PUBLIC_* vars into the client bundle, so a public copy would
# ship this key to every browser. This key must never reach the browser.
# (Legacy name API_KEY is still read as a fallback; prefer BACKEND_API_KEY.)
BACKEND_API_KEY=

# JWT secret (must match backend's JWT signing secret for middleware
# verification). middleware.ts fails closed in production when unset.
JWT_SECRET=

# ── CORS / origin checks ─────────────────────────────────────────────────────
# Allowed origin for credentials-based requests (/api/login, /api/refresh,
# /api/logout, /api/proxy mutations).
NEXT_PUBLIC_ALLOWED_ORIGIN=https://admin.vhhealth.app
# Optional canonical origin enforced by middleware.ts (falls back to
# NEXT_PUBLIC_ALLOWED_ORIGIN when unset).
ADMIN_CANONICAL_ORIGIN=
# Comma-separated exact client IPs or IPv4 CIDR ranges allowed through
# middleware.ts. Optional in development; REQUIRED in production because an
# empty/missing allowlist deliberately fails closed.
ADMIN_IP_ALLOWLIST=

# ── CLI probes (src/scripts/*, run with npx tsx — never bundled) ─────────────
# Origin header the probes send; defaults to the local dev server on :3001.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3001
# Admin credentials for scripts/check-backend.ts (supplied per-run via env;
# do not store real credentials in .env.local).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Sentry error tracking (optional for local dev) ───────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

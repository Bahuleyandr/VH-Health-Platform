{
  "name": "vh-health-portal",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "predev": "npm run generate:types",
    "dev": "next dev --turbopack -p 3001",
    "dev:qa": "next dev --turbopack -p 3201",
    "prebuild": "npm run generate:types",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-eslint-ratchet.mjs",
    "lint:all": "npm run lint",
    "lint:eslint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "node scripts/check-format-ratchet.mjs",
    "pretest": "npm run generate:types",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --maxWorkers=50%",
    "test:ci-contracts": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:routes": "playwright test --project=chromium --workers=1 e2e/route-crawl.spec.ts && playwright test --project=chromium --workers=1 e2e/authenticated.spec.ts",
    "smoke:tables": "playwright test --project=chromium --workers=1 e2e/table-controls.spec.ts",
    "pretype-check": "npm run generate:types",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "clean": "node scripts/clean.mjs",
    "clean:install": "npm run clean && npm ci",
    "check:clinical-ai-bundle": "node scripts/check-clinical-ai-bundle.mjs",
    "check:dead-code": "knip --include files,dependencies,devDependencies,unlisted --reporter compact --no-exit-code",
    "check:lockfile-libc": "node ../../scripts/check-lockfile-libc.mjs admin",
    "check:no-public-secrets": "node scripts/check-no-public-secrets.mjs",
    "check:pwa-retirement": "node scripts/check-pwa-retirement.mjs",
    "generate:types": "openapi-typescript ../backend/src/docs/openapi.json -o src/lib/openapi.generated.ts",
    "probe:backend": "tsx src/scripts/check-backend.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-hot-toast": "^2.6.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "url": "^0.11.4",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.32.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "undici": "^8.10.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "8.5.25",
    "glob": "^10.5.0",
    "rimraf": "^5.0.10",
    "import-in-the-middle": "3.0.1",
    "@babel/plugin-transform-modules-systemjs": "^7.29.7",
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "fast-uri": "^3.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bahuleyandr/VH-Health-Platform.git",
    "directory": "apps/admin"
  },
  "knip": {
    "entry": [
      "src/app/**/{page,layout,loading,error,global-error,not-found,route}.ts?(x)",
      "src/{middleware,instrumentation}.ts",
      "instrumentation*.ts",
      "e2e/**/*.ts",
      "scripts/**/*.mjs"
    ],
    "project": [
      "src/**/*.{ts,tsx,css}",
      "e2e/**/*.ts",
      "*.{ts,mts,cts}",
      "scripts/**/*.mjs"
    ],
    "ignoreDependencies": [
      "bcrypt",
      "sharp",
      "ts-node",
      "webpack"
    ]
  },
  "bugs": {
    "url": "https://github.com/Bahuleyandr/VH-Health-Platform/issues"
  },
  "homepage": "https://github.com/Bahuleyandr/VH-Health-Platform/tree/main/apps/admin#readme"
}

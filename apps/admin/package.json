{
  "name": "vh-health-portal",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "node scripts/patch-minimatch-compat.mjs && node scripts/patch-redocly-js-yaml-compat.mjs",
    "predev": "npm run generate:types",
    "dev": "next dev --turbopack -p 3001",
    "dev:qa": "next dev --turbopack -p 3201",
    "prebuild": "npm run generate:types",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:all": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write",
    "pretest": "npm run generate:types",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:routes": "playwright test --project=chromium --workers=1 e2e/route-crawl.spec.ts && playwright test --project=chromium --workers=1 e2e/authenticated.spec.ts",
    "smoke:tables": "playwright test --project=chromium --workers=1 e2e/table-controls.spec.ts",
    "pretype-check": "npm run generate:types",
    "type-check": "tsc --noEmit",
    "clean": "node scripts/clean.js",
    "clean:install": "npm run clean && npm install",
    "clean:windows": "rmdir /s /q node_modules .next && del package-lock.json",
    "clean:unix": "rm -rf node_modules package-lock.json .next",
    "check:clinical-ai-bundle": "node scripts/check-clinical-ai-bundle.mjs",
    "check:no-public-secrets": "node scripts/check-no-public-secrets.mjs",
    "generate:types": "openapi-typescript ../backend/src/docs/openapi.json -o src/lib/openapi.generated.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.4.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@sentry/nextjs": "^10.56.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.17.0",
    "next": "16.3.0",
    "sharp": "^0.35.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.77.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "serialize-javascript": "^7.0.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "url": "^0.11.4",
    "use-debounce": "^10.1.1",
    "workbox-build": "^7.4.1",
    "workbox-webpack-plugin": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/gtag.js": "^0.0.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "undici": "^8.5.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "8.5.25",
    "minimatch": "10.2.5",
    "glob": "^10.5.0",
    "rimraf": "^5.0.10",
    "import-in-the-middle": "3.0.1",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.7",
    "workbox-build": {
      "serialize-javascript": ">=7.0.5"
    },
    "@rollup/plugin-terser": {
      "serialize-javascript": "^7.0.5"
    },
    "@redocly/openapi-core": {
      "js-yaml": "5.2.3"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bahuleyandr/VH-Health-Platform.git",
    "directory": "apps/admin"
  },
  "bugs": {
    "url": "https://github.com/Bahuleyandr/VH-Health-Platform/issues"
  },
  "homepage": "https://github.com/Bahuleyandr/VH-Health-Platform/tree/main/apps/admin#readme"
}

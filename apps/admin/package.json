{
  "name": "vh-health-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:all": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:routes": "playwright test --project=chromium --workers=1 e2e/route-crawl.spec.ts && playwright test --project=chromium --workers=1 e2e/authenticated.spec.ts",
    "smoke:tables": "playwright test --project=chromium --workers=1 e2e/table-controls.spec.ts",
    "type-check": "tsc --noEmit",
    "clean": "node scripts/clean.js",
    "clean:install": "npm run clean && npm install",
    "clean:windows": "rmdir /s /q node_modules .next && del package-lock.json",
    "clean:unix": "rm -rf node_modules package-lock.json .next",
    "check:clinical-ai-bundle": "node scripts/check-clinical-ai-bundle.mjs",
    "generate:types": "npx openapi-typescript ../backend/src/docs/swagger-complete.yaml -o src/lib/api-types.generated.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@sentry/nextjs": "^10.51.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.24",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "15.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "serialize-javascript": "^7.0.5",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "url": "^0.11.4",
    "use-debounce": "^10.1.1",
    "workbox-build": "^7.4.0",
    "workbox-webpack-plugin": "^7.4.0",
    "zod": "^3.25.75"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",

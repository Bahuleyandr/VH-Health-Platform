{
  // audit-ci config — gates `npm run ci` (backend) on dependency advisories.
  // Fails the build on HIGH or CRITICAL severity. This replaces the previous
  // `npm audit --audit-level=high && audit-ci --critical` pair: `npm audit`
  // has no allowlist, so a single unfixable dev-only advisory could not be
  // waived without dropping the whole high-severity gate. audit-ci keeps the
  // HIGH bar AND lets us waive individually-reviewed advisories below.
  "high": true,
  // Intentionally empty. Keep it that way unless an advisory is genuinely
  // unfixable — audit-ci warns ("Consider not allowlisting advisory: X") when
  // an entry stops matching, and a stale waiver silently masks the next real
  // finding for that package.
  //
  // Removed 2026-08-04: GHSA-h67p-54hq-rp68 (js-yaml merge-key quadratic DoS).
  // The waiver was written when the sole path was
  // @istanbuljs/load-nyc-config → js-yaml@3.14.2 and the 3.x line had no patch.
  // That is no longer true: the advisory publishes patches for BOTH lines
  // (< 3.15.0 → 3.15.0, and >= 4.0.0 <= 4.1.1 → 4.2.0), and this tree now
  // resolves a 3.15.x under load-nyc-config plus a 4.3.x at the root — both
  // at or above their patch. `npm audit` no longer reports it, so the entry
  // was dead. (Exact patch versions are deliberately not named here; they
  // move with every lockfile refresh and would make this comment stale.)
  "allowlist": []
}

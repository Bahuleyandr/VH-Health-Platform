# VH Health Backend — Environment Variables
# Copy this file to .env and fill in the values

# Required
API_KEY=<your-api-key>
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/vhhealth
JWT_SECRET=<your-jwt-secret>
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@vhhealth.com
ADMIN_BOOTSTRAP_NAME=Super Admin

# Optional — read replica for analytics/exports
DATABASE_READ_URL=

# Optional — Redis cache for horizontal scaling
REDIS_URL=redis://localhost:6379

# Server
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Cloudflare R2 Storage (optional — file uploads will fail without these)
CF_ACCOUNT_ID=
CF_R2_BUCKET=vh-health-records
CF_R2_URL=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# Firebase (optional — Firebase auth will not work without this)
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store as an environment secret with literal newlines escaped as \n.
FIREBASE_PRIVATE_KEY=

# Sentry (optional — error monitoring disabled without this)
SENTRY_DSN=
GIT_COMMIT=

# Observability log format: "json" for production aggregators (CloudWatch/
# Loki/Datadog), "text" for human-readable. Defaults to json in production,
# text in development.
LOG_FORMAT=

# Webhook alerting (optional — alerts disabled without these)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_CRITICAL=
ALERT_DEBOUNCE_MS=300000
ALERTS_ENABLED=true

# Campus geofence (optional — defaults to Nandanam, Chennai)
CAMPUS_LATITUDE=13.02936
CAMPUS_LONGITUDE=80.24409
CAMPUS_RADIUS_METERS=200

# AI Summarization (optional — for auto-generating discharge summaries)
# Supports Ollama, llama.cpp, or any OpenAI-compatible local API
AI_SUMMARIZE_URL=
AI_SUMMARIZE_MODEL=llama3

# ABDM (Ayushman Bharat Digital Mission) — Indian health data exchange compliance
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_BRIDGE_URL=https://dev.abdm.gov.in/devservice/v1
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_HIP_NAME=Venkataeswara Hospitals
ABDM_CALLBACK_URL=
ABDM_ENABLED=false

# ────────────────────────────────────────────────────────────────────────────
# Phase 3: clinical + revenue + chatbot
# ────────────────────────────────────────────────────────────────────────────

# AI Symptom Checker (Phase 3G). Leave CHATBOT_PROVIDER unset to disable
# the /chatbot/triage endpoint; it returns 503 until configured.
# Provider options:
#   anthropic — Anthropic Messages API (needs CHATBOT_API_KEY)
#   openai    — any OpenAI-compatible /chat/completions server (Ollama,
#               vLLM, llama.cpp server, LM Studio, local proxy, etc)
CHATBOT_PROVIDER=
CHATBOT_BASE_URL=
CHATBOT_MODEL=
CHATBOT_API_KEY=
# Back-compat alias: if CHATBOT_API_KEY is unset and provider=anthropic,
# the triage service will pick this up.
ANTHROPIC_API_KEY=

# X12 837P claim generation (Phase 3D — revenue cycle).
# These land in the ISA/GS/NM1*85 envelope of every generated claim.
EDI_SUBMITTER_NAME=VH HEALTH
EDI_SUBMITTER_ID=VHHEALTH01
EDI_SUBMITTER_CONTACT=Billing Department
EDI_SUBMITTER_PHONE=
EDI_PROVIDER_NAME=VENKATAESWARA HOSPITAL
EDI_PROVIDER_NPI=0000000000
EDI_PROVIDER_TAXID=00-0000000
EDI_PROVIDER_ADDR=
EDI_PROVIDER_CITY=CHENNAI
EDI_PROVIDER_STATE=TN
EDI_PROVIDER_POSTAL=

# Client app version gate (Phase 5.6 — consumed by /health/client-requirements).
# Apps below these versions render a blocking upgrade screen at boot.
PATIENT_MIN_VERSION=1.0.0
PATIENT_RECOMMENDED_VERSION=1.0.0
PATIENT_ANDROID_URL=https://play.google.com/store/apps/details?id=com.vhhealth.patient
PATIENT_IOS_URL=https://apps.apple.com/app/vh-health/id0
STAFF_MIN_VERSION=1.0.0
STAFF_RECOMMENDED_VERSION=1.0.0
STAFF_ANDROID_URL=https://play.google.com/store/apps/details?id=com.vhhealth.staff
STAFF_IOS_URL=https://apps.apple.com/app/vh-health-staff/id0

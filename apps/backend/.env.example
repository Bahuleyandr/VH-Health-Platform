# VH Health Backend — Environment Variables
# Copy this file to .env and fill in the values

# Required
API_KEY=<your-api-key>
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/vhhealth
JWT_SECRET=<your-jwt-secret>
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@vhhealth.com
ADMIN_BOOTSTRAP_NAME=Super Admin

# ──────────────────────────────────────────────────────────────────────────
# Required — at-rest encryption keys (MANDATORY, min 32 chars each).
# The backend refuses to boot if any of these are missing or shorter than
# 32 characters. There is NO fallback to JWT_SECRET — each key protects a
# distinct data class and must be rotated independently.
#
# Generate each one with:
#     openssl rand -base64 32
#
# In production, deliver these via SealedSecrets / External Secrets on the
# RKE2 cluster — NEVER commit real values. See docs/DEPLOYMENT_GUIDE.md#secrets.
# ──────────────────────────────────────────────────────────────────────────
# Protects PHI columns at rest (AES-256-GCM via src/utils/fieldEncryption.js).
FIELD_ENCRYPTION_KEY=
# OPTIONAL — envelope-encryption KEK for enc:v2: field payloads. Unset => derived
# from FIELD_ENCRYPTION_KEY (back-compat). Set a dedicated value to separate the
# KEK from the legacy data key. *_ID stamps the keyId into each payload.
FIELD_ENCRYPTION_KEK=
FIELD_ENCRYPTION_KEK_ID=
# OPTIONAL — previous KEK + its id, kept alongside the new key during a rotation
# so a single process can unwrap DEKs still wrapped under the retired KEK.
# See scripts/rotate-field-kek.mjs. Remove once rotation reports 0 old-keyId rows.
FIELD_ENCRYPTION_KEK_OLD=
FIELD_ENCRYPTION_KEK_OLD_ID=
# OPTIONAL — separate HMAC key for searchableHash() (deterministic search index).
# Unset => legacy-derived key (existing hashes keep matching). Rotating to a real
# value REQUIRES scripts/rebuild-search-hashes.mjs to re-hash existing rows.
FIELD_SEARCH_HMAC_KEY=
# Protects user TOTP shared secrets at rest (src/utils/totpUtils.js).
TOTP_ENCRYPTION_KEY=
# Protects openssl-encrypted DB backups (deploy/*backup*.sh, src/scripts/encrypted-*.sh).
BACKUP_ENCRYPTION_KEY=

# Master switch for the I03 inbound HL7 ingress (POST /api/v1/hl7/receive).
# Fail-closed and AUTHORITATIVE: only the exact value `true` accepts inbound
# messages. While it is anything else — including unset — the endpoint refuses
# every message with a 403 + HL7 `MSA|AR` before any credential is resolved,
# whether that credential is a tenant_interop_secrets row or the shared secret
# below. Provisioning the secret alone does NOT turn ingress on.
HL7_INBOUND_ENABLED=false
# Required once HL7_INBOUND_ENABLED=true — signs API-key-only inbound HL7
# clinical writes. Generate with `openssl rand -base64 32`; provision via
# SealedSecret.
HL7_INBOUND_SHARED_SECRET=

# Optional — read replica for analytics/exports
DATABASE_READ_URL=

# Optional — embedded Metabase dashboards. Metabase must point only at the
# analytics warehouse marts as vh_metabase; never connect it to OLTP.
METABASE_URL=
METABASE_EMBED_SECRET=
METABASE_DASH_DAILY_OPS=
METABASE_DASH_OPD_VOLUME=
METABASE_DASH_IP_OCCUPANCY=
METABASE_DASH_REVENUE_PAYER_MIX=
METABASE_DASH_LAB_TAT=
METABASE_DASH_DOCTOR_PROD=
METABASE_DASH_OR_THROUGHPUT=
METABASE_DASH_SAFETY=

# Optional local/dev standalone Redis. Production must use the Sentinel fields
# from infra/kubernetes/apps/backend/configmap.yaml instead of REDIS_URL.
REDIS_URL=redis://localhost:6379
#REDIS_REQUIRE_SENTINEL=false
#REDIS_SENTINEL_HOSTS=redis-0.example:26379,redis-1.example:26379,redis-2.example:26379
#REDIS_SENTINEL_MASTER=vhhealth-primary
#REDIS_USERNAME=vhhealth-backend
#REDIS_PASSWORD=
#REDIS_SENTINEL_USERNAME=vhhealth-discovery
#REDIS_SENTINEL_PASSWORD=

# Server
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# HTTP server timeouts (REL-4 / B2.4 — slow-loris / hung-request protection).
# keepAliveTimeout MUST be < headersTimeout to avoid a Node.js race on
# keep-alive connections. Defaults: request=60s, keepAlive=61s, headers=65s.
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_KEEPALIVE_TIMEOUT_MS=61000
HTTP_HEADERS_TIMEOUT_MS=65000

# App-layer DB statement timeout (DB-2 / B2.8). Applied to the PRIMARY Prisma
# connection via the connection URL (?options=-c statement_timeout=<ms>).
# Overridden to 120s inside migration transactions — migrations are unaffected.
# STATEMENT_TIMEOUT_READ_MS applies to the read replica (DATABASE_READ_URL);
# leave at 0 (cluster default, 60s) so long analytics queries are not killed.
STATEMENT_TIMEOUT_MS=30000
STATEMENT_TIMEOUT_READ_MS=0

# Require TOTP MFA enrollment for SUPER_ADMIN accounts. When 'true', a
# SUPER_ADMIN without totp_enabled cannot get a full-access JWT — login
# returns an mfa_setup_required handshake with a 10-minute setup token.
REQUIRE_MFA_FOR_SUPER_ADMIN=true

# NL-1 P1 admin OIDC SSO operational limits. Tenant-specific issuer/client
# configuration lives in tenant_identity_providers, not global env.
SSO_OIDC_HTTP_TIMEOUT_MS=5000
SSO_METADATA_CACHE_TTL_SECONDS=300
SSO_ASSERTION_CLOCK_SKEW_SECONDS=60
# Must be false/empty in production. Never log raw assertions in normal use.
SSO_DEBUG_ASSERTION_LOGGING=false

# Tenant RLS enforcement. Defaults to true in NODE_ENV=production and false
# in dev/test. Set true locally only when using a non-superuser DB role or
# a runtime role (below).
AUTH_ENFORCE_TENANT_RLS=
# SET LOCAL ROLE target for tenant-scoped transactions (roadmap A2). Needed
# whenever the connection role would bypass RLS: superusers (dalekdefender,
# CI) bypass even FORCEd policies; table OWNERS (CNPG prod's `vhhealth`)
# bypass any policy that is not FORCEd. Production sets this to vhhealth_app
# (created by CNPG managed.roles; grants ensured at boot).
AUTH_TENANT_RLS_RUNTIME_ROLE=
# Legacy alias for AUTH_TENANT_RLS_RUNTIME_ROLE — still honored.
AUTH_TENANT_RLS_TEST_ROLE=

# Rate limiting (optional overrides). These apply ONLY to the generic
# `default` profile in src/config/rateLimitProfiles.js — the named profiles
# (patient/staff/auth/otp/...) are tuned per-surface and keep their values.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Cloudflare R2 Storage (optional — file uploads will fail without these)
CF_ACCOUNT_ID=
CF_R2_BUCKET=vh-health-records
CF_R2_URL=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# Firebase (optional — Firebase auth will not work without this)
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store as an environment secret with literal newlines escaped as \n.
FIREBASE_PRIVATE_KEY=
# Firebase App Check verification for mobile-app traffic.
# off = skip entirely; report = verify + log/metrics only (never rejects).
APP_CHECK_MODE=off
# Comma-separated exact Firebase app IDs allowed for each API client. Both are
# required when APP_CHECK_MODE=report. App IDs are public identifiers, not keys.
FIREBASE_APP_CHECK_PATIENT_APP_IDS=
FIREBASE_APP_CHECK_STAFF_APP_IDS=
# Local compatibility only. The legacy `/auth/firebase/register` endpoint
# creates a patient/session without Firebase ID-token proof, so it is disabled
# by default and always blocked in production even when this flag is true.
ENABLE_LEGACY_FIREBASE_REGISTER=false
# Local compatibility only. These routes mint patient JWTs without a full
# Firebase OTP proof and are disabled by default. Production ignores them even
# when accidentally set to true.
ENABLE_LEGACY_PHONE_AUTH=false
ENABLE_DEV_AUTH=false
# Testing-only SMART-on-FHIR admin helper for minting authorization codes.
# Disabled by default in every environment; use the public authorize flow for
# real integrations.
SMART_FHIR_ADMIN_AUTHORIZE_ENABLED=false

# Sentry (optional — error monitoring disabled without this)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
GIT_COMMIT=

# Observability log format: "json" for production aggregators (CloudWatch/
# Loki/Datadog), "text" for human-readable. Defaults to json in production,
# text in development.
LOG_FORMAT=

# Webhook alerting (optional — alerts disabled without these)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_CRITICAL=
ALERT_DEBOUNCE_MS=300000
ALERTS_ENABLED=true

# Campus geofence (optional — defaults to Nandanam, Chennai)
CAMPUS_LATITUDE=13.02936
CAMPUS_LONGITUDE=80.24409
CAMPUS_RADIUS_METERS=200

# Clinical AI (optional — discharge summaries and handover drafts)
# Default is template fallback. No PHI leaves the backend unless you explicitly
# select a provider and, for external/cloud providers, set
# CLINICAL_AI_ALLOW_EXTERNAL=true.
# Provider options: template, ollama, openai-compatible, openai, anthropic
CLINICAL_AI_PROVIDER=template
CLINICAL_AI_BASE_URL=
CLINICAL_AI_MODEL=llama3.1:8b
CLINICAL_AI_API_KEY=
# Cold local Ollama / deep-tier first inference can exceed the default. Use
# CLINICAL_AI_TIMEOUT_MS=120000 for readiness checks and local-GPU pilots.
CLINICAL_AI_TIMEOUT_MS=45000
CLINICAL_AI_MAX_TOKENS=2200
CLINICAL_AI_TEMPERATURE=0.15
CLINICAL_AI_ALLOW_EXTERNAL=false
# RAG embeddings for services/ai/ragService.js. The embed URL falls back to
# CLINICAL_AI_BASE_URL, then http://localhost:11434; the model defaults to
# nomic-embed-text and must return 768-dim vectors.
CLINICAL_AI_EMBED_URL=
CLINICAL_AI_EMBED_MODEL=nomic-embed-text
# Operational forecast alert sweep (advisory). Off by default.
CLINICAL_AI_OPERATIONAL_ALERTS_ENABLED=false
# Nightly clinical-coding suggestion batch (01:45). OFF by default and
# double-gated: this flag AND the clinical_coding_assist module toggle must
# both be enabled. Suggestions only ever land as pending review items for the
# coding team — nothing is auto-applied to claims or the record. Encounter
# text is de-identified before any external model call.
CLINICAL_AI_CODING_BATCH_ENABLED=false
# CLINICAL_AI_CODING_BATCH_LIMIT=25
# CLINICAL_AI_CODING_BATCH_LOOKBACK_DAYS=14
# Revenue-cycle standing-queue tracker sweep (advisory, read-model only). Off by default.
REVENUE_CYCLE_TRACKER_ENABLED=false
# Unified care-pathway projector shadow and stale-lease sweeps. Off by default.
PATHWAY_PROJECTOR_SHADOW_ENABLED=false
# Unified care-pathway reconciliation is observation/evidence only. Both the
# scheduler and the separately reviewed per-rule repair kernel default off.
CARE_PATHWAY_RECONCILIATION_ENABLED=false
CARE_PATHWAY_RECONCILIATION_REPAIR_ENABLED=false
# Operational collection cadence only; never use this as a clinical or
# activation threshold.
CARE_PATHWAY_RECONCILIATION_CRON=*/15 * * * *

# ── Clinical AI deep tier ──────────────────────────────────────────────
# Modules with `model_tier: 'deep'` (discharge_summary, medication_
# reconciliation, abnormal_result_triage, obstetric_risk_assistant) get
# routed to a separate deep-tier provider. Phase 4 of the rollout
# (docs/CLINICAL_AI_ROLLOUT_PLAN.md) recommends an in-cluster Ollama node
# so PHI never leaves the hospital building.
#
# Falls back to the standard CLINICAL_AI_* chain above when these are
# unset — single-credential deployments keep working. Deep-tier calls share
# CLINICAL_AI_TIMEOUT_MS; set it to 120000 when a cold local model is expected.
#
# Default deployment shape (in-cluster Ollama from
# infra/kubernetes/apps/ollama/):
#   CLINICAL_AI_DEEP_PROVIDER=ollama
#   CLINICAL_AI_DEEP_BASE_URL=http://ollama-internal.vhhealth.svc.cluster.local:11434
#   CLINICAL_AI_DEEP_MODEL=llama3:70b      # or qwen2.5:14b for smaller GPUs
#   (no API key needed)
#
# External Anthropic deep tier (e.g. discharge-summary drafting). EVERY egress
# gate must be opened explicitly and independently: CLINICAL_AI_ALLOW_EXTERNAL,
# the per-module external_allowed flag, and the CLINICAL_AI_EXTERNAL_REGIONS
# allowlist. The API key is env-only — never commit a real key.
#   CLINICAL_AI_DEEP_PROVIDER=anthropic
#   CLINICAL_AI_DEEP_MODEL=claude-sonnet-5
#   CLINICAL_AI_DEEP_API_KEY=<from your secret manager>
#   (CLINICAL_AI_DEEP_BASE_URL defaults to https://api.anthropic.com)
CLINICAL_AI_DEEP_PROVIDER=
CLINICAL_AI_DEEP_BASE_URL=
CLINICAL_AI_DEEP_MODEL=
CLINICAL_AI_DEEP_API_KEY=
# Optional estimated cost tracking. Values are in minor currency units per
# million tokens, e.g. cents or paise. Leave blank to track tokens only.
CLINICAL_AI_INPUT_COST_PER_MILLION_MINOR=
CLINICAL_AI_OUTPUT_COST_PER_MILLION_MINOR=

# ── Staff Dictation V1 STT ─────────────────────────────────────────────
# Default stays none: staff dictation buttons render disabled with
# "Dictation not configured" instead of recording audio that can only produce
# an empty/skipped transcript.
# Provider options: none, openai-compatible
# Local faster-whisper example:
#   STT_PROVIDER=openai-compatible
#   STT_BASE_URL=http://127.0.0.1:8080
#   STT_MODEL=large-v3
STT_PROVIDER=none
STT_BASE_URL=
STT_MODEL=
STT_TIMEOUT_MS=60000
# Optional language and prompt bias sent to /v1/audio/transcriptions.
STT_LANGUAGE=
STT_PROMPT=
# Optional for authenticated OpenAI-compatible gateways. Local faster-whisper
# usually leaves this blank.
STT_API_KEY=

# DB-backed admin guardrails are the primary control surface. These defaults
# are used only before the guardrail table exists.
# Daily caps are optional; blank means no cap.
# The request cap clamps provider max_tokens/output tokens.
# OpenAI native provider can also read OPENAI_API_KEY. Optional org/project
# headers are supported for project-scoped deployments.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
# Anthropic native provider can also read ANTHROPIC_API_KEY and uses the
# Messages API version below when provided.
ANTHROPIC_VERSION=2023-06-01

# Imaging AI PACS metadata import. Raw DICOM pixels remain in PACS; this
# adapter imports study metadata through DICOMweb QIDO-RS or Orthanc native
# search so AI findings can cite a registered study.
# Provider options: none, dicomweb, orthanc, orthanc_native, dcm4chee
CLINICAL_AI_PACS_PROVIDER=none
CLINICAL_AI_PACS_API_MODE=dicomweb
CLINICAL_AI_PACS_BASE_URL=
CLINICAL_AI_PACS_USERNAME=
CLINICAL_AI_PACS_PASSWORD=
CLINICAL_AI_PACS_TIMEOUT_MS=8000
CLINICAL_AI_PACS_ALLOWED_REGIONS=

# Back-compat aliases for older local summarization deployments.
AI_SUMMARIZE_URL=
AI_SUMMARIZE_MODEL=llama3

# ABDM (Ayushman Bharat Digital Mission) — Indian health data exchange compliance
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_BRIDGE_URL=https://dev.abdm.gov.in/devservice/v1
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_HIP_NAME=Venkataeswara Hospitals
ABDM_CALLBACK_URL=
# Required when ABDM_ENABLED=true — signs public ABDM callback requests.
# Generate with `openssl rand -base64 32`; provision via SealedSecret.
ABDM_CALLBACK_SECRET=
# Required when ABDM_ENABLED=true (CAN-026): Consent-Manager artefact signature
# verification MUST be on, with the CM public key present — otherwise the backend
# refuses to boot (it must never accept unsigned/forged consent artefacts).
ABDM_VERIFY_CONSENT_ARTEFACT=true
ABDM_CM_PUBLIC_KEY=
ABDM_ENABLED=false

# NHCX (National Health Claims Exchange) — NL-2 P1 is inert/mock-first.
# Keep disabled until live NHCX/NRCeS version, participant codes, gateway URLs,
# and certificate/JWE requirements are locked by operators.
NHCX_ENABLED=false
NHCX_CREDENTIAL_CACHE_TTL_MS=60000

# ────────────────────────────────────────────────────────────────────────────
# Phase 3: clinical + revenue + chatbot
# ────────────────────────────────────────────────────────────────────────────

# AI Symptom Checker (Phase 3G). Leave CHATBOT_PROVIDER unset to run the
# 'template' provider: /chatbot/triage answers with a safe canned placeholder
# and makes zero external calls (503 only if provider=anthropic with no key).
# Provider options:
#   anthropic — Anthropic Messages API (needs CHATBOT_API_KEY)
#   openai    — any OpenAI-compatible /chat/completions server (Ollama,
#               vLLM, llama.cpp server, LM Studio, local proxy, etc)
CHATBOT_PROVIDER=
CHATBOT_BASE_URL=
CHATBOT_MODEL=
CHATBOT_API_KEY=
# Comma-separated tenant-region allowlist for EXTERNAL chatbot providers
# (e.g. "US,AP"; '*' allows all). Fail-closed like CLINICAL_AI_EXTERNAL_REGIONS:
# empty/unset denies any region-tagged tenant; only region-less tenants pass.
CHATBOT_EXTERNAL_REGIONS=
# Back-compat alias: if CHATBOT_API_KEY is unset and provider=anthropic,
# the triage service will pick this up.
ANTHROPIC_API_KEY=

# X12 837P claim generation (Phase 3D — revenue cycle).
# These land in the ISA/GS/NM1*85 envelope of every generated claim.
EDI_SUBMITTER_NAME=VH HEALTH
EDI_SUBMITTER_ID=VHHEALTH01
EDI_SUBMITTER_CONTACT=Billing Department
EDI_SUBMITTER_PHONE=
EDI_PROVIDER_NAME=VENKATAESWARA HOSPITAL
EDI_PROVIDER_NPI=0000000000
EDI_PROVIDER_TAXID=00-0000000
EDI_PROVIDER_ADDR=
EDI_PROVIDER_CITY=CHENNAI
EDI_PROVIDER_STATE=TN
EDI_PROVIDER_POSTAL=

# Public bill-payment landing page (billing payment links).
# Base URL prefixed to the link token in the SMS / WhatsApp / email we send the
# patient: <base>/<token>. It must resolve to this backend's public origin,
# because the page it serves is GET /pay/:token (mounted outside /api/v1).
# Defaults to https://api.vhhealth.app/pay when unset.
HOSPITAL_PAY_BASE_URL=https://api.vhhealth.app/pay

# Client app version gate (Phase 5.6 — consumed by /health/client-requirements).
# Apps below these versions render a blocking upgrade screen at boot.
PATIENT_MIN_VERSION=1.0.0
PATIENT_RECOMMENDED_VERSION=1.0.0
PATIENT_ANDROID_URL=https://play.google.com/store/apps/details?id=com.vhhealth.patient
PATIENT_IOS_URL=https://apps.apple.com/app/vh-health/id0
# Patient hard-upgrade build-code gate (consumed by /api/v1/config).
# 0 disables the hard block. Set to the minimum accepted mobile build number.
#
# THE TWO BELOW ARE COUPLED AND THE APP REFUSES TO BOOT OTHERWISE. A non-zero
# MIN_PATIENT_VERSION_CODE requires a valid PATIENT_MINIMUM_VERSION_POLICY_JSON:
# patient builds already in the field fail closed on a minimum they cannot
# verify, so a bare non-zero code burns their 24h bootstrap grace and then
# blocks EVERY install — including installs already above the code, and
# including their SOS path. validateEnv.js enforces both the presence and the
# structural validity of the envelope.
MIN_PATIENT_VERSION_CODE=0

# Offline-signed Ed25519 policy envelope. Leave blank while
# MIN_PATIENT_VERSION_CODE is 0 and until the matching public key is stamped
# into Patient release builds; the backend does not mint or rewrite this
# authority. Mint with: npm run patient:min-version:sign -- ...
PATIENT_MINIMUM_VERSION_POLICY_JSON=
# Optional C-D12 non-PHI operational copy returned by /api/v1/config.
# Strict JSON keys: revision, messages(en/hi/ta/te/ml), facility_contact_number.
# Every localized message contains the literal [facility contact number] token.
# Operational copy only: never include policy, security, or patient-specific data.
# Update through the existing environment/configuration administration path only.
PATIENT_OUTAGE_COMMUNICATION_JSON=
STAFF_MIN_VERSION=1.0.0
STAFF_RECOMMENDED_VERSION=1.0.0
STAFF_ANDROID_URL=https://play.google.com/store/apps/details?id=com.vhhealth.staff
STAFF_IOS_URL=https://apps.apple.com/app/vh-health-staff/id0

# PACS / imaging viewer (roadmap B4) - set when infra/kubernetes/optional/pacs is enabled
PACS_DICOMWEB_URL=
PACS_VIEWER_URL=
PACS_AET=VHHEALTH

# HL7 outbound feed SSRF guard (audit finding H4). Optional comma-separated
# allowlist of approved feed hostnames. When set, /api/v1/hl7-feeds
# subscriptions and deliveries are restricted to EXACTLY these hosts
# (recommended in production). When empty, any publicly-routable host is
# allowed but loopback/private/link-local/metadata targets are always blocked.
HL7_FEED_HOST_ALLOWLIST=

# Storage signed-URL token secret (audit finding L3). When unset, a sub-key
# is derived from JWT_SECRET with a domain-separation label (HMAC). Set this
# in production to fully separate the storage and auth trust domains.
STORAGE_TOKEN_SECRET=

# Access-token TTLs (audit finding L1): short access tokens + 30d rotating
# refresh. Override only with a documented reason.
JWT_EXPIRES_IN=1h
JWT_STAFF_EXPIRES_IN=1h
JWT_ADMIN_EXPIRES_IN=4h
# Clinical continuity features remain inert until the compile-time owner gate
# and every prerequisite flag are also enabled.
CLINICAL_CONTINUITY_PAPER_RECONCILIATION_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────
# Security / clinical env vars read by the backend but previously
# undocumented (audit CFG-M2). All optional unless the feature is enabled;
# listed commented-out so copying this file never sets a half-configured
# security control.
# ──────────────────────────────────────────────────────────────────────────

# ── Per-tenant field-encryption KEK hierarchy (services/security/) ──
# Master material the per-tenant KEKs are scrypt-derived from
# (tenantKekProvider.js). Required for per-tenant field encryption.
#FIELD_ENCRYPTION_MASTER_KEK=
# KMS provider for wrapping data keys: 'env' (default) uses KMS_MASTER_KEY.
#KMS_PROVIDER=env
# Key id stamped into wrapped payloads (default 'env-default').
#KMS_KEY_ID=
# 32-byte base64 master wrap key for the 'env' KMS provider.
#KMS_MASTER_KEY=
# HMAC key for the searchable-PHI hash index (phiColumnEncryption.js).
# Deliberately SEPARATE from KMS_MASTER_KEY; 32 bytes base64, >=16 required.
#PHI_SEARCH_HASH_KEY=

# ── Infrastructure/monitoring access tokens (infrastructureAccessMiddleware) ──
# Any of the three gates /metrics + /health/deep scrape access; comma/space-
# separated multiple tokens are accepted (rotation overlap).
#MONITORING_TOKEN=
#METRICS_TOKEN=
#INTERNAL_MONITORING_TOKEN=
# CAN-054: DEDICATED tokens for the DB-free downtime PHI ward-pack mirror
# (/downtime/static). Provision separately from the monitoring tokens so a
# leaked scrape token cannot unlock ward packs.
#DOWNTIME_ACCESS_TOKEN=
#DOWNTIME_PACK_TOKEN=

# ── Security alert webhooks (utils/securityWebhook.js) ──
# Enable with SECURITY_WEBHOOKS_ENABLED=true; URL receives ACCOUNT_LOCKED /
# BRUTE_FORCE_DETECTED etc. CRITICAL is an optional separate critical-only URL.
# SECRET signs outgoing payloads.
#SECURITY_WEBHOOKS_ENABLED=false
#SECURITY_WEBHOOK_URL=
#SECURITY_WEBHOOK_CRITICAL=
#SECURITY_WEBHOOK_SECRET=

# ── SIEM export delivery (services/security/siemExportService.js) ──
# SSRF guard for SIEM webhook targets: exact-host allowlist, and a dev/test-
# only escape hatch for private targets (hard-refused in production).
#SIEM_EXPORT_WEBHOOK_HOST_ALLOWLIST=
#SIEM_EXPORT_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ── LiveKit teleconsultation (NL-3, services/telemedicine/) ──
# Token minting only happens when LIVEKIT_ENABLED=true and all three of the
# server URL + API key/secret are set.
#LIVEKIT_ENABLED=false
#LIVEKIT_SERVER_URL=
#LIVEKIT_API_KEY=
#LIVEKIT_API_SECRET=

# ── Twilio voice/WhatsApp notification channels (utils/notifications/) ──
# A channel is considered configured only when SID + auth token + its FROM
# number are all present; otherwise the outbox skips it.
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_VOICE_FROM=
#TWILIO_WHATSAPP_FROM=

# ── Admin IP allowlisting (middleware/ipAllowlistMiddleware.js) ──
# Comma-separated IPs/CIDRs allowed onto admin endpoints. Production fails
# closed: unset means admin endpoints are unreachable there.
#ADMIN_IP_ALLOWLIST=

# ── HL7 outbound SSRF guard (utils/ssrfGuard.js) ──
# Dev/test-only: allow loopback/private HL7 feed targets. Hard-refused in
# production regardless of value.
#HL7_FEED_ALLOW_PRIVATE_TARGETS=false

# ── CSSD sterility gate (services/cssd/cssdService.js) ──
# Currently defaults OFF, and even when 'true' it only sets

{
  "type": "module",
  "name": "vh-health-backend",
  "version": "1.0.0",
  "description": "VH Health API for managing patients, appointments, records, investigations, pharmacy orders, and feedback.",
  "private": true,
  "main": "src/bin/www.js",
  "scripts": {
    "postinstall": "node scripts/patch-minimatch-compat.mjs",
    "prestart": "npm run db:generate",
    "start": "node --enable-source-maps src/bin/www.js",
    "predev": "npm run db:generate",
    "dev": "nodemon src/bin/www.js",
    "build:prod": "echo 'No build needed — direct start used.'",
    "build:sentry": "node src/scripts/build-production.js",
    "debug": "node --inspect --enable-source-maps src/app.js",
    "lint": "eslint . --max-warnings=0 && npm run lint:raw-params && npm run lint:status-assertions && npm run check:phi-tenant-id && npm run check:no-default-tenant-fallback && npm run check:clinical-ai-external-regions && npm run check:vital-bounds && npm run secrets:scan",
    "lint:fix": "eslint . --fix",
    "lint:raw-params": "node scripts/lint-raw-params.mjs",
    "lint:status-assertions": "node scripts/check-status-assertions.mjs",
    "check:phi-tenant-id": "node scripts/check-phi-tenant-id.mjs",
    "check:no-default-tenant-fallback": "node scripts/check-no-default-tenant-fallback.mjs",
    "check:clinical-ai-external-regions": "node scripts/check-clinical-ai-external-region-guards.mjs",
    "check:vital-bounds": "node ../../scripts/generate-vital-bounds.mjs --check",
    "check:lockfile-libc": "node ../../scripts/check-lockfile-libc.mjs backend",
    "check:timestamptz-clock": "node scripts/check-timestamptz-clock-comparisons.mjs",
    "check:migration-numbers": "node scripts/check-migration-number-collisions.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "check:continuity-action-registry": "node scripts/check-clinical-continuity-action-registry.mjs",
    "dr:cross-site:preflight": "node scripts/dr-cross-site-preflight.mjs",
    "india:preflight": "node scripts/india-deployability-preflight.mjs",
    "india:evidence-template": "node scripts/india-evidence-template.mjs",
    "care-team:audit-enforcement-readiness": "node scripts/audit-care-team-enforcement-readiness.mjs",
    "secrets:scan": "node ../../scripts/scan-secrets.mjs",
    "security:audit-secret-encryption": "node src/scripts/security/audit-secret-encryption.js",
    "test:db:setup": "node scripts/ensure-test-db.mjs",
    "db:ensure-pgvector": "node scripts/ensure-pgvector-extension.mjs",
    "seed:test-data": "node scripts/seed-comprehensive-test-data.mjs",
    "db:contracts": "node scripts/check-db-contracts.mjs",
    "db:contracts:seeded": "node scripts/check-db-contracts.mjs --require-seeded",
    "ci:db-guardrails": "npm run db:contracts && npm run seed:test-data && npm run db:contracts:seeded && node scripts/ci-schema-drift.mjs",
    "ci:db-guardrails:docker": "node scripts/run-db-guardrails-docker.mjs",
    "ci:backend:docker": "node scripts/run-db-guardrails-docker.mjs --with-tests",
    "ci": "npm run lint && npm run check:migration-numbers && npx --yes audit-ci --config .audit-ci.jsonc && npm run db:generate && npm run openapi:check && npm run openapi:check-core && npx spectral lint src/docs/openapi.json && npm run openapi:lint-budget && npm run ci:backend:docker -- --with-coverage",
    "demo:tenant-pack": "node scripts/demo-tenant-scenario-pack.mjs",
    "pretest": "npm run db:generate && npm run test:db:setup",
    "test": "node --experimental-vm-modules --max-old-space-size=4096 node_modules/jest/bin/jest.js --runInBand",
    "test:ci": "node scripts/run-ci-jest.mjs",
    "prestart:local": "npm run db:generate",
    "start:local": "dotenv -e .env.local -- node src/bin/www.js",
    "prestart:render": "npm run db:generate",
    "start:render": "node src/bin/www.js",

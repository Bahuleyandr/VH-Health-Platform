{
  "type": "module",
  "name": "vh-health-backend",
  "version": "1.0.0",
  "description": "VH Health API for managing patients, appointments, records, investigations, pharmacy orders, and feedback.",
  "main": "src/bin/www.js",
  "scripts": {
    "start": "node --enable-source-maps src/bin/www.js",
    "dev": "nodemon src/bin/www.js",
    "build:prod": "echo 'No build needed — direct start used.'",
    "build:sentry": "node src/scripts/build-production.js",
    "debug": "node --inspect --enable-source-maps src/app.js",
    "lint": "eslint . --ext .js && npm run lint:raw-params && npm run secrets:scan",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:raw-params": "node scripts/lint-raw-params.mjs",
    "secrets:scan": "node ../../scripts/scan-secrets.mjs",
    "test:db:setup": "node scripts/ensure-test-db.mjs",
    "pretest": "npm run test:db:setup",
    "test": "node --experimental-vm-modules --max-old-space-size=4096 node_modules/jest/bin/jest.js --runInBand",
    "start:local": "dotenv -e .env.local -- node src/bin/www.js",
    "start:render": "node src/bin/www.js",
    "start:cluster": "node src/cluster.js",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "r2:migrate-archive": "node src/scripts/r2/r2-migrate-archive.js",
    "r2:cleanup-old": "node src/scripts/r2/r2-cleanup-old.js",
    "r2:list-files": "node src/scripts/r2/r2-list-files.js",
    "db:backup": "node src/scripts/backup-db.js",
    "db:restore": "node src/scripts/restore-db.js",
    "swagger:validate": "node src/scripts/validate-swagger.js",
    "swagger:generate": "node src/scripts/yaml-to-json-swagger.js",
    "swagger:generate-complete": "node src/scripts/generate-complete-swagger.js",
    "logs:cleanup": "node src/scripts/cleanup-logs.js",
    "logs:list": "node src/scripts/list-logs.js",
    "logs:purge": "node src/scripts/purge-logs.js",
    "fix:permissions": "node src/scripts/fix-permissions.js",
    "scheduler:run-now": "node -e \"import('./src/utils/scheduler.js').then(m => m.runAllScheduledTasksNow())\"",
    "generate-admin-token": "node src/scripts/development/generateAdminToken.js",
    "convert-to-relative": "node src/scripts/development/convert-aliases-to-relative.js",
    "convert-to-aliases": "node src/scripts/development/convert-relative-to-aliases.js",
    "dev:setup": "npm run generate-admin-token && echo 'Development environment ready'",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "load-test:health": "k6 run load-tests/k6/health.js",
    "load-test:auth": "k6 run load-tests/k6/auth.js",
    "load-test:api": "k6 run load-tests/k6/api.js",
    "test:watch": "node --experimental-vm-modules --max-old-space-size=2048 node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --max-old-space-size=2048 node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:suite": "node --experimental-vm-modules --max-old-space-size=2048 node_modules/jest/bin/jest.js --runInBand --testPathPatterns"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bahuleyandr/vh-health-backend.git"
  },
  "author": "VH Health Tech Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@aws-sdk/util-create-request": "^3.972.20",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.49.0",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "clamav.js": "^0.12.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-list-endpoints": "^7.1.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "ioredis": "^5.6.1",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "onnxruntime-node": "^1.20.0",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@sentry/cli": "^2.58.5",
    "@stoplight/spectral-cli": "^6.15.1",
    "@stoplight/spectral-core": "^1.22.0",
    "@stoplight/spectral-rulesets": "^1.22.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^3.0.4",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": "22.15.0"
  },
  "keywords": [
    "vh-health",
    "healthcare-api",
    "nodejs",
    "express",
    "postgresql",
    "swagger",
    "winston",
    "api"
  ],
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "setupFiles": [
      "<rootDir>/src/scripts/testing/jest.setup.cjs"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/scripts/testing/jest.teardown.cjs"
    ],
    "moduleNameMapper": {
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@controllers/(.*)$": "<rootDir>/src/controllers/$1",
      "^@routes/(.*)$": "<rootDir>/src/routes/$1",
      "^@middleware/(.*)$": "<rootDir>/src/middleware/$1",
      "^@logging/(.*)$": "<rootDir>/src/logging/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@scripts/(.*)$": "<rootDir>/src/scripts/$1"
    },
    "maxWorkers": 1,
    "workerThreads": false,
    "testMatch": [
      "<rootDir>/src/tests/**/*.test.js"
    ]
  },
  "overrides": {
    "lodash": ">=4.17.21",
    "minimatch": "^3.1.2",
    "rollup": "^2.80.0",
    "@tootallnate/once": "^3.0.1",
    "protobufjs": "^7.5.5"
  }
}

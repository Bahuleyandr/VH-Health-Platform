    "openapi:check": "node scripts/check-openapi-drift.mjs",
    "openapi:sync-core": "node scripts/sync-openapi-to-core.mjs",
    "openapi:check-core": "node scripts/check-core-spec-sync.mjs",
    "openapi:lint-budget": "node scripts/check-openapi-lint-budget.mjs",
    "patient:min-version:sign": "node scripts/sign-patient-minimum-version-policy.mjs",
    "nhcx:mock": "node scripts/test/nhcx-mock-exchange.mjs",
    "smoke:nhcx:mock": "node scripts/test/smoke-nhcx-mock-exchange.mjs",
    "logs:cleanup": "node src/scripts/cleanup-logs.js",
    "logs:list": "node src/scripts/list-logs.js",
    "logs:purge": "node src/scripts/purge-logs.js",
    "fix:permissions": "node src/scripts/fix-permissions.js",
    "scheduler:run-now": "node -e \"import('./src/utils/scheduler.js').then(m => m.runAllScheduledTasksNow())\"",
    "lab:reconcile-critical-alert-generations": "node scripts/reconcile-lab-critical-alert-generations.mjs",
    "lab:audit-care-pathway-spine-readiness": "node scripts/audit-care-pathway-spine-readiness.mjs",

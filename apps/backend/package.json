{
  "type": "module",
  "name": "vh-health-backend",
  "version": "1.0.0",
  "description": "VH Health API for managing patients, appointments, records, investigations, pharmacy orders, and feedback.",
  "private": true,
  "main": "src/bin/www.js",
  "scripts": {
    "prestart": "npm run db:generate",
    "start": "node --enable-source-maps src/bin/www.js",
    "predev": "npm run db:generate",
    "dev": "nodemon src/bin/www.js",
    "build:prod": "echo 'No build needed — direct start used.'",
    "build:sentry": "node src/scripts/build-production.js",
    "debug": "node --inspect --enable-source-maps src/app.js",
    "lint": "eslint . --max-warnings=0 && npm run lint:raw-params && npm run check:phi-tenant-id && npm run check:no-default-tenant-fallback && npm run check:clinical-ai-external-regions && npm run secrets:scan",
    "lint:fix": "eslint . --fix",
    "lint:raw-params": "node scripts/lint-raw-params.mjs",
    "check:phi-tenant-id": "node scripts/check-phi-tenant-id.mjs",
    "check:no-default-tenant-fallback": "node scripts/check-no-default-tenant-fallback.mjs",
    "check:clinical-ai-external-regions": "node scripts/check-clinical-ai-external-region-guards.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "india:preflight": "node scripts/india-deployability-preflight.mjs",
    "india:evidence-template": "node scripts/india-evidence-template.mjs",
    "secrets:scan": "node ../../scripts/scan-secrets.mjs",
    "security:audit-secret-encryption": "node src/scripts/security/audit-secret-encryption.js",
    "test:db:setup": "node scripts/ensure-test-db.mjs",
    "db:ensure-pgvector": "node scripts/ensure-pgvector-extension.mjs",
    "seed:test-data": "node scripts/seed-comprehensive-test-data.mjs",
    "db:contracts": "node scripts/check-db-contracts.mjs",
    "db:contracts:seeded": "node scripts/check-db-contracts.mjs --require-seeded",
    "ci:db-guardrails": "npm run db:contracts && npm run seed:test-data && npm run db:contracts:seeded && node scripts/ci-schema-drift.mjs",
    "ci:db-guardrails:docker": "node scripts/run-db-guardrails-docker.mjs",
    "ci:backend:docker": "node scripts/run-db-guardrails-docker.mjs --with-tests",
    "ci": "npm run lint && npx --yes audit-ci --config .audit-ci.jsonc && npm run swagger:validate && npx spectral lint src/docs/swagger-complete.yaml && npm run ci:backend:docker",
    "pretest": "npm run db:generate && npm run test:db:setup",
    "test": "node --experimental-vm-modules --max-old-space-size=4096 node_modules/jest/bin/jest.js --runInBand",
    "test:ci": "node scripts/run-ci-jest.mjs",
    "prestart:local": "npm run db:generate",
    "start:local": "dotenv -e .env.local -- node src/bin/www.js",
    "prestart:render": "npm run db:generate",
    "start:render": "node src/bin/www.js",
    "start:cluster": "node src/cluster.js",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "r2:migrate-archive": "node src/scripts/r2/r2-migrate-archive.js",
    "r2:cleanup-old": "node src/scripts/r2/r2-cleanup-old.js",
    "r2:list-files": "node src/scripts/r2/r2-list-files.js",
    "db:backup": "node src/scripts/backup-db.js",
    "db:restore": "node src/scripts/restore-db.js",
    "swagger:validate": "node src/scripts/validate-swagger.js",
    "swagger:generate": "node src/scripts/yaml-to-json-swagger.js",
    "swagger:generate-complete": "node src/scripts/generate-complete-swagger.js",
    "logs:cleanup": "node src/scripts/cleanup-logs.js",
    "logs:list": "node src/scripts/list-logs.js",
    "logs:purge": "node src/scripts/purge-logs.js",
    "fix:permissions": "node src/scripts/fix-permissions.js",
    "scheduler:run-now": "node -e \"import('./src/utils/scheduler.js').then(m => m.runAllScheduledTasksNow())\"",
    "generate-admin-token": "node src/scripts/development/generateAdminToken.js",
    "convert-to-relative": "node src/scripts/development/convert-aliases-to-relative.js",
    "convert-to-aliases": "node src/scripts/development/convert-relative-to-aliases.js",
    "dev:setup": "npm run generate-admin-token && echo 'Development environment ready'",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "load-test:health": "k6 run load-tests/k6/health.js",
    "load-test:auth": "k6 run load-tests/k6/auth.js",
    "load-test:api": "k6 run load-tests/k6/api.js",
    "test:watch": "node --experimental-vm-modules --max-old-space-size=2048 node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node scripts/run-coverage-jest.mjs",
    "test:suite": "node --experimental-vm-modules --max-old-space-size=2048 node_modules/jest/bin/jest.js --runInBand --testPathPatterns"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bahuleyandr/VH-Health-Platform.git",
    "directory": "apps/backend"
  },
  "author": "VH Health Tech Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/s3-request-presigner": "^3.1061.0",
    "@aws-sdk/util-create-request": "^3.972.27",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.56.0",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "clamav.js": "^0.12.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-list-endpoints": "^7.1.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.2.0",
    "iconv-lite": "^0.7.2",
    "ioredis": "^5.11.1",
    "javascript-lp-solver": "^1.0.3",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "onnxruntime-node": "^1.26.0",
    "otplib": "^13.4.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.34.5",
    "source-map-support": "^0.5.21",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@sentry/cli": "^3.5.0",
    "@stoplight/spectral-cli": "^6.16.0",
    "@stoplight/spectral-core": "^1.23.0",
    "@stoplight/spectral-rulesets": "^1.22.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "keywords": [
    "vh-health",
    "healthcare-api",
    "nodejs",
    "express",
    "postgresql",
    "swagger",
    "winston",
    "api"
  ],
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "setupFiles": [
      "<rootDir>/src/scripts/testing/jest.setup.cjs"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/scripts/testing/jest.teardown.cjs"
    ],
    "moduleNameMapper": {
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@controllers/(.*)$": "<rootDir>/src/controllers/$1",
      "^@routes/(.*)$": "<rootDir>/src/routes/$1",
      "^@middleware/(.*)$": "<rootDir>/src/middleware/$1",
      "^@logging/(.*)$": "<rootDir>/src/logging/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@scripts/(.*)$": "<rootDir>/src/scripts/$1",
      "^uuid$": "<rootDir>/src/tests/mocks/uuid.cjs"
    },
    "maxWorkers": 1,
    "workerThreads": false,
    "testMatch": [
      "<rootDir>/src/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [

model abdm_consents {
  id               Int       @id @default(autoincrement())
  consent_id       String?   @unique @db.VarChar(100)
  patient_uid      String    @db.Uuid
  hip_id           String?   @db.VarChar(100)
  hiu_id           String?   @db.VarChar(100)
  purpose          String?   @db.VarChar(100)
  hi_types         String[]
  date_range_from  DateTime? @db.Timestamptz(6)
  date_range_to    DateTime? @db.Timestamptz(6)
  expiry_date      DateTime? @db.Timestamptz(6)
  status           String    @default("REQUESTED") @db.VarChar(50)
  requester_name   String?   @db.VarChar(255)
  consent_artifact Json?
  granted_at       DateTime? @db.Timestamptz(6)
  revoked_at       DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  tenant_id        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

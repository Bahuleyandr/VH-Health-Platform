generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                                                       Int                       @id @default(autoincrement())
  uid                                                      String                    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                                                    String                    @unique @db.VarChar(15)
  name                                                     String?                   @db.VarChar(255)
  gender                                                   String?                   @db.VarChar(20)
  address                                                  String?
  email                                                    String?                   @db.VarChar(255)
  birthday                                                 DateTime?                 @db.Date
  anniversary                                              DateTime?                 @db.Date
  profile_picture                                          String?
  role                                                     String?                   @default("PATIENT") @db.VarChar(50)
  is_active                                                Boolean                   @default(true)
  registered_at                                            DateTime                  @default(now()) @db.Timestamp(6)
  updated_at                                               DateTime                  @updatedAt @db.Timestamp(6)
  e2e_public_key                                           String?
  e2e_key_updated_at                                       DateTime?                 @db.Timestamptz(6)
  tenant_id                                                String                    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  preferred_language                                       String                    @default("en") @db.VarChar(5)
  encrypted_password                                       String?
  last_sign_in_at                                          DateTime?                 @db.Timestamptz(6)
  pan_number                                               String?                   @db.VarChar(20)
  abha_address                                             String?                   @db.VarChar(100)
  abha_number                                              String?                   @db.VarChar(20)
  device_token                                             String?
  role_updated_at                                          DateTime?                 @db.Timestamp(6)
  status                                                   String                    @default("active") @db.VarChar(50)
  status_reason                                            String?
  status_updated_at                                        DateTime?                 @db.Timestamp(6)
  status_updated_by                                        String?                   @db.Uuid
  emergency_contact                                        Json?
  blood_group                                              String?                   @db.VarChar(10)
  allergies                                                String?
  medical_history                                          String?
  annual_review_reminders                                  annual_review_reminders[]
  annual_tax_summaries                                     annual_tax_summaries[]
  appointments_appointments_doctor_idTousers               appointments[]            @relation("appointments_doctor_idTousers")
  appointments_appointments_patient_idTousers              appointments[]            @relation("appointments_patient_idTousers")
  beds                                                     beds[]
  doctors                                                  doctors[]
  full_final_settlements                                   full_final_settlements[]
  investigations_investigations_patient_idTousers          investigations[]          @relation("investigations_patient_idTousers")
  investigations_investigations_requested_byTousers        investigations[]          @relation("investigations_requested_byTousers")
  investment_declarations                                  investment_declarations[]
  leave_encashments                                        leave_encashments[]
  medical_records_medical_records_created_byTousers        medical_records[]         @relation("medical_records_created_byTousers")
  medical_records_medical_records_deleted_byTousers        medical_records[]         @relation("medical_records_deleted_byTousers")
  medical_records                                          medical_records[]
  medical_records_medical_records_patient_idTousers        medical_records[]         @relation("medical_records_patient_idTousers")
  medical_records_medical_records_updated_byTousers        medical_records[]         @relation("medical_records_updated_byTousers")
  payroll_runs_payroll_runs_generated_byTousers            payroll_runs[]            @relation("payroll_runs_generated_byTousers")
  payroll_runs_payroll_runs_locked_byTousers               payroll_runs[]            @relation("payroll_runs_locked_byTousers")
  payslips                                                 payslips[]
  pharmacy_order_history                                   pharmacy_order_history[]
  pharmacy_orders_pharmacy_orders_dispensed_byTousers      pharmacy_orders[]         @relation("pharmacy_orders_dispensed_byTousers")
  pharmacy_orders_pharmacy_orders_patient_idTousers        pharmacy_orders[]         @relation("pharmacy_orders_patient_idTousers")
  pharmacy_orders_pharmacy_orders_prescribed_byTousers     pharmacy_orders[]         @relation("pharmacy_orders_prescribed_byTousers")
  referrals_referrals_accepted_byTousers                   referrals[]               @relation("referrals_accepted_byTousers")
  referrals_referrals_patient_uidTousers                   referrals[]               @relation("referrals_patient_uidTousers")
  referrals_referrals_referred_to_doctorTousers            referrals[]               @relation("referrals_referred_to_doctorTousers")
  referrals_referrals_referring_doctorTousers              referrals[]               @relation("referrals_referring_doctorTousers")
  salary_advances_salary_advances_approved_byTousers       salary_advances[]         @relation("salary_advances_approved_byTousers")
  salary_advances_salary_advances_staff_uidTousers         salary_advances[]         @relation("salary_advances_staff_uidTousers")
  salary_arrears                                           salary_arrears[]
  salary_revisions_salary_revisions_admin_signed_byTousers salary_revisions[]        @relation("salary_revisions_admin_signed_byTousers")
  salary_revisions_salary_revisions_hr_signed_byTousers    salary_revisions[]        @relation("salary_revisions_hr_signed_byTousers")
  salary_revisions_salary_revisions_proposed_byTousers     salary_revisions[]        @relation("salary_revisions_proposed_byTousers")
  salary_revisions_salary_revisions_rejected_byTousers     salary_revisions[]        @relation("salary_revisions_rejected_byTousers")
  salary_revisions_salary_revisions_staff_uidTousers       salary_revisions[]        @relation("salary_revisions_staff_uidTousers")
  staff                                                    staff[]
  staff_salary                                             staff_salary?
  tenants                                                  tenants                   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([phone])
  @@index([uid])
  @@index([role])
  @@index([preferred_language], map: "idx_users_preferred_language")
  @@index([tenant_id], map: "idx_users_tenant_id")
  @@index([uid, tenant_id], map: "idx_users_uid_tenant")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model user_devices {
  id          Int       @id @default(autoincrement())
  user_uid    String    @db.Uuid
  device_id   String    @db.VarChar(255)
  device_name String?   @db.VarChar(255)
  platform    String?   @db.VarChar(50)
  app_version String?   @db.VarChar(50)
  os_version  String?   @db.VarChar(50)
  fcm_token   String?
  last_active DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  device_type String?   @db.VarChar(50)
  ip_address  String?   @db.VarChar(45)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)

  @@unique([user_uid, device_id])
  @@index([user_uid])
  @@index([updated_at(sort: Desc)], map: "idx_user_devices_updated")
  @@map("user_devices")
}

model user_sessions {
  id          Int       @id @default(autoincrement())
  user_id     String?   @db.Uuid
  device_type String?   @db.VarChar(50)
  platform    String?   @db.VarChar(50)
  expires_at  DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  @@index([user_id])
  @@index([expires_at])
  @@map("user_sessions")
}

model user_status_history {
  id              Int      @id @default(autoincrement())
  user_id         String   @db.Uuid
  previous_status String?  @db.VarChar(50)
  new_status      String   @db.VarChar(50)
  changed_by      String?  @db.Uuid
  change_reason   String?
  changed_at      DateTime @default(now()) @db.Timestamp(6)
  ip_address      String?  @db.VarChar(45)

  @@index([user_id])
  @@map("user_status_history")
}

model user_deactivation_log {
  id                  Int      @id @default(autoincrement())
  user_id             String   @db.Uuid
  deactivated_by      String?  @db.Uuid
  deactivation_reason String?
  data_transferred_to String?  @db.Uuid
  deactivated_at      DateTime @default(now()) @db.Timestamp(6)
  ip_address          String?  @db.VarChar(45)
  user_data           Json?

  @@index([user_id])
  @@map("user_deactivation_log")
}

model user_reactivation_log {
  id                  Int      @id @default(autoincrement())
  user_id             String   @db.Uuid
  reactivated_by      String?  @db.Uuid
  reactivation_reason String?
  reactivated_at      DateTime @default(now()) @db.Timestamp(6)
  ip_address          String?  @db.VarChar(45)

  @@index([user_id])
  @@map("user_reactivation_log")
}

model user_role_audit {
  id             Int      @id @default(autoincrement())
  phone          String   @db.VarChar(15)
  old_role       String?  @db.VarChar(50)
  new_role       String?  @db.VarChar(50)
  changed_by_uid String?  @db.Uuid
  reason         String?
  action_type    String?  @db.VarChar(50)
  changed_at     DateTime @default(now()) @db.Timestamp(6)

  @@index([phone])
  @@map("user_role_audit")
}

model user_action_logs {
  id             Int      @id @default(autoincrement())
  user_id        String?  @db.Uuid
  action         String   @db.VarChar(100)
  target_user_id String?  @db.Uuid
  details        Json?
  ip_address     String?  @db.VarChar(45)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@index([user_id])
  @@index([created_at])
  @@map("user_action_logs")
}

model bulk_operation_logs {
  id                Int      @id @default(autoincrement())
  operation_type    String   @db.VarChar(100)
  performed_by      String?  @db.Uuid
  total_items       Int?
  affected_count    Int?
  success_count     Int?
  error_count       Int?
  operation_details Json?
  performed_at      DateTime @default(now()) @db.Timestamp(6)

  @@index([operation_type])
  @@map("bulk_operation_logs")
}

model admins {
  uid                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username              String    @unique @db.VarChar(255)
  password_hash         String    @db.VarChar(255)
  email                 String?   @db.VarChar(255)
  name                  String?   @db.VarChar(255)
  role                  String?   @default("ADMIN") @db.VarChar(50)
  permissions           String[]
  is_active             Boolean   @default(true)
  status                String    @default("active") @db.VarChar(20)
  failed_login_attempts Int       @default(0)
  last_failed_login     DateTime? @db.Timestamp(6)
  totp_enabled          Boolean   @default(false)
  totp_secret_encrypted String?
  totp_backup_codes     Json?
  totp_enrolled_at      DateTime? @db.Timestamptz(6)
  password_changed_at   DateTime? @db.Timestamp(6)
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @db.Timestamp(6)
  last_login            DateTime? @db.Timestamp(6)
  created_by            String?   @db.Uuid
  deactivated_by        String?   @db.Uuid
  deactivation_reason   String?
  deactivated_at        DateTime? @db.Timestamp(6)
  reactivated_by        String?   @db.Uuid
  reactivated_at        DateTime? @db.Timestamp(6)

  @@index([username])
  @@index([status])
  @@map("admins")
}

model otp_sessions {
  id         Int      @id @default(autoincrement())
  phone      String   @db.VarChar(15)
  otp        String   @db.VarChar(10)
  purpose    String   @db.VarChar(50)
  user_id    Int?
  expires_at DateTime @db.Timestamp(6)
  attempts   Int      @default(0)
  verified   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([phone])
  @@index([expires_at])
  @@map("otp_sessions")
}

model otp_logs {
  id             Int      @id @default(autoincrement())
  phone          String   @db.VarChar(15)
  purpose        String   @db.VarChar(50)
  action         String   @db.VarChar(50)
  success        Boolean
  failure_reason String?
  ip_address     String?  @db.VarChar(45)
  user_agent     String?
  created_by     String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@index([phone])
  @@index([created_at])
  @@map("otp_logs")
}

model password_reset_otps {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.Uuid
  otp        String   @db.VarChar(10)
  expires_at DateTime @db.Timestamp(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_otps")
}

model auth_logs {
  id             Int      @id @default(autoincrement())
  phone          String?  @db.VarChar(15)
  user_id        String?  @db.Uuid
  action         String   @db.VarChar(100)
  success        Boolean
  failure_reason String?
  auth_method    String?  @db.VarChar(50)
  ip_address     String?  @db.VarChar(45)
  user_agent     String?
  created_at     DateTime @default(now()) @db.Timestamp(6)
  jti            String?  @db.VarChar(100)
  device_info    String?

  @@index([phone])
  @@index([user_id])
  @@index([created_at])
  @@index([user_id, created_at(sort: Desc)], map: "idx_auth_logs_user_created")
  @@map("auth_logs")
}

model departments {
  id                  Int      @id @default(autoincrement())
  name                String   @unique @db.VarChar(100)
  description         String?
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamp(6)
  updated_at          DateTime @updatedAt @db.Timestamp(6)
  head_doctor_id      Int?
  head_uid            String?  @db.Uuid
  contact_number      String?  @db.VarChar(20)
  location            String?
  budget              Decimal? @db.Decimal(14, 2)
  code                String?  @db.VarChar(32)
  floor               String?  @db.VarChar(32)
  building            String?  @db.VarChar(64)
  deactivation_reason String?
  updated_by          String?  @db.Uuid
  wards               wards[]

  @@index([head_doctor_id], map: "idx_departments_head_doctor")
  @@map("departments")
}

model department_audit_log {
  id            Int      @id @default(autoincrement())
  department_id Int?
  user_id       String?  @db.Uuid
  action        String   @db.VarChar(100)
  old_data      Json?
  new_data      Json?
  created_at    DateTime @default(now()) @db.Timestamp(6)

  @@index([department_id])
  @@index([created_at])
  @@map("department_audit_log")
}

model doctors {
  id                       Int      @id @default(autoincrement())
  user_id                  Int?
  name                     String   @default("") @db.VarChar(100)
  department_id            Int?
  department               String   @db.VarChar(100)
  specialty                String?  @db.VarChar(100)
  intro                    String?
  image_url                String?
  is_available             Boolean  @default(true)
  is_active                Boolean  @default(true)
  created_at               DateTime @default(now()) @db.Timestamp(6)
  updated_at               DateTime @updatedAt @db.Timestamp(6)
  available_days           String[]
  available_hours          Json?
  consultation_fee         Decimal? @db.Decimal(10, 2)
  experience_years         Int?
  education                String?
  qualifications           String?
  max_appointments_per_day Int      @default(20)
  users                    users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([department_id])
  @@index([is_available])
  @@map("doctors")
}

model patient_feedback {
  id          Int      @id @default(autoincrement())
  doctor_id   Int?
  rating      Float?
  review_text String?
  created_at  DateTime @default(now()) @db.Timestamp(6)

  @@index([doctor_id])
  @@map("patient_feedback")
}

model appointments {
  id                                   Int       @id @default(autoincrement())
  uid                                  String?   @db.Uuid
  phone                                String    @db.VarChar(15)
  patient_id                           Int?
  doctor_id                            Int?
  doctor_name                          String    @default("") @db.VarChar(100)
  patient_name                         String?   @db.VarChar(255)
  appointment_date                     DateTime  @db.Date
  appointment_time                     String    @db.VarChar(10)
  status                               String    @default("SCHEDULED") @db.VarChar(50)
  reason                               String?
  notes                                String?
  created_at                           DateTime  @default(now()) @db.Timestamp(6)
  updated_at                           DateTime  @updatedAt @db.Timestamp(6)
  admin_override                       Boolean   @default(false)
  override_reason                      String?
  created_by                           String?   @db.Uuid
  updated_by                           String?   @db.Uuid
  reminder_sent                        Boolean   @default(false)
  reminder_1h_sent                     Boolean   @default(false)
  reminder_24h_sent                    Boolean   @default(false)
  token_number                         String?   @db.VarChar(20)
  department                           String?   @db.VarChar(100)
  confirmed_at                         DateTime? @db.Timestamptz(6)
  sla_target_at                        DateTime? @db.Timestamptz(6)
  users_appointments_doctor_idTousers  users?    @relation("appointments_doctor_idTousers", fields: [doctor_id], references: [id], onUpdate: NoAction)
  users_appointments_patient_idTousers users?    @relation("appointments_patient_idTousers", fields: [patient_id], references: [id], onUpdate: NoAction)

  @@index([phone])
  @@index([uid])
  @@index([patient_id])
  @@index([doctor_id])
  @@index([appointment_date])
  @@index([status])
  @@index([department, appointment_date], map: "idx_appointments_department_date")
  @@map("appointments")
}

model health_records {
  id            Int      @id @default(autoincrement())
  uid           String?  @db.Uuid
  phone         String   @db.VarChar(15)
  record_type   String?  @default("GENERAL") @db.VarChar(50)
  file_name     String   @db.VarChar(255)
  file_type     String   @db.VarChar(50)
  file_key      String?
  file_size     BigInt?
  privacy_level String   @default("RESTRICTED") @db.VarChar(20)
  created_by    String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([record_type])
  @@index([privacy_level])
  @@map("health_records")
}

model medical_records {
  id                                      Int       @id @default(autoincrement())
  patient_id                              String?   @db.Uuid
  doctor_id                               Int?
  record_type                             String?   @db.VarChar(50)
  title                                   String?   @db.VarChar(255)
  description                             String?
  diagnosis                               String?
  treatment                               String?
  medications                             Json?
  lab_results                             Json?
  attachments                             Json?
  privacy_level                           String?   @default("RESTRICTED") @db.VarChar(20)
  created_by                              String?   @db.Uuid
  created_at                              DateTime  @default(now()) @db.Timestamp(6)
  updated_at                              DateTime? @db.Timestamptz(6)
  updated_by                              String?   @db.Uuid
  is_active                               Boolean   @default(true)
  deleted_at                              DateTime? @db.Timestamptz(6)
  deleted_by                              String?   @db.Uuid
  users_medical_records_created_byTousers users?    @relation("medical_records_created_byTousers", fields: [created_by], references: [uid], onUpdate: NoAction)
  users_medical_records_deleted_byTousers users?    @relation("medical_records_deleted_byTousers", fields: [deleted_by], references: [uid], onUpdate: NoAction)
  users                                   users?    @relation(fields: [doctor_id], references: [id], onUpdate: NoAction)
  users_medical_records_patient_idTousers users?    @relation("medical_records_patient_idTousers", fields: [patient_id], references: [uid], onUpdate: NoAction)
  users_medical_records_updated_byTousers users?    @relation("medical_records_updated_byTousers", fields: [updated_by], references: [uid], onUpdate: NoAction)

  @@index([patient_id])
  @@index([doctor_id])
  @@map("medical_records")
}

model investigations {
  id                                       Int                                 @id @default(autoincrement())
  uid                                      String?                             @db.Uuid
  phone                                    String                              @db.VarChar(15)
  patient_id                               Int?
  test_name                                String                              @db.VarChar(255)
  test_type                                String?                             @db.VarChar(100)
  status                                   String                              @default("REQUESTED") @db.VarChar(50)
  result_file                              String?
  file_key                                 String?
  priority                                 String?                             @default("NORMAL") @db.VarChar(20)
  requested_by                             String?                             @db.Uuid
  requested_at                             DateTime                            @default(now()) @db.Timestamp(6)
  completed_at                             DateTime?                           @db.Timestamp(6)
  updated_at                               DateTime                            @updatedAt @db.Timestamp(6)
  notified                                 Boolean?                            @default(false)
  notified_at                              DateTime?                           @db.Timestamp(6)
  turnaround_target_hours                  Int?                                @default(24)
  result_uploaded_at                       DateTime?                           @db.Timestamp(6)
  urgent_alert_sent                        Boolean?                            @default(false)
  patient_notified_at                      DateTime?                           @db.Timestamp(6)
  structured_results                       Json?
  patient_uid                              String?                             @db.Uuid
  investigation_type                       String?                             @db.VarChar(100)
  results                                  Json?
  result_summary                           String?
  interpretation                           String?
  conclusion                               String?
  notes                                    String?
  created_at                               DateTime?                           @default(now()) @db.Timestamptz(6)
  doctor_id                                Int?
  test_code                                String?                             @db.VarChar(50)
  type                                     String?                             @db.VarChar(100)
  normal_range                             String?
  unit                                     String?                             @db.VarChar(50)
  cost                                     Decimal?                            @db.Decimal(12, 2)
  created_by                               String?                             @db.Uuid
  updated_by                               String?                             @db.Uuid
  assigned_technician_id                   String?                             @db.Uuid
  scheduled_date                           DateTime?                           @db.Date
  time_slot                                String?                             @db.VarChar(50)
  cancelled_at                             DateTime?                           @db.Timestamp(6)
  cancelled_by                             String?                             @db.Uuid
  cancellation_reason                      String?
  clinical_ai_lab_autoverifications        clinical_ai_lab_autoverifications[]
  users_investigations_patient_idTousers   users?                              @relation("investigations_patient_idTousers", fields: [patient_id], references: [id], onUpdate: NoAction)
  users_investigations_requested_byTousers users?                              @relation("investigations_requested_byTousers", fields: [requested_by], references: [uid], onUpdate: NoAction)

  @@index([phone])
  @@index([uid])
  @@index([status])
  @@index([test_type])
  @@index([priority])
  @@index([patient_id])
  @@index([patient_uid, created_at(sort: Desc)], map: "idx_investigations_patient_uid_created")
  @@index([structured_results], map: "idx_investigations_structured", type: Gin)
  @@index([doctor_id], map: "idx_investigations_doctor")
  @@index([scheduled_date], map: "idx_investigations_scheduled_date")
  @@map("investigations")
}

model investigation_files {
  id               Int      @id @default(autoincrement())
  investigation_id Int?
  file_name        String   @db.VarChar(255)
  file_path        String?
  file_type        String?  @db.VarChar(50)
  file_size        BigInt?
  uploaded_by      String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamp(6)

  @@index([investigation_id])
  @@map("investigation_files")
}

model investigation_templates {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  type          String?  @db.VarChar(100)
  description   String?
  department_id Int?
  created_by    String?  @db.Uuid
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)
  updated_by    String?  @db.Uuid

  @@index([department_id])
  @@map("investigation_templates")
}

model investigation_template_tests {
  id           Int     @id @default(autoincrement())
  template_id  Int?
  test_name    String  @db.VarChar(255)
  test_code    String? @db.VarChar(50)

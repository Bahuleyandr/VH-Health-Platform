  @@index([created_at(sort: Desc)], map: "idx_abdm_consents_created_at")
  @@index([patient_uid], map: "idx_abdm_consents_patient_uid")
  @@index([status], map: "idx_abdm_consents_status")
  @@index([tenant_id], map: "idx_abdm_consents_tenant_id")

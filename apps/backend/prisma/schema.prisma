  tenants              tenants        @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_icu_code_status_history_tenant")

  @@index([tenant_id, icu_admission_id, changed_at(sort: Desc)], map: "idx_icu_code_status_history_admission")
}


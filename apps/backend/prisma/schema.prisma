  prior_state                                                                                                                                                      Json?
  next_state                                                                                                                                                       Json?
  evidence_references                                                                                                                                              Json                                                  @default("[]")
  reason_code                                                                                                                                                      String?                                               @db.VarChar(80)
  reason_detail                                                                                                                                                    String?                                               @db.VarChar(500)
  request_id                                                                                                                                                       String?                                               @db.VarChar(120)
  clinical_audit_event_id                                                                                                                                          String?                                               @db.Uuid
  claim_txid                                                                                                                                                       BigInt?
  receipt                                                                                                                                                          Json
  recorded_at                                                                                                                                                      DateTime                                              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  users                                                                                                                                                            users                                                 @relation(fields: [tenant_id, actor_uid], references: [tenant_id, uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_actor")
  clinical_audit_events                                                                                                                                            clinical_audit_events?                                @relation(fields: [tenant_id, clinical_audit_event_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_audit")
  facilities                                                                                                                                                       facilities                                            @relation(fields: [tenant_id, facility_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_facility")
  clinical_continuity_activation_evidence_gate_configs                                                                                                             clinical_continuity_activation_evidence_gate_configs? @relation(fields: [tenant_id, evidence_gate_config_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_gate")
  clinical_continuity_activation_transition_events                                                                                                                 clinical_continuity_activation_transition_events?     @relation("clinical_continuity_activation_transition_eventsToclinical_continuity_activation_transition_events", fields: [tenant_id, intent_event_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_intent")
  other_clinical_continuity_activation_transition_events                                                                                                           clinical_continuity_activation_transition_events[]    @relation("clinical_continuity_activation_transition_eventsToclinical_continuity_activation_transition_events")
  clinical_continuity_policy_versions_clinical_continuity_activation_transition_events_tenant_id_facility_id_prior_policy_idToclinical_continuity_policy_versions  clinical_continuity_policy_versions?                  @relation("clinical_continuity_activation_transition_events_tenant_id_facility_id_prior_policy_idToclinical_continuity_policy_versions", fields: [tenant_id, facility_id, prior_policy_id], references: [tenant_id, facility_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_prior_policy")
  clinical_continuity_activation_key_roster                                                                                                                        clinical_continuity_activation_key_roster?            @relation(fields: [tenant_id, roster_entry_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_roster")
  clinical_continuity_policy_versions_clinical_continuity_activation_transition_events_tenant_id_facility_id_target_policy_idToclinical_continuity_policy_versions clinical_continuity_policy_versions?                  @relation("clinical_continuity_activation_transition_events_tenant_id_facility_id_target_policy_idToclinical_continuity_policy_versions", fields: [tenant_id, facility_id, target_policy_id], references: [tenant_id, facility_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_target_policy")
  tenants                                                                                                                                                          tenants                                               @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cc_activation_event_tenant")

  @@id([tenant_id, id])
  @@unique([tenant_id, effect_identity], map: "uq_cc_activation_event_applied_effect", where: raw("((outcome)::text = 'applied'::text)"))
  @@unique([tenant_id, idempotency_key_sha256], map: "uq_cc_activation_event_idempotency", where: raw("((idempotency_key_sha256 IS NOT NULL) AND ((outcome)::text = ANY ((ARRAY['awaiting_counterkey'::character varying, 'applied'::character varying])::text[])))"))
  @@unique([tenant_id, effect_identity, actor_uid], map: "uq_cc_activation_event_intent_actor", where: raw("((outcome)::text = 'awaiting_counterkey'::text)"))
  @@index([tenant_id, facility_id, recorded_at(sort: Desc), id], map: "idx_cc_activation_event_facility_time")
}


generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model migrations {
  id          Int       @id @default(dbgenerated("nextval('_migrations_id_seq'::regclass)"))
  name        String    @unique @db.VarChar(255)
  executed_at DateTime? @default(now()) @db.Timestamp(6)

  @@map("_migrations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model abdm_care_contexts {
  id                     Int                     @id @default(autoincrement())
  tenant_id              String                  @db.Uuid
  abha_profile_id        Int?
  patient_uid            String                  @db.Uuid
  facility_mapping_id    Int?
  reference_id           String                  @db.VarChar(120)
  display                String?                 @db.VarChar(255)
  hi_type                String                  @db.VarChar(60)
  source_resource_type   String?                 @db.VarChar(60)
  source_resource_id     String?                 @db.VarChar(120)
  status                 String                  @default("linked") @db.VarChar(20)
  linked_at              DateTime?               @db.Timestamptz(6)
  unlinked_at            DateTime?               @db.Timestamptz(6)
  metadata               Json                    @default("{}")
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  abha_profiles          abha_profiles?          @relation(fields: [abha_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  abdm_facility_mappings abdm_facility_mappings? @relation(fields: [facility_mapping_id], references: [id], onUpdate: NoAction)
  tenants                tenants                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, reference_id])
  @@index([tenant_id, hi_type, status], map: "idx_care_contexts_hi_type")
  @@index([tenant_id, patient_uid, status], map: "idx_care_contexts_tenant_patient")
  @@index([abha_profile_id], map: "idx_care_contexts_abha", where: raw("(abha_profile_id IS NOT NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model abdm_consent_artifacts {
  id                    Int                    @id @default(autoincrement())
  tenant_id             String                 @db.Uuid
  consent_request_id    Int?
  artifact_id           String                 @db.VarChar(120)
  abha_id               String?                @db.VarChar(40)
  patient_uid           String?                @db.Uuid
  hi_types              String[]               @default([])
  permission_kind       String                 @db.VarChar(40)
  data_from             DateTime?              @db.Timestamptz(6)
  data_to               DateTime?              @db.Timestamptz(6)
  expiry_at             DateTime?              @db.Timestamptz(6)
  status                String                 @default("active") @db.VarChar(20)
  signed_payload        Json                   @default("{}")
  signature_kid         String?                @db.VarChar(120)
  signature_algorithm   String?                @db.VarChar(40)
  granted_at            DateTime               @default(now()) @db.Timestamptz(6)
  revoked_at            DateTime?              @db.Timestamptz(6)
  expired_at            DateTime?              @db.Timestamptz(6)
  environment           String                 @default("sandbox") @db.VarChar(20)
  metadata              Json                   @default("{}")
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  abdm_consent_requests abdm_consent_requests? @relation(fields: [consent_request_id], references: [id], onUpdate: NoAction)
  tenants               tenants                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  abdm_data_transfers   abdm_data_transfers[]
  abdm_webhook_events   abdm_webhook_events[]

  @@unique([tenant_id, artifact_id, environment])
  @@index([tenant_id, status, granted_at(sort: Desc)], map: "idx_consent_artifacts_tenant_status")
  @@index([tenant_id, expiry_at], map: "idx_consent_artifacts_active_expiry", where: raw("(((status)::text = 'active'::text) AND (expiry_at IS NOT NULL))"))
  @@index([consent_request_id], map: "idx_consent_artifacts_request", where: raw("(consent_request_id IS NOT NULL)"))
}


generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model migrations {
  id          Int       @id @default(dbgenerated("nextval('_migrations_id_seq'::regclass)"))
  name        String    @unique @db.VarChar(255)
  executed_at DateTime? @default(now()) @db.Timestamp(6)

  @@map("_migrations")
}

model schema_drift_archives {
  id                    BigInt   @id @default(autoincrement())
  archived_at           DateTime @default(now()) @db.Timestamptz(6)
  archived_by_migration String   @db.VarChar(120)
  source_table          String   @db.VarChar(160)
  source_column         String?  @db.VarChar(160)
  source_pk             String?  @db.VarChar(200)
  tenant_id             String?  @default(dbgenerated("COALESCE((NULLIF(NULLIF(current_setting('app.current_tenant_id'::text, true), ''::text), 'bypass'::text))::uuid, '00000000-0000-4000-8000-000000000001'::uuid)")) @db.Uuid
  archive_reason        String
  row_data              Json
  row_fingerprint       String   @db.VarChar(32)

  @@index([archived_at(sort: Desc)], map: "idx_schema_drift_archives_archived_at")
  @@index([source_table, source_column], map: "idx_schema_drift_archives_source")
  @@index([tenant_id, archived_at(sort: Desc)], map: "idx_schema_drift_archives_tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model abdm_care_contexts {
  id                     Int                     @id @default(autoincrement())
  tenant_id              String                  @default(dbgenerated("COALESCE((NULLIF(NULLIF(current_setting('app.current_tenant_id'::text, true), ''::text), 'bypass'::text))::uuid, '00000000-0000-4000-8000-000000000001'::uuid)")) @db.Uuid
  abha_profile_id        Int?
  patient_uid            String                  @db.Uuid
  facility_mapping_id    Int?
  reference_id           String                  @db.VarChar(120)
  display                String?                 @db.VarChar(255)
  hi_type                String                  @db.VarChar(60)
  source_resource_type   String?                 @db.VarChar(60)
  source_resource_id     String?                 @db.VarChar(120)
  status                 String                  @default("linked") @db.VarChar(20)
  linked_at              DateTime?               @db.Timestamptz(6)
  unlinked_at            DateTime?               @db.Timestamptz(6)
  metadata               Json                    @default("{}")
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  abha_profiles          abha_profiles?          @relation(fields: [abha_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  abdm_facility_mappings abdm_facility_mappings? @relation(fields: [facility_mapping_id], references: [id], onUpdate: NoAction)
  tenants                tenants                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, reference_id])
  @@index([tenant_id, hi_type, status], map: "idx_care_contexts_hi_type")
  @@index([tenant_id, patient_uid, status], map: "idx_care_contexts_tenant_patient")
  @@index([abha_profile_id], map: "idx_care_contexts_abha", where: raw("(abha_profile_id IS NOT NULL)"))
}


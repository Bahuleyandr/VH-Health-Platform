{
  "name": "@vhhealth/device-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VH Health NL-7 bedside device gateway: MLLP ingress, durable spool, backend drain.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "check:lockfile-libc": "node ../../scripts/check-lockfile-libc.mjs device-gateway",
    "lint": "node scripts/lint.mjs",
    "soak:replay": "node scripts/soak-replay.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}

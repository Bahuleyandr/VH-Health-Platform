<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <!-- 🔐 Biometric Authentication -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-feature 
        android:name="android.hardware.fingerprint" 
        android:required="false" />
    
    <!-- 📅 Calendar Access -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    
    <!-- 📍 Location Services -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- 📷 Camera Access -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature 
        android:name="android.hardware.camera" 
        android:required="false" />
    <uses-feature 
        android:name="android.hardware.camera.autofocus" 
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    
    <!-- 📁 File and Media Access (Modern Android 13+ approach) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission 
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission 
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    
    <!-- 🌐 Network and Communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 📢 Notifications (Required for Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ⏰ Exact Alarms — required for flutter_local_notifications exactAllowWhileIdle -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 🔄 Re-schedule notifications after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- 🫀 Health Connect / Health Kit (Phase 3C patient sync).
         Android 14+ reads health data via the Health Connect app; each data
         type needs its own read permission. The `health` plugin declares
         these at runtime but listing them here makes the permission
         declaration explicit for Play Store review. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- 🔐 Backup / device-transfer suppression (re-audit lane L).
         minSdk here is 26 and targetSdk follows flutter.targetSdkVersion, so
         these three attributes are read at different API levels. They are NOT
         three equal legs: allowBackup="false" alone stops the app being
         backed up at all, so the other two carry weight only for the channel
         allowBackup cannot reach, and as a second line of defence if
         allowBackup is ever flipped back.

           android:allowBackup="false"
             Read on every level this app runs on (API 26+). Suppresses Auto
             Backup to Google Drive, key/value backup and `adb backup`. It
             does NOT suppress Android 12+ device-to-device transfer, which
             is why this app leaked PHI onto a patient's new handset before
             this change.

           android:fullBackupContent="false"
             The pre-Android-12 way to say "no full-data backup set for this
             app", and load-bearing only on API 26-30. On API 31+ the cloud
             channel prefers dataExtractionRules whenever its <cloud-backup>
             section is present, and the D2D channel ignores fullBackupContent
             outright for any app targeting API 31+
             (FullBackup.IGNORE_FULL_BACKUP_CONTENT_IN_D2D) — with no
             dataExtractionRules that leaves D2D copying the whole sandbox.
             Redundant on 26-30 too while allowBackup stays "false"; kept so
             that flipping allowBackup cannot silently re-open those versions.

           android:dataExtractionRules="@xml/data_extraction_rules"
             API 31+ (Android 12 and newer) only, and the only attribute here
             that can suppress device-to-device transfer. Declares BOTH
             channels — <cloud-backup> and, critically, <device-transfer> —
             as exclude-everything. Ignored on API 30 and below, which is
             what fullBackupContent above is for.

         None of the three covers: rooted/imaged devices, Health Connect
         records (owned by the Health Connect app), or iOS. See the header
         comment in res/xml/data_extraction_rules.xml, and docs/ROADMAP.md
         ("iOS has no backup exclusion at all") for the iOS gap. -->
    <application
        android:name="${applicationName}"
        android:label="VH Health"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="false"
        android:preserveLegacyExternalStorage="false"
        tools:targetApi="31">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- Local custom-scheme links only. HTTPS App Links remain held
                 until an owned domain and assetlinks.json are approved. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="vhhealth"
                    android:host="app"
                    android:pathPrefix="/" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        
        <!-- 🛠️ Flutter Plugin System -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        
        <!-- 🔐 FileProvider for secure file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <!-- 📍 Background Location Service (if needed) -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:foregroundServiceType="location"
            android:exported="false" />
        
        <!-- 🔐 Biometric Authentication Service -->
        <service
            android:name="androidx.biometric.BiometricService"
            android:exported="false" />
    </application>
    
    <!-- ✅ Query intents for compatibility -->
    <queries>
        <!-- Text processing for sharing -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        
        <!-- Web browsing -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        
        <!-- File viewing -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        
        <!-- Email -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        
        <!-- Phone calls -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        
        <!-- SMS -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        
        <!-- Maps -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        
        <!-- Camera -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        
        <!-- Gallery -->
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>

        <!-- Health Connect — required for the `health` plugin to discover
             the Health Connect provider app on Android 14+. Without this
             <queries> entry the plugin silently returns no samples. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>

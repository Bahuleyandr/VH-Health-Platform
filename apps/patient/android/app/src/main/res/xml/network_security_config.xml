<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production API domain (audit finding L8: this previously pinned the
         dead placeholder your-api-domain.com). includeSubdomains covers
         api.vhhealth.app + any staging subdomain. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">vhhealth.app</domain>
    </domain-config>

    <!-- Allow cleartext traffic for development only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- System CAs only (audit finding H8): user-installed CAs were
         previously re-trusted here, letting any proxy/MDM/malicious CA MITM
         all PHI traffic. Android 7+ excludes user CAs by default — do NOT
         re-add <certificates src="user"/>. App-layer SPKI pinning
         (CertificatePinner, finding H7) is the second control. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>

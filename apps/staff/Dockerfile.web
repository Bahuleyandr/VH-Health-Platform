# Flutter web build for the staff app — served LAN-only via the
# internal ingress (Phase 3 of the clinical-AI rollout, see
# docs/CLINICAL_AI_ROLLOUT_PLAN.md).
#
# Three stages:
#   1. flutter-build  — compile the web bundle with the API base URL baked in via
#                       --dart-define=VH_BASE_URL=<...>
#   2. asset-prep     — copy the build/web output into a fresh layer
#                       so the runner stage doesn't carry the SDK
#   3. runner         — nginx:alpine serving the static assets, gzip
#                       + brotli on, caching headers tuned for an
#                       SPA (HTML always revalidates; assets get
#                       1 year + immutable)
#
# The image is intentionally NOT meant for public-internet use. It
# ships behind the nginx-internal IngressClass at clinical.<hospital>.local.
# The same Flutter source can be rebuilt with a different, versioned
# VH_BASE_URL for a reviewed internal or tenant API origin.

# ghcr.io/cirruslabs/flutter has published no stable version tag past 3.44.0
# (tag list checked 2026-08-16), so the build stage installs the official
# Flutter stable tarball — sha256-pinned from the Flutter release manifest —
# onto a digest-pinned Debian base instead.
#
# ARCHITECTURE: this image is linux/amd64-ONLY. Flutter publishes no
# linux-arm64 SDK tarball at all (releases_linux.json carries only
# dart_sdk_arch=x64 entries — manifest checked 2026-08-16), so the build stage
# below can only ever run x64 toolchain binaries. The release workflows
# (.github/workflows/release-images.yml and .forgejo/workflows/
# release-images.yml) therefore constrain the staff-web buildx platforms to
# linux/amd64; check-infra-security-controls.mjs pins that constraint. If
# Flutter ever ships official linux-arm64 stable tarballs, switch to
# TARGETARCH-conditional tarball selection with per-arch sha256 pins and lift
# the workflow constraint in the same commit.
ARG BUILD_IMAGE=debian:12-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
ARG NGINX_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# ---- Stage 1: Flutter build ------------------------------------------
FROM ${BUILD_IMAGE} AS flutter-build

# Pinned Flutter SDK. Version and archive sha256 both come from the official
# release manifest:
# https://storage.googleapis.com/flutter_infra_release/releases/releases_linux.json
# Keep FLUTTER_VERSION in lockstep with the workspace toolchain pin in
# .github/workflows/_reusable-flutter-workspace.yml.
ARG FLUTTER_VERSION=3.47.0
ARG FLUTTER_SHA256=26cd99d3d94b1367e6b50535a18aeef0282c10a535bbe3ec493534dcdab75296

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl git unzip xz-utils zip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/flutter.tar.xz \
      "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
    && echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/flutter.tar.xz -C /opt \
    && rm /tmp/flutter.tar.xz

ENV PATH=/opt/flutter/bin:$PATH
# The tarball extracts as a git checkout; the flutter tool refuses to run in a
# repo owned by a different user without this marker.
RUN git config --global --add safe.directory /opt/flutter \
    && flutter --version

WORKDIR /workspace

# Copy the dart pub workspace at the repo root + every workspace
# member it references. Doing this in two steps (pubspecs first, then
# code) keeps `flutter pub get` cached across iterations of app-only
# changes.
COPY pubspec.yaml pubspec.lock ./
COPY packages/vhhealth_core/pubspec.yaml packages/vhhealth_core/pubspec.yaml
COPY apps/patient/pubspec.yaml apps/patient/pubspec.yaml
COPY apps/staff/pubspec.yaml apps/staff/pubspec.yaml
COPY apps/patient/local_plugins/ apps/patient/local_plugins/
# The root pubspec pins lucide_icons to the repo-root local_plugins/ copy via
# dependency_overrides (pubspec.yaml:16-18), and apps/staff depends on
# lucide_icons, so pub cannot resolve the workspace without this directory
# present. Without it `flutter pub get` below dies with
# "Because vhhealth_workspace depends on lucide_icons from path which doesn't
# exist (could not find package lucide_icons at "local_plugins/lucide_icons")".
COPY local_plugins/ local_plugins/

RUN flutter pub get

# Now copy the full source for staff + core (skip patient — we don't
# need its sources to build the staff web app).
COPY packages/vhhealth_core/ packages/vhhealth_core/
COPY apps/staff/ apps/staff/

# ---- OpenAPI codegen --------------------------------------------------
# packages/vhhealth_core/lib/api/generated/** is gitignored, so it is absent
# from the build context, yet the tracked barrel lib/api/vhhealth_api.dart
# re-exports it and apps/staff reaches that barrel from the router
# (lib/core/navigation/app_router.dart -> paper_reconciliation_workbench_screen.dart).
# Without this step `flutter build web` below fails with
# "Error when reading '.../generated/openapi.swagger.dart': No such file or directory".
# Must run AFTER the COPY above (build.yaml + swagger/openapi.json are the
# generator's inputs) and BEFORE the build.
#
# CI runs this as `melos run codegen` -> `node scripts/codegen.mjs`. This image
# has neither melos nor Node, and adding either would mean an unpinned package
# install in a stage whose bases are deliberately digest-pinned, so we invoke
# the same build_runner command that driver ends up spawning. That equivalence
# was verified natively on Dart 3.13.0 — the same Dart this pinned SDK ships:
# all 7 files in lib/api/generated/ came out sha256-identical either way.
# KEEP IN SYNC with the `args` array at the bottom of scripts/codegen.mjs.
# The only thing skipped is that script's exclude_paths "dropped operations"
# report, which is diagnostic logging and does not affect the generated code.
WORKDIR /workspace/packages/vhhealth_core
RUN dart run build_runner build

# Build args for the dart-define values that get baked into the bundle.
# clinical.<hospital>.local is the staff SPA identity, not an API origin.
# Default to the versioned public API until a reviewed internal API hostname
# exists; internal or tenant builds must override with their versioned URL.
ARG VH_BASE_URL=https://api.vhhealth.app/api/v1
ARG VH_API_KEY=
# Backward-compatible build args for older scripts.
ARG API_URL=
ARG API_KEY=
ARG APP_NAME="VH Health Staff"
ARG SENTRY_DSN=
ARG SENTRY_ENVIRONMENT=staff-web
ARG SENTRY_RELEASE=
# reCAPTCHA Enterprise site key for Firebase App Check on staff web. Empty is safe:
# main.dart skips App Check activation on web when the key is unset (the
# dart-define default is ''), so no bogus attestation is attempted.
# Provision via the Firebase console — see docs/runbooks/FIREBASE_KEY_ROTATION.md.
ARG VH_RECAPTCHA_SITE_KEY=
# Rotated Firebase web API key (see docs/runbooks/FIREBASE_KEY_ROTATION.md).
# Injected conditionally below: an empty --dart-define would override the
# committed fallback key in firebase_options.dart, so an unset build arg
# must leave the define absent entirely.
ARG VH_FIREBASE_WEB_API_KEY=

WORKDIR /workspace/apps/staff

# Build the optimized Flutter web bundle.
# Tree-shake icons (default in flutter build web 3.41+).
RUN flutter build web \
      --release \
      --dart-define=VH_BASE_URL=${VH_BASE_URL:-$API_URL} \
      --dart-define=VH_API_KEY=${VH_API_KEY:-$API_KEY} \
      --dart-define=APP_NAME="$APP_NAME" \
      --dart-define=SENTRY_DSN=$SENTRY_DSN \
      --dart-define=SENTRY_ENVIRONMENT=$SENTRY_ENVIRONMENT \
      --dart-define=SENTRY_RELEASE=$SENTRY_RELEASE \
      --dart-define=VH_RECAPTCHA_SITE_KEY=$VH_RECAPTCHA_SITE_KEY \
      ${VH_FIREBASE_WEB_API_KEY:+--dart-define=VH_FIREBASE_WEB_API_KEY=$VH_FIREBASE_WEB_API_KEY}

# ---- Stage 2: asset isolation ----------------------------------------
# Pure copy stage so the runner doesn't carry the Flutter SDK
# (~1.2 GB) — only the ~10 MB build/web output.
FROM scratch AS asset-prep
COPY --from=flutter-build /workspace/apps/staff/build/web /web

# ---- Stage 3: nginx runner ------------------------------------------
FROM ${NGINX_IMAGE} AS runner

# Apply Alpine security fixes from the pinned release branch, then drop the
# default landing-page config + content and replace it with our own.
RUN apk upgrade --no-cache \
    && rm -f /etc/nginx/conf.d/default.conf \
    && rm -rf /usr/share/nginx/html/*

COPY apps/staff/nginx-staff-web.conf /etc/nginx/conf.d/default.conf
COPY --from=asset-prep /web /usr/share/nginx/html

# Run as non-root (nginx:alpine includes a `nginx` user). Bind to 8080
# so we don't need NET_BIND_SERVICE in the pod.
RUN sed -i 's,listen       80;,listen       8080;,g' /etc/nginx/conf.d/default.conf 2>/dev/null || true \
    && touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/cache/nginx /var/run/nginx.pid /usr/share/nginx/html

USER nginx

EXPOSE 8080

# Healthcheck: nginx serves index.html with a 200 — easier to probe than
# a /healthz path because Flutter web's history mode rewrites everything.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

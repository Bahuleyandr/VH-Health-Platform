# Flutter web build for the staff app — served LAN-only via the
# internal ingress (Phase 3 of the clinical-AI rollout, see
# docs/CLINICAL_AI_ROLLOUT_PLAN.md).
#
# Three stages:
#   1. flutter-build  — compile the web bundle with the API base URL baked in via
#                       --dart-define=VH_BASE_URL=<...>
#   2. asset-prep     — copy the build/web output into a fresh layer
#                       so the runner stage doesn't carry the SDK
#   3. runner         — nginx:alpine serving the static assets, gzip
#                       + brotli on, caching headers tuned for an
#                       SPA (HTML always revalidates; assets get
#                       1 year + immutable)
#
# The image is intentionally NOT meant for public-internet use. It
# ships behind the nginx-internal IngressClass at clinical.<hospital>.local.
# The same Flutter source can be rebuilt with a different, versioned
# VH_BASE_URL for a reviewed internal or tenant API origin.

ARG FLUTTER_IMAGE=ghcr.io/cirruslabs/flutter:3.44.0@sha256:46691e311715845de03a3ba4753a475476936805b29431b1f00f1816981033f8
ARG NGINX_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# ---- Stage 1: Flutter build ------------------------------------------
FROM ${FLUTTER_IMAGE} AS flutter-build

WORKDIR /workspace

# Copy the dart pub workspace at the repo root + every workspace
# member it references. Doing this in two steps (pubspecs first, then
# code) keeps `flutter pub get` cached across iterations of app-only
# changes.
COPY pubspec.yaml pubspec.lock ./
COPY packages/vhhealth_core/pubspec.yaml packages/vhhealth_core/pubspec.yaml
COPY apps/patient/pubspec.yaml apps/patient/pubspec.yaml
COPY apps/staff/pubspec.yaml apps/staff/pubspec.yaml
COPY apps/patient/local_plugins/ apps/patient/local_plugins/

RUN flutter pub get

# Now copy the full source for staff + core (skip patient — we don't
# need its sources to build the staff web app).
COPY packages/vhhealth_core/ packages/vhhealth_core/
COPY apps/staff/ apps/staff/

# Build args for the dart-define values that get baked into the bundle.
# clinical.<hospital>.local is the staff SPA identity, not an API origin.
# Default to the versioned public API until a reviewed internal API hostname
# exists; internal or tenant builds must override with their versioned URL.
ARG VH_BASE_URL=https://api.vhhealth.app/api/v1
ARG VH_API_KEY=
# Backward-compatible build args for older scripts.
ARG API_URL=
ARG API_KEY=
ARG APP_NAME="VH Health Staff"
ARG SENTRY_DSN=
ARG SENTRY_ENVIRONMENT=staff-web
ARG SENTRY_RELEASE=

WORKDIR /workspace/apps/staff

# Build the optimized Flutter web bundle.
# Tree-shake icons (default in flutter build web 3.41+).
RUN flutter build web \
      --release \
      --dart-define=VH_BASE_URL=${VH_BASE_URL:-$API_URL} \
      --dart-define=VH_API_KEY=${VH_API_KEY:-$API_KEY} \
      --dart-define=APP_NAME="$APP_NAME" \
      --dart-define=SENTRY_DSN=$SENTRY_DSN \
      --dart-define=SENTRY_ENVIRONMENT=$SENTRY_ENVIRONMENT \
      --dart-define=SENTRY_RELEASE=$SENTRY_RELEASE

# ---- Stage 2: asset isolation ----------------------------------------
# Pure copy stage so the runner doesn't carry the Flutter SDK
# (~1.2 GB) — only the ~10 MB build/web output.
FROM scratch AS asset-prep
COPY --from=flutter-build /workspace/apps/staff/build/web /web

# ---- Stage 3: nginx runner ------------------------------------------
FROM ${NGINX_IMAGE} AS runner

# Drop the default landing-page config + content; replace with our own.
RUN rm -f /etc/nginx/conf.d/default.conf \
    && rm -rf /usr/share/nginx/html/*

COPY apps/staff/nginx-staff-web.conf /etc/nginx/conf.d/default.conf
COPY --from=asset-prep /web /usr/share/nginx/html

# Run as non-root (nginx:alpine includes a `nginx` user). Bind to 8080
# so we don't need NET_BIND_SERVICE in the pod.
RUN sed -i 's,listen       80;,listen       8080;,g' /etc/nginx/conf.d/default.conf 2>/dev/null || true \
    && touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/cache/nginx /var/run/nginx.pid /usr/share/nginx/html

USER nginx

EXPOSE 8080

# Healthcheck: nginx serves index.html with a 200 — easier to probe than
# a /healthz path because Flutter web's history mode rewrites everything.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

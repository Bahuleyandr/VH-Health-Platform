<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules (audit finding H9). The staff app
     handles clinical PHI on shared ward/kiosk devices: exclude EVERYTHING
     from both cloud backup and device-to-device transfer. The legacy
     android:fullBackupContent="false" attribute covers Android <12. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <!-- Device-protected storage. NOT omitted on the theory that nothing
             is directBootAware: Firebase and MLKit inject four directBootAware
             components (FirebaseInitProvider, FirebaseMessagingService,
             ComponentDiscoveryService, MlKitComponentDiscoveryService) by
             MANIFEST MERGE, so the app-local manifest can never show them and
             any guard reading it would pass vacuously. Excluding all nine
             domains costs nothing when a domain holds nothing, and removes the
             need to reason about which libraries write where. -->
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <!-- Device-protected storage. NOT omitted on the theory that nothing
             is directBootAware: Firebase and MLKit inject four directBootAware
             components (FirebaseInitProvider, FirebaseMessagingService,
             ComponentDiscoveryService, MlKitComponentDiscoveryService) by
             MANIFEST MERGE, so the app-local manifest can never show them and
             any guard reading it would pass vacuously. Excluding all nine
             domains costs nothing when a domain holds nothing, and removes the
             need to reason about which libraries write where. -->
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

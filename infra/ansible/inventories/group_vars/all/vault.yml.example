---
# VH Health Platform — Ansible Vault template.
#
# Encrypt the real file with:
#   ansible-vault encrypt inventories/group_vars/all/vault.yml
#
# The file MUST be named exactly `vault.yml` (not `vault.yml.example`) for
# the inventory to pick it up. Commit the encrypted `vault.yml` ONLY if
# your vault password is stored elsewhere (e.g. 1Password shared vault);
# otherwise keep `vault.yml` gitignored alongside `prod.yml`.
#
# All values here are dummy placeholders.

# --- RKE2 cluster identity -------------------------------------------------
# Before the first C1.2 apply to an existing cluster, copy the exact live
# server token into this value. The role compares every existing
# server's token with this Vault value and stops before making changes if any
# value is absent or differs. Production uses steady_state_exact and never
# accepts short-to-secure token equivalence. A brand-new cluster may explicitly
# use fresh_short for its first run only; immediately capture the resulting
# secure token into Vault and switch to steady_state_exact.
vault_rke2_cluster_token: "REPLACE_WITH_EXACT_LIVE_RKE2_TOKEN"

# Authenticated artifact URL prefix for the two SUSE Prime-only RKE2 ladder
# pins. The upgrade playbook appends the URL-encoded version and exact artifact
# filename, but never gives this URL to the legacy tagged installers because
# those installer revisions do not consume INSTALL_RKE2_ARTIFACT_URL. The
# official Prime prefix must be HTTPS and end in `/rke2` (an optional trailing
# slash is accepted); do not include a version suffix. Clear this URL before
# the first public rung; retain the fixed artifact hashes below as evidence.
vault_rke2_prime_artifact_url: ""

# Exact SHA-256 values for the two files staged for each Prime-only pin. Obtain
# both files through the authenticated Prime URL above, validate their
# provenance independently, then record their hashes here. The manifest itself
# and the release tarball are both fixed Vault identities; the playbook also
# requires the manifest to contain exactly the recorded tarball digest. Add
# another architecture only with its own authenticated files and the installer
# filename mapping implemented by the qualification playbook.
vault_rke2_prime_artifact_sha256_by_architecture:
  x86_64:
    "v1.31.14+rke2r2":
      checksum_manifest_sha256: "REPLACE_WITH_64_HEX_SHA256"
      tarball_sha256: "REPLACE_WITH_64_HEX_SHA256"
    "v1.32.13+rke2r2":
      checksum_manifest_sha256: "REPLACE_WITH_64_HEX_SHA256"
      tarball_sha256: "REPLACE_WITH_64_HEX_SHA256"

# Exact SHA-256 of the installed /usr/local/bin/rke2 binary, keyed first by
# Ansible's architecture fact and then by the approved exact pin. Every listed
# architecture must contain the complete five-pin C1.2 ladder. Hash each
# extracted binary only after its release archive has passed the official
# checksum, or use the equivalently authenticated Prime artifact, before
# authorizing an upgrade or replacement.
# Placeholders, all-zero values, missing pins, and unverified cross-architecture
# reuse are hard stops. Add another architecture only with its own verified
# per-pin mapping.
vault_rke2_binary_sha256_by_architecture:
  x86_64:
    "v1.31.4+rke2r1": "REPLACE_WITH_64_HEX_SHA256"
    "v1.31.14+rke2r2": "REPLACE_WITH_64_HEX_SHA256"
    "v1.32.13+rke2r2": "REPLACE_WITH_64_HEX_SHA256"
    "v1.33.13+rke2r1": "REPLACE_WITH_64_HEX_SHA256"
    "v1.34.9+rke2r1": "REPLACE_WITH_64_HEX_SHA256"

# --- etcd offsite snapshot destination (Cloudflare R2) ---------------------
# R2 bucket configured in the VH Health Cloudflare account, India region.
# Access key is scoped to Object:Read/Write on the etcd-snapshots bucket
# only. Rotate quarterly.
vault_etcd_s3_endpoint: "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
vault_etcd_s3_bucket: "vhhealth-etcd-snapshots"
vault_etcd_s3_access_key: "REPLACE_WITH_R2_ACCESS_KEY_ID"
vault_etcd_s3_secret_key: "REPLACE_WITH_R2_SECRET_ACCESS_KEY"

# --- Optional: admin SSH key (if you prefer vault over inventory) ---------
# vault_admin_ssh_key: "ssh-ed25519 AAAA... vhhealth@hospital"

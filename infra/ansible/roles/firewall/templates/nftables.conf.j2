#!/usr/sbin/nft -f
{{ ansible_managed | comment }}
#
# VH Health Platform — RKE2 node host firewall.
#
# Policy:
#   input   = drop (explicit allow list below)
#   output  = accept (egress unrestricted — Cloudflare Tunnel is our only
#             public ingress, so egress filtering is future work)

# Replace only the table owned by this role. `destroy` is idempotent when the
# table does not exist, and nft applies this destroy/create batch atomically.
# Never flush the global ruleset: kube-proxy and the CNI own other tables.
destroy table inet vhhealth

table inet vhhealth {

    # --- Named sets ---------------------------------------------------------
    set mgmt_v4 {
        type ipv4_addr
        flags interval
        elements = {
{% for c in management_cidrs %}
            {{ c }}{{ ',' if not loop.last else '' }}
{% endfor %}
        }
    }

    set cluster_v4 {
        type ipv4_addr
        flags interval
        elements = {
{% for c in cluster_cidrs %}
            {{ c }}{{ ',' if not loop.last else '' }}
{% endfor %}
        }
    }

    # --- Input chain --------------------------------------------------------
    chain input {
        type filter hook input priority 0; policy drop;

        # Loopback unconditional.
        iif "lo" accept

        # Connection tracking fast path.
        ct state established,related accept
        ct state invalid drop

        # ICMP / ICMPv6 (rate-limited).
        ip protocol icmp icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded, parameter-problem } limit rate 10/second accept
        ip6 nexthdr icmpv6 icmpv6 type { echo-request, echo-reply, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, destination-unreachable, time-exceeded, parameter-problem } limit rate 10/second accept

        # --- SSH from management CIDRs only ---------------------------------
        ip saddr @mgmt_v4 tcp dport 22 accept

        # --- Kubernetes API from management CIDRs ---------------------------
        ip saddr @mgmt_v4 tcp dport { {{ firewall_management_tcp_ports | join(', ') }} } accept

        # --- Unicast VRRP only from cluster CIDRs on the declared LAN --------
{% if control_plane_vip_enabled | bool %}
        iifname "{{ control_plane_vip_interface }}" ip saddr @cluster_v4 ip protocol {{ firewall_vrrp_protocol }} accept
{% endif %}

        # --- RKE2 cluster-internal traffic ----------------------------------
        ip saddr @cluster_v4 tcp dport { {{ firewall_cluster_tcp_ports | join(', ') }} } accept
        ip saddr @cluster_v4 udp dport { {{ firewall_cluster_udp_ports | join(', ') }} } accept

        # --- NodePorts: open to management + cluster (not world) ------------
        ip saddr @mgmt_v4    tcp dport {{ firewall_nodeport_range }} accept
        ip saddr @cluster_v4 tcp dport {{ firewall_nodeport_range }} accept

        # --- CNI traffic on the flannel VXLAN interface -----------------
        # flannel.1 traffic already matched by vxlan udp 8472 above; pod-to-pod
        # local traffic rides on the overlay, no separate rule needed.

{% if firewall_log_drops %}
        # Log + audit remaining drops (rate-limited to protect journald).
        limit rate 5/second log prefix "nft-drop: " level info flags all
{% endif %}

        # Implicit drop by chain policy.
    }

    # --- Output chain -------------------------------------------------------
    chain output {
        type filter hook output priority 0; policy accept;
        # Egress unrestricted. Cloudflare Tunnel is pull-only, so the cluster
        # initiates all outbound ingress. If future compliance requires
        # egress filtering, add rules here.
    }
}

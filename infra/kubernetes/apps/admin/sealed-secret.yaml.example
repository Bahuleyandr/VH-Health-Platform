# =============================================================================
# THIS IS A PLACEHOLDER.
#
# Real secrets must be created by:
#   1. Create a normal Secret YAML locally (do NOT commit it):
#        kubectl -n vhhealth create secret generic vhhealth-admin-env \
#          --from-literal=JWT_SECRET=... \
#          --from-literal=BACKEND_API_KEY=... \
#          ... \
#          --dry-run=client -o yaml > /tmp/vhhealth-admin-env.yaml
#   2. Encrypt with kubeseal:
#        kubeseal -f /tmp/vhhealth-admin-env.yaml -w sealed-secret.yaml \
#          --controller-namespace=sealed-secrets \
#          --controller-name=sealed-secrets-controller \
#          --scope=strict
#   3. Commit the sealed-secret.yaml.
#
# Every value below is base64("change-me-in-production"). They are placeholders
# only. Overlays MUST replace before syncing to any environment.
#
# Env vars covered (from apps/admin/CLAUDE.md + middleware.ts + /api/proxy):
#   required:
#     JWT_SECRET, BACKEND_API_KEY
#   optional but effectively required in prod:
#     SENTRY_AUTH_TOKEN, NEXT_PUBLIC_SENTRY_DSN, NEXT_PUBLIC_FIREBASE_API_KEY
#
# NOTE: NEXT_PUBLIC_FIREBASE_API_KEY is documented as a public identifier by
# Firebase (not a credential), but keeping it in the Secret simplifies rotation.
# =============================================================================
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: vhhealth-admin-env
  namespace: vhhealth
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
    vhhealth.app/placeholder: "true"
  labels:
    app.kubernetes.io/name: vhhealth-admin
    app.kubernetes.io/component: admin
    app.kubernetes.io/part-of: vhhealth
spec:
  template:
    metadata:
      name: vhhealth-admin-env
      namespace: vhhealth
    type: Opaque
  encryptedData:
    # JWT signing secret — MUST match the backend's JWT_SECRET exactly.
    # middleware.ts `jose.jwtVerify` fails closed in prod if this is missing.
    JWT_SECRET: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # Server-only API key — injected by /api/proxy, /api/login when forwarding
    # to the backend. Must match one of API_KEY / API_KEY_ADMIN on the backend.
    BACKEND_API_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # Sentry — DSN is safe to expose (it's a write-only ingest URL), but the
    # auth token (source-map upload during next build) is not.
    NEXT_PUBLIC_SENTRY_DSN: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    SENTRY_AUTH_TOKEN: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # Firebase client SDK key — technically public per Firebase docs, but
    # rotated through the same pipeline as the backend's Firebase creds.
    NEXT_PUBLIC_FIREBASE_API_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

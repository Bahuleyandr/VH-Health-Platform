# Placeholder schema only. Do not add this .example file to kustomization.yaml.
# Generate two independent high-entropy values (for example, separate
# `openssl rand -base64 48` invocations), confirm they differ, and seal each
# with strict scope for this exact name/namespace. They are not R2 credentials.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: backup-crypto
  namespace: vhhealth
  annotations:
    vhhealth.app/placeholder: "true"
  labels:
    app.kubernetes.io/name: vhhealth-backup-archive
    app.kubernetes.io/component: backup-crypto
    app.kubernetes.io/part-of: vhhealth
spec:
  encryptedData:
    BACKUP_ENCRYPTION_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    BACKUP_HMAC_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: backup-crypto
      namespace: vhhealth
    type: Opaque

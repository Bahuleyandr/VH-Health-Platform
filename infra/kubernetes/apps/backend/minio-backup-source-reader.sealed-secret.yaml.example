# Placeholder schema only. Do not add this .example file to kustomization.yaml.
# Create a MinIO service account that can list/get only `vhhealth-records`, seal
# it with strict scope for this exact name/namespace, and commit the ciphertext
# as an activation-owned manifest before the next manual Argo sync.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: minio-backup-source-reader
  namespace: vhhealth
  annotations:
    vhhealth.app/placeholder: "true"
  labels:
    app.kubernetes.io/name: vhhealth-backend-r2-sync
    app.kubernetes.io/component: backup-source-credentials
    app.kubernetes.io/part-of: vhhealth
spec:
  encryptedData:
    ACCESS_KEY_ID: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    SECRET_ACCESS_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: minio-backup-source-reader
      namespace: vhhealth
    type: Opaque

# Placeholder schema only. Do not add this .example file to kustomization.yaml.
# Seal a Cloudflare R2 Read & Write token restricted to the configured bucket.
# `offsite/minio-records/` is workload routing, not an R2 token boundary. This
# identity is producer-only and must never be mounted by verification or
# restore workloads.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: offsite-backup-producer
  namespace: vhhealth
  annotations:
    vhhealth.app/placeholder: "true"
  labels:
    app.kubernetes.io/name: vhhealth-backend-r2-sync
    app.kubernetes.io/component: backup-producer-credentials
    app.kubernetes.io/part-of: vhhealth
spec:
  encryptedData:
    ACCESS_KEY_ID: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    SECRET_ACCESS_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: offsite-backup-producer
      namespace: vhhealth
    type: Opaque

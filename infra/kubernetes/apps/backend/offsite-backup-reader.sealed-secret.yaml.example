# Placeholder schema only. Do not add this .example file to kustomization.yaml.
# Seal a separate Cloudflare R2 Object Read-only token restricted to the
# configured bucket. `offsite/minio-records/` is workload routing, not an R2
# token boundary. Do not reuse the producer or application-upload identity.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: offsite-backup-reader
  namespace: vhhealth
  annotations:
    vhhealth.app/placeholder: "true"
  labels:
    app.kubernetes.io/name: backup-verification
    app.kubernetes.io/component: backup-reader-credentials
    app.kubernetes.io/part-of: vhhealth
spec:
  encryptedData:
    ACCESS_KEY_ID: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    SECRET_ACCESS_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: offsite-backup-reader
      namespace: vhhealth
    type: Opaque

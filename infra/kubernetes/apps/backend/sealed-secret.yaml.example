# =============================================================================
# THIS IS A PLACEHOLDER.
#
# Real secrets must be created by:
#   1. Create a normal Secret YAML locally (do NOT commit it):
#        kubectl -n vhhealth create secret generic vhhealth-backend-env \
#          --from-literal=JWT_SECRET=... \
#          --from-literal=API_KEY=... \
#          ... (full list below) \
#          --dry-run=client -o yaml > /tmp/vhhealth-backend-env.yaml
#   2. Encrypt with kubeseal (controller must be installed in the cluster):
#        kubeseal -f /tmp/vhhealth-backend-env.yaml -w sealed-secret.yaml \
#          --controller-namespace=sealed-secrets \
#          --controller-name=sealed-secrets-controller \
#          --scope=strict
#   3. Commit the sealed-secret.yaml (NOT the plaintext yaml). The unsealing
#      controller in the cluster will materialize the real Secret at apply time.
#
# Every value below is base64("change-me-in-production") =
#   "Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=". They are placeholders only. Kustomize
# will fail-build if this manifest is missing; overlays MUST replace it with
# a real SealedSecret before syncing to any environment.
#
# Covered env vars (from apps/backend/src/utils/validateEnv.js + SYSTEM-ARCHITECTURE.md):
#   required (Joi .required()):
#     API_KEY, JWT_SECRET, DATABASE_URL
#   optional but effectively required in prod (warned at startup if missing):
#     CF_ACCOUNT_ID, CF_R2_URL, CF_R2_ACCESS_KEY_ID, CF_R2_SECRET_ACCESS_KEY,
#     FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY,
#     SENTRY_DSN, FIELD_ENCRYPTION_KEY, TOTP_ENCRYPTION_KEY
#   per-client API keys (referenced in CLAUDE.md auth architecture):
#     API_KEY_PATIENT, API_KEY_STAFF, API_KEY_ADMIN
#   other integrations (referenced in routes/services):
#     REDIS_URL, DATABASE_READ_URL, BACKUP_ENCRYPTION_KEY,
#     OPENAI_API_KEY, ANTHROPIC_API_KEY, CLINICAL_AI_API_KEY,
#     ABDM_CLIENT_ID, ABDM_CLIENT_SECRET, ADMIN_BOOTSTRAP_PASSWORD,
#     SLACK_SECURITY_WEBHOOK_URL, PAGERDUTY_ROUTING_KEY
#
# NOTE: CF_R2_BUCKET is non-secret and lives in the ConfigMap instead.
# =============================================================================
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: vhhealth-backend-env
  namespace: vhhealth
  annotations:
    # ArgoCD syncs secrets first (wave -3) so the Deployment can mount them.
    argocd.argoproj.io/sync-wave: "-3"
    # NOTE: This placeholder file's `encryptedData` values are NOT actually
    # SealedSecret ciphertext — they are plain base64 for lint validation only.
    # Real sealed secrets look like ~700-char AES+RSA-encrypted blobs.
    vhhealth.app/placeholder: "true"
  labels:
    app.kubernetes.io/name: vhhealth-backend
    app.kubernetes.io/component: api
    app.kubernetes.io/part-of: vhhealth
spec:
  template:
    metadata:
      name: vhhealth-backend-env
      namespace: vhhealth
    type: Opaque
  encryptedData:
    # ---- REQUIRED (Joi .required() in validateEnv.js) ----
    # App will crash at startup if any of these are missing.
    JWT_SECRET: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    API_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    DATABASE_URL: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # Per-client API keys (granular rotation; fallback to API_KEY above).
    API_KEY_PATIENT: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    API_KEY_STAFF: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    API_KEY_ADMIN: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # Optional read-replica — only populated if the environment has one.
    DATABASE_READ_URL: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- Redis (platform service, credential for ACL if enabled) ----
    # redis-sentinel.vhhealth-platform.svc.cluster.local:6379 — platform team
    # provisions the user; this is the password for the `vhhealth` user.
    REDIS_URL: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- Cloudflare R2 (object storage — file uploads, backups) ----
    CF_ACCOUNT_ID: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    CF_R2_URL: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    CF_R2_ACCESS_KEY_ID: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    CF_R2_SECRET_ACCESS_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- Firebase Admin SDK (patient OTP auth) ----
    FIREBASE_PROJECT_ID: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    FIREBASE_CLIENT_EMAIL: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    # PEM-encoded private key — ensure \n escapes survive round-tripping
    # through kubectl/kubeseal (use -f file form, never stdin-inline).
    FIREBASE_PRIVATE_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- Encryption keys (min 32 chars; see validateEnv.js) ----
    # MUST be rotated if ever exposed — decrypts PHI at rest.
    FIELD_ENCRYPTION_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    TOTP_ENCRYPTION_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    BACKUP_ENCRYPTION_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- Observability ----
    SENTRY_DSN: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- AI/LLM providers (clinical decision support, drafts) ----
    OPENAI_API_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    ANTHROPIC_API_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    CLINICAL_AI_API_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- ABDM (Ayushman Bharat Digital Mission) — India HIE integration ----
    ABDM_CLIENT_ID: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    ABDM_CLIENT_SECRET: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- Admin bootstrap (single-use; rotate after first login) ----
    ADMIN_BOOTSTRAP_PASSWORD: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

    # ---- Security webhooks (Slack/PagerDuty alerts) ----
    SLACK_SECURITY_WEBHOOK_URL: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
    PAGERDUTY_ROUTING_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

# =============================================================================
# THIS IS A PLACEHOLDER.
#
# Real secrets must be created by:
#   1. Create a normal Secret YAML locally (do NOT commit it):
#        kubectl -n vhhealth create secret generic vhhealth-backend-env \
#          --from-literal=JWT_SECRET=... \
#          --from-literal=API_KEY=... \
#          ... (full list below) \
#          --dry-run=client -o yaml > /tmp/vhhealth-backend-env.yaml
#   2. Encrypt with kubeseal (controller must be installed in the cluster):
#        kubeseal -f /tmp/vhhealth-backend-env.yaml -w sealed-secret.yaml \
#          --controller-namespace=sealed-secrets \
#          --controller-name=sealed-secrets-controller \
#          --scope=strict
#   3. Commit the sealed-secret.yaml (NOT the plaintext yaml). The unsealing
#      controller in the cluster will materialize the real Secret at apply time.
#
# Every value below is a non-secret placeholder marker. This `.example` schema
# is excluded from every Kustomize render. Before a manual Argo sync, seal and
# apply the real Secret under the exact name and namespace below.
#
# Covered env vars (from apps/backend/src/utils/validateEnv.js + SYSTEM-ARCHITECTURE.md):
#   required (Joi .required()):
#     API_KEY, JWT_SECRET, DATABASE_URL
#   migration-only (consumed by the PreSync migration Job, NOT the Deployment):
#     DATABASE_SUPERUSER_URL   (see INF-4/INF-8 note below)
#   required when enabled:
#     HL7_INBOUND_SHARED_SECRET, ABDM_CALLBACK_SECRET
#   optional but effectively required in prod (warned at startup if missing):
#     CF_R2_ACCESS_KEY_ID, CF_R2_SECRET_ACCESS_KEY,
#     FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY,
#     SENTRY_DSN, MONITORING_TOKEN, FIELD_ENCRYPTION_KEY, TOTP_ENCRYPTION_KEY
#   per-client API keys (referenced in CLAUDE.md auth architecture):
#     API_KEY_PATIENT, API_KEY_STAFF, API_KEY_ADMIN
#   other integrations (referenced in routes/services):
#     REDIS_URL, DATABASE_READ_URL,
#     OPENAI_API_KEY, ANTHROPIC_API_KEY, CLINICAL_AI_API_KEY,
#     ABDM_CLIENT_ID, ABDM_CLIENT_SECRET, ADMIN_BOOTSTRAP_PASSWORD,
#     SLACK_SECURITY_WEBHOOK_URL, PAGERDUTY_ROUTING_KEY
#
# NOTE: CF_ACCOUNT_ID, R2_ENDPOINT, CF_R2_URL, and CF_R2_BUCKET are non-secret
# and live in the ConfigMap. CF_R2_URL is the public object-download base, not
# the S3 API endpoint; it remains empty until an operator supplies the proven
# public/custom-domain base. Backup archive encryption uses the dedicated
# `backup-crypto` Secret schema, not this broad backend application Secret.
# =============================================================================
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: vhhealth-backend-env
  namespace: vhhealth
  annotations:
    # ArgoCD syncs secrets first (wave -3) so the Deployment can mount them.
    argocd.argoproj.io/sync-wave: "-3"
    # NOTE: This placeholder file's `encryptedData` values are NOT actually
    # SealedSecret ciphertext — they are plain base64 for lint validation only.
    # Real sealed secrets look like ~700-char AES+RSA-encrypted blobs.
    vhhealth.app/placeholder: "true"
  labels:
    app.kubernetes.io/name: vhhealth-backend
    app.kubernetes.io/component: api
    app.kubernetes.io/part-of: vhhealth
spec:
  template:
    metadata:
      name: vhhealth-backend-env
      namespace: vhhealth
    type: Opaque
  encryptedData:
    # ---- REQUIRED (Joi .required() in validateEnv.js) ----
    # App will crash at startup if any of these are missing.
    JWT_SECRET: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    API_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    # DATABASE_URL — the backend's RUNTIME connection (audit findings INF-4 +
    # INF-8). MUST authenticate as the NOSUPERUSER, NOBYPASSRLS role
    # `vhhealth_runtime` (CNPG managed.roles in base/cnpg/cluster.yaml) so that
    # tenant_isolation RLS is actually enforced on the app's connection. The
    # superuser/owner connection is NOT used by the Deployment — it would
    # silently bypass RLS. Example DSN (seal the real password — same value as
    # the vhhealth-pg-runtime SealedSecret in base/cnpg):
    #   postgresql://vhhealth_runtime:<pw>@vhhealth-pg-rw.vhhealth-platform.svc.cluster.local:5432/vhhealth?sslmode=require
    DATABASE_URL: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    # DATABASE_SUPERUSER_URL — DDL/migration connection, consumed ONLY by the
    # PreSync migration Job (apps/backend/migration-job.yaml overrides
    # DATABASE_URL from THIS key). Authenticates as the bootstrap OWNER role
    # `vhhealth` (bootstrap.initdb.owner, secret vhhealth-pg-app) — the owner can
    # run every migration's DDL and CREATE the trusted extensions. The
    # Deployment NEVER reads this key. Example DSN (seal the real owner password
    # from the vhhealth-pg-app secret):
    #   postgresql://vhhealth:<owner-pw>@vhhealth-pg-rw.vhhealth-platform.svc.cluster.local:5432/vhhealth?sslmode=require
    DATABASE_SUPERUSER_URL: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # Per-client API keys (granular rotation; fallback to API_KEY above).
    API_KEY_PATIENT: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    API_KEY_STAFF: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    API_KEY_ADMIN: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # Optional read-replica — only populated if the environment has one.
    DATABASE_READ_URL: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- Redis (platform service, credential for ACL if enabled) ----
    # redis-sentinel.vhhealth-platform.svc.cluster.local:6379 — platform team
    # provisions the user; this is the password for the `vhhealth` user.
    REDIS_URL: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- Cloudflare R2 application object storage (file uploads) ----
    CF_R2_ACCESS_KEY_ID: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    CF_R2_SECRET_ACCESS_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- Firebase Admin SDK (patient OTP auth) ----
    FIREBASE_PROJECT_ID: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    FIREBASE_CLIENT_EMAIL: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    # PEM-encoded private key — ensure \n escapes survive round-tripping
    # through kubectl/kubeseal (use -f file form, never stdin-inline).
    FIREBASE_PRIVATE_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- Encryption keys (min 32 chars; see validateEnv.js) ----
    # MUST be rotated if ever exposed — decrypts PHI at rest.
    FIELD_ENCRYPTION_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    TOTP_ENCRYPTION_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- Signed public/integration callbacks (min 32 chars) ----
    # Required when HL7_INBOUND_ENABLED=true: HMAC over inbound HL7 messages
    # that mutate admissions/investigations before global JWT auth.
    HL7_INBOUND_SHARED_SECRET: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- Observability ----
    # Required by the production readiness exec probe and protected
    # /health/ready + /health/metrics monitoring endpoints.
    MONITORING_TOKEN: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    SENTRY_DSN: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- AI/LLM providers (clinical decision support, drafts) ----
    OPENAI_API_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    ANTHROPIC_API_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    CLINICAL_AI_API_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- ABDM (Ayushman Bharat Digital Mission) — India HIE integration ----
    ABDM_CLIENT_ID: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    ABDM_CLIENT_SECRET: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    # Required whenever ABDM_ENABLED=true: HMAC over public callbacks.
    ABDM_CALLBACK_SECRET: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    # Required whenever ABDM_ENABLED=true (CAN-026): the Consent-Manager public
    # key for artefact-signature verification. ABDM_VERIFY_CONSENT_ARTEFACT must
    # also be set to "true" (in the configmap/env, not secret) or the backend
    # refuses to boot.
    ABDM_CM_PUBLIC_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- Admin bootstrap (single-use; rotate after first login) ----
    ADMIN_BOOTSTRAP_PASSWORD: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

    # ---- Security webhooks (Slack/PagerDuty alerts) ----
    SLACK_SECURITY_WEBHOOK_URL: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    PAGERDUTY_ROUTING_KEY: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

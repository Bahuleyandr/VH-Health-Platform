# argocd/repo-credentials.sealed-secret.yaml.example
#
# GitHub credentials for Argo CD to pull this private repo. Scope:
# Contents:Read on Bahuleyandr/VH-Health-Platform.
#
# Create the real SealedSecret:
#
#   cat > /tmp/argocd-repo-creds.yaml <<'EOF'
#   apiVersion: v1
#   kind: Secret
#   metadata:
#     name: repo-vhhealth-platform
#     namespace: argocd
#     labels:
#       argocd.argoproj.io/secret-type: repository
#   type: Opaque
#   stringData:
#     type: git
#     url: https://github.com/Bahuleyandr/VH-Health-Platform
#     password: <github-personal-access-token>
#     username: <github-username>
#   EOF
#
#   kubeseal --controller-namespace vhhealth-security \
#            --controller-name sealed-secrets --format yaml \
#     < /tmp/argocd-repo-creds.yaml \
#     > infra/kubernetes/base/argocd/repo-credentials.sealed-secret.yaml
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: repo-vhhealth-platform
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
    app.kubernetes.io/name: argo-cd
    app.kubernetes.io/component: repo-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    type: REPLACE_WITH_KUBESEAL_OUTPUT
    url: REPLACE_WITH_KUBESEAL_OUTPUT
    username: REPLACE_WITH_KUBESEAL_OUTPUT
    password: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: repo-vhhealth-platform
      namespace: argocd
      labels:
        argocd.argoproj.io/secret-type: repository
    type: Opaque

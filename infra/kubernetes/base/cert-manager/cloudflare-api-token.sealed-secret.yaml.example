# cert-manager/cloudflare-api-token.sealed-secret.yaml.example
#
# The Cloudflare API token used by cert-manager to complete DNS-01
# challenges. Scope: Zone:DNS:Edit on `vhhealth.app`.
#
# Create the real SealedSecret:
#
#   kubectl create secret generic cloudflare-api-token \
#     --namespace vhhealth-security \
#     --from-literal=api-token="<paste-token>" \
#     --dry-run=client -o yaml \
#   | kubeseal --controller-namespace vhhealth-security \
#              --controller-name sealed-secrets --format yaml \
#   > infra/kubernetes/base/cert-manager/cloudflare-api-token.sealed-secret.yaml
#
# The token rotates every 90 days (Cloudflare enforces expiry on
# custom-scope tokens). The rotation runbook is in
# `apps/backend/docs/RUNBOOKS/` — owned by ops.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cloudflare-api-token
  namespace: vhhealth-security
  labels:
    app.kubernetes.io/name: cert-manager
    app.kubernetes.io/component: dns-challenge-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    api-token: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: cloudflare-api-token
      namespace: vhhealth-security
    type: Opaque

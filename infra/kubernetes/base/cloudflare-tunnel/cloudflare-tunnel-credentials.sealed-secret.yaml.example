# cloudflare-tunnel/cloudflare-tunnel-credentials.sealed-secret.yaml.example
#
# Cloudflare tunnel credentials JSON. Create the tunnel once in the
# Cloudflare dashboard (Zero Trust → Networks → Tunnels → Create a tunnel)
# and save the token. Then:
#
#   cat > /tmp/tunnel.yaml <<'EOF'
#   apiVersion: v1
#   kind: Secret
#   metadata:
#     name: cloudflare-tunnel-credentials
#     namespace: vhhealth-ingress
#   type: Opaque
#   stringData:
#     credentials.json: |
#       {
#         "AccountTag": "<cloudflare-account-tag>",
#         "TunnelSecret": "<base64-encoded-random-secret>",
#         "TunnelID": "<tunnel-uuid>"
#       }
#   EOF
#
#   kubeseal --controller-namespace vhhealth-security \
#            --controller-name sealed-secrets --format yaml \
#     < /tmp/tunnel.yaml \
#     > infra/kubernetes/base/cloudflare-tunnel/cloudflare-tunnel-credentials.sealed-secret.yaml
#
# The tunnel is named `vhhealth-prod` (matches `tunnel:` in config.yaml).
# DNS records (api.vhhealth.app CNAME to <tunnel>.cfargotunnel.com,
# admin.vhhealth.app the same) are created via the Cloudflare dashboard
# at tunnel setup time. We don't manage them from Kubernetes — the
# cloudflared ingress config below is what picks up the hostnames.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cloudflare-tunnel-credentials
  namespace: vhhealth-ingress
  labels:
    app.kubernetes.io/name: cloudflared
    app.kubernetes.io/component: tunnel-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    credentials.json: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: cloudflare-tunnel-credentials
      namespace: vhhealth-ingress
    type: Opaque

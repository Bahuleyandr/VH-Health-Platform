# cnpg/backup-credentials.sealed-secret.yaml.example — R2 credentials for pgBackRest
#
# This file is a placeholder. Create the real SealedSecret via:
#
#   1. Create a plaintext Secret locally (DO NOT COMMIT):
#        cat > /tmp/cnpg-backup-credentials.yaml <<EOF
#        apiVersion: v1
#        kind: Secret
#        metadata:
#          name: cnpg-backup-credentials
#          namespace: vhhealth-platform
#        type: Opaque
#        stringData:
#          ACCESS_KEY_ID: <cloudflare-r2-access-key-id>
#          SECRET_ACCESS_KEY: <cloudflare-r2-secret-access-key>
#        EOF
#
#   2. Encrypt it with the cluster's sealed-secrets public cert:
#        kubeseal --controller-namespace vhhealth-security \
#                 --controller-name sealed-secrets \
#                 --format yaml \
#                 < /tmp/cnpg-backup-credentials.yaml \
#                 > infra/kubernetes/base/cnpg/backup-credentials.sealed-secret.yaml
#
#   3. Commit the *sealed* file (drop the .example suffix), delete the plaintext.
#
# The R2 bucket lives in Cloudflare under account CF_R2_ACCOUNT_ID with a
# bucket named `vhhealth-db-backups` and an API token scoped to that
# bucket with Object:Read+Write permissions. The token is rotated every
# 90 days — refer to the runbook in apps/backend/docs/RUNBOOKS/.
#
# Below is an illustrative (NON-FUNCTIONAL, dummy-value) SealedSecret so
# that `kustomize build` succeeds before the real secret is sealed.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cnpg-backup-credentials
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: cloudnative-pg
    app.kubernetes.io/component: backup-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
    vhhealth.app/description: "Replace with output of kubeseal before deploying."
spec:
  encryptedData:
    ACCESS_KEY_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    SECRET_ACCESS_KEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: cnpg-backup-credentials
      namespace: vhhealth-platform
    type: Opaque

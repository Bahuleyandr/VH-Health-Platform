# Seal this example for `vhhealth-platform` before the next manual Argo sync.
# The Cloudflare R2 token must be bucket-scoped Object Read/Write; the
# configured `cluster/` prefix is a Barman routing boundary, not a token
# boundary. Barman retention requires delete authority. Never use it in
# verification or restore workloads.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cnpg-backup-producer-credentials
  namespace: vhhealth-platform
spec:
  encryptedData:
    ACCESS_KEY_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    SECRET_ACCESS_KEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: cnpg-backup-producer-credentials
      namespace: vhhealth-platform
      labels:
        cnpg.io/reload: "true"
    type: Opaque

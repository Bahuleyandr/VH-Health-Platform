# Seal a short-lived Cloudflare R2 temporary credential for
# `vhhealth-platform` only after the C6.2 synthetic qualification passes.
# Its locally signed action list is limited to the exact `cluster/` prefix and
# the Barman write/read/list/multipart calls observed in qualification. It
# MUST omit DeleteObject and DeleteObjects. Never place the parent signing
# credential, retention remover, or lock administrator in this namespace.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cnpg-backup-producer-credentials
  namespace: vhhealth-platform
spec:
  encryptedData:
    ACCESS_KEY_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    ACCESS_SESSION_TOKEN: REPLACE_WITH_KUBESEAL_OUTPUT
    SECRET_ACCESS_KEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: cnpg-backup-producer-credentials
      namespace: vhhealth-platform
      labels:
        cnpg.io/reload: "true"
        vhhealth.app/credential-role: backup-writer
    type: Opaque

# Seal the Object Read-only DR identity separately for each namespace before
# the next manual Argo sync. It must not have Object Write/Delete authority.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cnpg-dr-reader-credentials
  namespace: vhhealth-platform
spec:
  encryptedData:
    ACCESS_KEY_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    SECRET_ACCESS_KEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: cnpg-dr-reader-credentials
      namespace: vhhealth-platform
      labels:
        cnpg.io/reload: "true"
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cnpg-dr-reader-credentials
  namespace: vhhealth-restore-proof
spec:
  encryptedData:
    ACCESS_KEY_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    SECRET_ACCESS_KEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: cnpg-dr-reader-credentials
      namespace: vhhealth-restore-proof
      labels:
        cnpg.io/reload: "true"
    type: Opaque

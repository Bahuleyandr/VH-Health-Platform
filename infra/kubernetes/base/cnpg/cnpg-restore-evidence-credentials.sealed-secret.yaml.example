# Operator-generated examples only. Evidence upload and independent readback
# use different short-lived R2 temporary credentials on the approved off-site
# evidence prefix. Neither credential may access the database archive.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cnpg-restore-evidence-writer-credentials
  namespace: vhhealth-restore-proof
spec:
  encryptedData:
    ACCESS_KEY_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    ACCESS_SESSION_TOKEN: REPLACE_WITH_KUBESEAL_OUTPUT
    SECRET_ACCESS_KEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: cnpg-restore-evidence-writer-credentials
      namespace: vhhealth-restore-proof
      labels:
        vhhealth.app/credential-role: restore-evidence-writer
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cnpg-restore-evidence-reader-credentials
  namespace: vhhealth-restore-proof
spec:
  encryptedData:
    ACCESS_KEY_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    ACCESS_SESSION_TOKEN: REPLACE_WITH_KUBESEAL_OUTPUT
    SECRET_ACCESS_KEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: cnpg-restore-evidence-reader-credentials
      namespace: vhhealth-restore-proof
      labels:
        vhhealth.app/credential-role: restore-evidence-reader
    type: Opaque

# Operator-generated example only. The short-lived R2 temporary credential is
# scoped to the production database archive prefix and may list/head/get/delete
# approved objects. It must not put, overwrite, configure locks, or access
# restore evidence. Seal only for a named approved removal window.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: cnpg-retention-remover-credentials
  namespace: vhhealth-platform
spec:
  encryptedData:
    ACCESS_KEY_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    ACCESS_SESSION_TOKEN: REPLACE_WITH_KUBESEAL_OUTPUT
    SECRET_ACCESS_KEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: cnpg-retention-remover-credentials
      namespace: vhhealth-platform
      labels:
        vhhealth.app/credential-role: retention-remover
    type: Opaque

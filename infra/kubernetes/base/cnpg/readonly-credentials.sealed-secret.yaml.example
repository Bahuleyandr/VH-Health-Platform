# cnpg/readonly-credentials.sealed-secret.yaml.example — vhhealth_readonly password
#
# Audit finding H10 (2026-06-10): the vhhealth_readonly role (SELECT on every
# PHI table) previously had its password set INLINE at initdb to the literal
# 'set-in-sealed-secret'. The role is now CNPG-managed (managed.roles in
# cluster.yaml) with `passwordSecret: vhhealth-pg-readonly` — the operator
# applies AND rotates the password from this secret on running clusters.
#
# This file is a placeholder. Create the real SealedSecret via:
#
#   1. Generate a strong password and create a plaintext Secret locally
#      (DO NOT COMMIT). CNPG passwordSecret requires type
#      kubernetes.io/basic-auth with username matching the role name:
#        PW="$(openssl rand -base64 32)"
#        cat > /tmp/vhhealth-pg-readonly.yaml <<EOF
#        apiVersion: v1
#        kind: Secret
#        metadata:
#          name: vhhealth-pg-readonly
#          namespace: vhhealth-platform
#          labels:
#            cnpg.io/reload: "true"
#        type: kubernetes.io/basic-auth
#        stringData:
#          username: vhhealth_readonly
#          password: "$PW"
#        EOF
#
#   2. Encrypt it with the cluster's sealed-secrets public cert:
#        kubeseal --controller-namespace vhhealth-security \
#                 --controller-name sealed-secrets \
#                 --format yaml \
#                 < /tmp/vhhealth-pg-readonly.yaml \
#                 > infra/kubernetes/base/cnpg/readonly-credentials.sealed-secret.yaml
#
#   3. Commit the *sealed* file (drop the .example suffix), delete the
#      plaintext, and update every dashboard/export consumer with the new
#      password (also delivered via SealedSecret, never chat/email).
#
# OPERATOR ACTION on already-bootstrapped clusters (initdb SQL will not
# re-run): applying the secret + the managed.roles entry causes the operator
# to ALTER ROLE with the new password — verify with
#   kubectl cnpg psql vhhealth-pg -- -c "\du vhhealth_readonly"
# and confirm the old 'set-in-sealed-secret' password no longer authenticates.
#
# Below is an illustrative (NON-FUNCTIONAL, dummy-value) SealedSecret so that
# `kustomize build` succeeds before the real secret is sealed.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: vhhealth-pg-readonly
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: cloudnative-pg
    app.kubernetes.io/component: readonly-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
    vhhealth.app/description: "Replace with output of kubeseal before deploying."
spec:
  encryptedData:
    username: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: vhhealth-pg-readonly
      namespace: vhhealth-platform
      labels:
        cnpg.io/reload: "true"
    type: kubernetes.io/basic-auth

# cnpg/runtime-credentials.sealed-secret.yaml.example — vhhealth_runtime password
#
# Audit findings INF-4 + INF-8 (mirrors the dalekdefender precedent in
# overlays/dalekdefender/rls-runtime-role.sql §M17): the backend previously
# connected to Postgres as the SUPERUSER `postgres`, which bypasses ALL
# row-level security — every tenant_isolation policy was silently inert outside
# a SET LOCAL ROLE transaction. The app now connects as the NOSUPERUSER,
# NOBYPASSRLS `vhhealth_runtime` LOGIN role (CNPG managed.roles in cluster.yaml,
# `passwordSecret: vhhealth-pg-runtime`). The operator applies AND rotates the
# password from this secret on running clusters.
#
# This file is a placeholder. Create the real SealedSecret via:
#
#   1. Generate a strong password and create a plaintext Secret locally
#      (DO NOT COMMIT). CNPG passwordSecret requires type
#      kubernetes.io/basic-auth with username matching the role name:
#        PW="$(openssl rand -base64 32)"
#        cat > /tmp/vhhealth-pg-runtime.yaml <<EOF
#        apiVersion: v1
#        kind: Secret
#        metadata:
#          name: vhhealth-pg-runtime
#          namespace: vhhealth-platform
#          labels:
#            cnpg.io/reload: "true"
#        type: kubernetes.io/basic-auth
#        stringData:
#          username: vhhealth_runtime
#          password: "$PW"
#        EOF
#
#   2. Encrypt it with the cluster's sealed-secrets public cert:
#        kubeseal --controller-namespace vhhealth-security \
#                 --controller-name sealed-secrets \
#                 --format yaml \
#                 < /tmp/vhhealth-pg-runtime.yaml \
#                 > infra/kubernetes/base/cnpg/runtime-credentials.sealed-secret.yaml
#
#   3. Commit the *sealed* file (drop the .example suffix), delete the plaintext.
#      The SAME password must also be embedded in the backend's DATABASE_URL —
#      see infra/kubernetes/apps/backend/sealed-secret.yaml.example. Build the
#      runtime DSN and seal it into the vhhealth-backend-env SealedSecret:
#        DATABASE_URL="postgresql://vhhealth_runtime:${PW}@vhhealth-pg-rw.vhhealth-platform.svc.cluster.local:5432/vhhealth?sslmode=require"
#      (Use the -rw service for the primary; route through the pooler only if the
#      backend pool sizing calls for it.)
#
# OPERATOR ACTION on already-bootstrapped clusters (initdb SQL will not re-run):
# applying this secret + the managed.roles entry causes the operator to set/ALTER
# the vhhealth_runtime password. Verify with
#   kubectl cnpg psql vhhealth-pg -- -c "\du vhhealth_runtime"
# and confirm the role is `Cannot bypass RLS` and NOT a superuser. Object grants
# (SELECT/INSERT/...) are applied at backend boot by
# ensureTenantRlsRuntimeRoleGrants (apps/backend/src/lib/prisma.js).
#
# Below is an illustrative (NON-FUNCTIONAL, dummy-value) SealedSecret so that
# `kustomize build` succeeds before the real secret is sealed.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: vhhealth-pg-runtime
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: cloudnative-pg
    app.kubernetes.io/component: runtime-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
    vhhealth.app/description: "Replace with output of kubeseal before deploying."
spec:
  encryptedData:
    username: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: vhhealth-pg-runtime
      namespace: vhhealth-platform
      labels:
        cnpg.io/reload: "true"
    type: kubernetes.io/basic-auth

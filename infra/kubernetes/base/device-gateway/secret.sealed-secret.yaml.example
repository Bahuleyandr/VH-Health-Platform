apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: device-gateway-secret
  namespace: vhhealth
spec:
  encryptedData:
    backend-token: REPLACE_WITH_SEALED_DEVICE_GATEWAY_JWT
    api-key: REPLACE_WITH_SEALED_DEVICE_GATEWAY_API_KEY
    # Repeat one sealed key per DEVICE_GATEWAY_LIS_LISTENERS token_env name.
    LIS_CHEM1_TOKEN: REPLACE_WITH_SEALED_LIS_CHEM1_JWT
  template:
    metadata:
      name: device-gateway-secret
      namespace: vhhealth
    type: Opaque

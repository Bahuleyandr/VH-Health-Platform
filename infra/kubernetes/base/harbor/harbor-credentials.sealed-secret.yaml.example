# harbor/harbor-credentials.sealed-secret.yaml.example — Harbor external dep creds
#
# Harbor needs four distinct secrets (all in namespace `vhhealth-platform`):
#   1. harbor-database-credentials: keys `password`
#      — Postgres password for `harbor` role in CNPG vhhealth-pg.
#   2. harbor-redis-credentials: keys `REDIS_PASSWORD`
#      — Redis auth password (same as redis-credentials, different key name).
#   3. harbor-s3-credentials: keys `REGISTRY_STORAGE_S3_ACCESSKEY`,
#      `REGISTRY_STORAGE_S3_SECRETKEY`
#      — MinIO scoped service account that can only read/write
#        `harbor-registry` bucket.
#   4. harbor-core-secret: keys `HARBOR_ADMIN_PASSWORD`, `secret`
#      — Initial admin user password + the in-cluster gRPC shared secret.
#
# Also:
#   5. harbor-robot-account-ci: keys `username`, `password`
#      — Robot account used by GitHub Actions to push images. Created
#        once via Harbor UI ("Projects → vhhealth → Robot Accounts → +").
#        Token scope: push/pull on vhhealth/*, no admin rights. Stored
#        in the `image-push` GitHub environment as a secret; Agent E
#        wires it into the workflow.
#
# Recipe (one example; repeat per secret):
#
#   kubectl create secret generic harbor-database-credentials \
#     --namespace vhhealth-platform \
#     --from-literal=password="$(openssl rand -hex 32)" \
#     --dry-run=client -o yaml \
#   | kubeseal --controller-namespace vhhealth-security \
#              --controller-name sealed-secrets --format yaml \
#   > infra/kubernetes/base/harbor/harbor-database-credentials.sealed-secret.yaml
#
# After sealing, also run on the Postgres primary once:
#   CREATE ROLE harbor WITH LOGIN PASSWORD '<same-value>';
#   CREATE DATABASE harbor OWNER harbor;
#
# The placeholders below make `kustomize build` succeed before sealing.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: harbor-database-credentials
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/component: database-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    password: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: harbor-database-credentials
      namespace: vhhealth-platform
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: harbor-redis-credentials
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/component: redis-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    REDIS_PASSWORD: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: harbor-redis-credentials
      namespace: vhhealth-platform
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: harbor-s3-credentials
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/component: s3-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    REGISTRY_STORAGE_S3_ACCESSKEY: REPLACE_WITH_KUBESEAL_OUTPUT
    REGISTRY_STORAGE_S3_SECRETKEY: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: harbor-s3-credentials
      namespace: vhhealth-platform
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: harbor-core-secret
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/component: core-secret
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    HARBOR_ADMIN_PASSWORD: REPLACE_WITH_KUBESEAL_OUTPUT
    secret: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: harbor-core-secret
      namespace: vhhealth-platform
    type: Opaque

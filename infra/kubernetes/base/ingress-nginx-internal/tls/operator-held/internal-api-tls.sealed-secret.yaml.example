# UNSELECTED C-D13 option and schema example only.
# Replace both placeholders using kubeseal against the approved cluster after
# the security owner approves certificate custody. Never commit plaintext TLS
# material or copy ciphertext between clusters.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: c-d13-unprovisioned-internal-api-tls
  namespace: vhhealth
  labels:
    app.kubernetes.io/name: vhhealth-backend
    app.kubernetes.io/component: internal-api-tls
    app.kubernetes.io/part-of: vhhealth
  annotations:
    vhhealth.app/activation-hold: C-D13
spec:
  encryptedData:
    tls.crt: REPLACE_WITH_KUBESEAL_CIPHERTEXT
    tls.key: REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: c-d13-unprovisioned-internal-api-tls
      namespace: vhhealth
    type: kubernetes.io/tls

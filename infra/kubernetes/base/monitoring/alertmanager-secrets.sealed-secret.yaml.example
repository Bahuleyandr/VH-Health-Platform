# monitoring/alertmanager-secrets.sealed-secret.yaml.example
#
# Alertmanager receiver credentials:
#   - `discord-webhook-url`: operational alerts channel (same webhook as
#     backend ALERT_WEBHOOK_URL). Re-use to keep ops in one channel.
#   - `discord-watchdog-url`: dedicated muted channel (or healthchecks.io
#     ping URL) for the Watchdog/deadman's-switch alert. The Watchdog fires
#     continuously; routing it separately avoids alert fatigue on the main
#     channel. If this channel goes silent, the alerting pipeline is broken.
#     Recommended: use healthchecks.io (free tier) — paste the ping URL here.
#     The Watchdog route in kube-prometheus-values.yaml fires every 5 minutes
#     with `send_resolved: false` so a missed ping is detectable within 10m.
#   - `pagerduty-routing-key`: placeholder; populated when we onboard
#     PagerDuty (batch 18).
#   - `grafana-admin-credentials`: rendered into Secret
#     `grafana-admin-credentials` that the Helm chart consumes.
#
# OPERATOR ACTIONS — run these once per environment, seal, commit the output:
#
# Step 1 — seal alertmanager-secrets (three keys):
#
#   kubectl create secret generic alertmanager-secrets \
#     --namespace vhhealth-monitoring \
#     --from-literal=discord-webhook-url="<ALERT_WEBHOOK_URL from backend env>" \
#     --from-literal=discord-watchdog-url="<healthchecks.io ping URL or muted Discord webhook>" \
#     --from-literal=pagerduty-routing-key="<PagerDuty integration key or PLACEHOLDER>" \
#     --dry-run=client -o yaml \
#   | kubeseal \
#       --controller-name=sealed-secrets \
#       --controller-namespace=vhhealth-security \
#       --format yaml \
#   > infra/kubernetes/base/monitoring/alertmanager-secrets.sealed-secret.yaml
#
# Step 2 — seal grafana-admin-credentials:
#
#   kubectl create secret generic grafana-admin-credentials \
#     --namespace vhhealth-monitoring \
#     --from-literal=admin-user=admin \
#     --from-literal=admin-password="$(openssl rand -hex 20)" \
#     --dry-run=client -o yaml \
#   | kubeseal \
#       --controller-name=sealed-secrets \
#       --controller-namespace=vhhealth-security \
#       --format yaml \
#   > infra/kubernetes/base/monitoring/grafana-admin-credentials.sealed-secret.yaml
#
# Step 3 — commit BOTH .yaml files (remove the .example suffix) and push.
#   ArgoCD will sync them; sealed-secrets controller will unseal into the
#   vhhealth-monitoring namespace.
#
# NOTE: SealedSecrets are cluster-scoped — ciphertext sealed on one cluster
# will NOT decrypt on another. Re-seal if migrating to a new cluster or after
# rotating the sealed-secrets controller key pair.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: alertmanager-secrets
  namespace: vhhealth-monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: receiver-secrets
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    discord-webhook-url: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    pagerduty-routing-key: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: alertmanager-secrets
      namespace: vhhealth-monitoring
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: grafana-admin-credentials
  namespace: vhhealth-monitoring
  labels:
    app.kubernetes.io/name: grafana
    app.kubernetes.io/component: admin-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    admin-user: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    admin-password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: grafana-admin-credentials
      namespace: vhhealth-monitoring
    type: Opaque

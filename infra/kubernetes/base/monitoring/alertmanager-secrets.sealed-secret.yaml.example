# monitoring/alertmanager-secrets.sealed-secret.yaml.example
#
# Alertmanager receiver credentials:
#   - `alertmanager.yaml`: the complete, amtool-validated configuration copied
#     from alertmanager.yaml.example after every OWNER_INPUT is supplied.
#   - `discord-webhook-url`: legacy key name for an Alertmanager-compatible
#     operations webhook/relay. Do not assume a raw chat webhook accepts the
#     Alertmanager webhook payload.
#   - `discord-watchdog-url`: off-site dead-man heartbeat destination. Its
#     evidence and retention remain outside the monitored site.
#   - `pagerduty-routing-key`: critical-alert integration key.
#   - `slack-api-url`: Slack incoming-webhook endpoint used by team receivers.
#   - `smtp-password`: SMTP credential for the email receivers.
#   - `grafana-admin-credentials`: rendered into Secret
#     `grafana-admin-credentials` that the Helm chart consumes.
#
# OPERATOR ACTIONS — run these once per environment, seal, commit the output:
#
# Step 1 — copy alertmanager.yaml.example to a secure working directory,
# replace every OWNER_INPUT value, and validate it:
#
#   amtool check-config /secure/path/alertmanager.yaml
#
# Step 2 — seal alertmanager-secrets (six keys):
#
#   kubectl create secret generic alertmanager-secrets \
#     --namespace vhhealth-monitoring \
#     --from-file=alertmanager.yaml=/secure/path/alertmanager.yaml \
#     --from-literal=discord-webhook-url="<SECURITY_WEBHOOK_URL from backend env>" \
#     --from-literal=discord-watchdog-url="<OWNER INPUT off-site dead-man heartbeat URL>" \
#     --from-literal=pagerduty-routing-key="<OWNER INPUT PagerDuty integration key>" \
#     --from-literal=slack-api-url="<OWNER INPUT Slack incoming-webhook URL>" \
#     --from-literal=smtp-password="<OWNER INPUT SMTP password>" \
#     --dry-run=client -o yaml \
#   | kubeseal \
#       --controller-name=sealed-secrets \
#       --controller-namespace=vhhealth-security \
#       --format yaml \
#   > infra/kubernetes/base/monitoring/alertmanager-secrets.sealed-secret.yaml
#
# Step 3 — seal grafana-admin-credentials:
#
#   kubectl create secret generic grafana-admin-credentials \
#     --namespace vhhealth-monitoring \
#     --from-literal=admin-user=admin \
#     --from-literal=admin-password="$(openssl rand -hex 20)" \
#     --dry-run=client -o yaml \
#   | kubeseal \
#       --controller-name=sealed-secrets \
#       --controller-namespace=vhhealth-security \
#       --format yaml \
#   > infra/kubernetes/base/monitoring/grafana-admin-credentials.sealed-secret.yaml
#
# Step 4 — commit BOTH .yaml files (remove the .example suffix) and push.
#   ArgoCD will sync them; sealed-secrets controller will unseal into the
#   vhhealth-monitoring namespace.
#
# NOTE: SealedSecrets are cluster-scoped — ciphertext sealed on one cluster
# will NOT decrypt on another. Re-seal if migrating to a new cluster or after
# rotating the sealed-secrets controller key pair.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: alertmanager-secrets
  namespace: vhhealth-monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: receiver-secrets
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    alertmanager.yaml: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    discord-webhook-url: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    discord-watchdog-url: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    pagerduty-routing-key: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    slack-api-url: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    smtp-password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: alertmanager-secrets
      namespace: vhhealth-monitoring
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: grafana-admin-credentials
  namespace: vhhealth-monitoring
  labels:
    app.kubernetes.io/name: grafana
    app.kubernetes.io/component: admin-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    admin-user: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    admin-password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: grafana-admin-credentials
      namespace: vhhealth-monitoring
    type: Opaque

# C1.3 Alertmanager configuration template.
#
# This file is not a live receiver configuration. Infrastructure owners must
# replace every OWNER_INPUT value, validate the result with amtool, then seal
# the complete file as the `alertmanager.yaml` key in Secret
# `vhhealth-monitoring/alertmanager-secrets`.
global:
  resolve_timeout: 5m
  smtp_smarthost: smtp.example.invalid:587
  smtp_from: alertmanager@example.invalid
  smtp_auth_username: OWNER_INPUT_SMTP_USERNAME
  smtp_auth_password_file: /etc/alertmanager/secrets/alertmanager-secrets/smtp-password
  smtp_require_tls: true

route:
  receiver: unmatched-alerts
  group_by: [team, alertname, cluster, namespace, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    - receiver: deadman-external
      matchers:
        - alertname = "Watchdog"
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 5m
    - receiver: ops-webhook
      matchers:
        - severity =~ "critical|warning"
      repeat_interval: 4h
      continue: true
    - receiver: critical-pagerduty
      matchers:
        - severity = "critical"
      repeat_interval: 4h
      continue: true
    - receiver: team-platform
      matchers:
        - team = "platform"
    - receiver: team-database
      matchers:
        - team = "database"
    - receiver: team-backup
      matchers:
        - team = "backup"
    - receiver: team-backend
      matchers:
        - team = "backend"
    - receiver: team-continuity
      matchers:
        - team = "continuity"
    - receiver: team-device
      matchers:
        - team = "device"

receivers:
  - name: ops-webhook
    webhook_configs:
      - url_file: /etc/alertmanager/secrets/alertmanager-secrets/discord-webhook-url
        send_resolved: true
        http_config:
          follow_redirects: true
  - name: deadman-external
    webhook_configs:
      - url_file: /etc/alertmanager/secrets/alertmanager-secrets/discord-watchdog-url
        send_resolved: false
        http_config:
          follow_redirects: true
  - name: critical-pagerduty
    pagerduty_configs:
      - routing_key_file: /etc/alertmanager/secrets/alertmanager-secrets/pagerduty-routing-key
        send_resolved: true
  - name: team-platform
    slack_configs:
      - api_url_file: /etc/alertmanager/secrets/alertmanager-secrets/slack-api-url
        channel: "#OWNER_INPUT_PLATFORM_ONCALL"
        send_resolved: true
    email_configs:
      - to: owner-input-platform@example.invalid
        send_resolved: true
  - name: team-database
    slack_configs:
      - api_url_file: /etc/alertmanager/secrets/alertmanager-secrets/slack-api-url
        channel: "#OWNER_INPUT_DATABASE_ONCALL"
        send_resolved: true
    email_configs:
      - to: owner-input-database@example.invalid
        send_resolved: true
  - name: team-backup
    slack_configs:
      - api_url_file: /etc/alertmanager/secrets/alertmanager-secrets/slack-api-url
        channel: "#OWNER_INPUT_BACKUP_ONCALL"
        send_resolved: true
    email_configs:
      - to: owner-input-backup@example.invalid
        send_resolved: true
  - name: team-backend
    slack_configs:
      - api_url_file: /etc/alertmanager/secrets/alertmanager-secrets/slack-api-url
        channel: "#OWNER_INPUT_BACKEND_ONCALL"
        send_resolved: true
    email_configs:
      - to: owner-input-backend@example.invalid
        send_resolved: true
  - name: team-continuity
    slack_configs:
      - api_url_file: /etc/alertmanager/secrets/alertmanager-secrets/slack-api-url
        channel: "#OWNER_INPUT_CONTINUITY_ONCALL"
        send_resolved: true
    email_configs:
      - to: owner-input-continuity@example.invalid
        send_resolved: true
  - name: team-device
    slack_configs:
      - api_url_file: /etc/alertmanager/secrets/alertmanager-secrets/slack-api-url
        channel: "#OWNER_INPUT_DEVICE_ONCALL"
        send_resolved: true
    email_configs:
      - to: owner-input-device@example.invalid
        send_resolved: true
  - name: unmatched-alerts
    slack_configs:
      - api_url_file: /etc/alertmanager/secrets/alertmanager-secrets/slack-api-url
        channel: "#OWNER_INPUT_UNMATCHED_ALERTS"
        send_resolved: true
    email_configs:
      - to: owner-input-unmatched-alerts@example.invalid
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: [alertname, team, cluster, namespace]

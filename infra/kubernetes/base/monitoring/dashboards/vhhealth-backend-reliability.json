{
  "uid": "vhhealth-backend-reliability",
  "title": "VH Health — Backend Reliability",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["vhhealth", "backend"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "event_outbox pending",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "max(event_outbox_pending_rows)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "event_outbox oldest pending age (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "max(event_outbox_oldest_pending_age_seconds)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "event_outbox dead-letter rows",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "max(event_outbox_dead_letter_rows)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "webhook_deliveries dead rows",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "max(webhook_deliveries_dead_rows)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "WS broadcast drops/s by reason",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (reason)(rate(ws_broadcast_dropped_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB circuit breaker open",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "max(db_circuit_breaker_open)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Clinical-AI template fallback/s by module",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (module)(rate(clinical_ai_deep_template_fallback_total[15m]))",
          "legendFormat": "{{module}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "webhook_deliveries backlog (pending/failed)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "max(webhook_deliveries_pending_rows)",
          "legendFormat": "pending"
        },
        {
          "expr": "max(webhook_deliveries_failed_rows)",
          "legendFormat": "failed (retrying)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "DB read-replica lag (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "max(db_read_replica_lag_seconds)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "event_outbox leases (processing/stale)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "max(event_outbox_processing_rows)",
          "legendFormat": "processing"
        },
        {
          "expr": "max(event_outbox_stale_processing_rows)",
          "legendFormat": "stale"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "webhook leases (in-flight/stale)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "max(webhook_deliveries_in_flight_rows)",
          "legendFormat": "in-flight"
        },
        {
          "expr": "max(webhook_deliveries_stale_in_flight_rows)",
          "legendFormat": "stale"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "webhook deliveries parked by gates",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "expr": "max(webhook_deliveries_parked_rows)"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "outbox stale leases reaped",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        {
          "expr": "sum(rate(event_outbox_stale_lease_reaped_total[15m]))",
          "legendFormat": "source"
        },
        {
          "expr": "sum(rate(webhook_deliveries_stale_lease_reaped_total[15m]))",
          "legendFormat": "webhook"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "audited operator redrives",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        {
          "expr": "sum by (queue)(increase(outbox_operator_redrive_total[1h]))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "notification_outbox terminal and uncertain rows",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "max(notification_outbox_dead_letter_rows)",
          "legendFormat": "dead letter"
        },
        {
          "expr": "max(notification_outbox_reconciliation_required_rows)",
          "legendFormat": "reconciliation required"
        },
        {
          "expr": "max(notification_outbox_terminal_dead_letter_rows)",
          "legendFormat": "terminal (operator-only)"
        },
        {
          "expr": "max(notification_outbox_suppressed_rows)",
          "legendFormat": "suppressed (never-send by design)"
        },
        {
          "expr": "sum by (outcome) (increase(notification_outbox_auto_replay_total[1h]))",
          "legendFormat": "auto-replay {{outcome}} (1h)"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "notification delivery paused cursors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        {
          "expr": "max by (state) (notification_delivery_paused_cursors)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "reliability collector age (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
      "targets": [
        {
          "expr": "max(time() - reliability_metrics_last_success_timestamp_seconds)"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "notification_outbox backlog (pending/failed)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 64 },
      "targets": [
        {
          "expr": "max(notification_outbox_pending_rows)",
          "legendFormat": "pending"
        },
        {
          "expr": "max(notification_outbox_failed_rows)",
          "legendFormat": "failed"
        }
      ]
    }
  ]
}

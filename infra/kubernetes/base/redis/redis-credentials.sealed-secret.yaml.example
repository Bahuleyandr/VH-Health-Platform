# redis/redis-credentials.sealed-secret.yaml.example — Redis password
#
# Create the real SealedSecret via:
#
#   kubectl create secret generic redis-credentials \
#     --namespace vhhealth-platform \
#     --from-literal=password="$(openssl rand -hex 32)" \
#     --dry-run=client -o yaml \
#   | kubeseal --controller-namespace vhhealth-security \
#              --controller-name sealed-secrets \
#              --format yaml \
#   > infra/kubernetes/base/redis/redis-credentials.sealed-secret.yaml
#
# The `password` key is consumed by:
#   - redis-server (via $REDIS_PASSWORD env in the init container)
#   - redis-sentinel (auth-pass on the monitored primary)
#   - redis-exporter (via --redis.password-file)
#   - backend Deployment (REDIS_PASSWORD env from same secret; the
#     backend's manifest in infra/kubernetes/apps/backend references it)
#
# Rotation: changing the password requires (a) resealing this file with
# the new value, (b) `kubectl rollout restart statefulset/redis`, and
# (c) rolling the backend + admin Deployments so they pick up the new
# env. Downtime window ~45s; plan during a low-traffic slot.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: redis-credentials
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: redis
    app.kubernetes.io/instance: vhhealth-redis
    app.kubernetes.io/component: credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    password: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: redis-credentials
      namespace: vhhealth-platform
    type: Opaque

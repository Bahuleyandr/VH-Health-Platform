# redis/redis-credentials.sealed-secret.yaml.example — Redis data/control credentials
#
# Create the real SealedSecret via:
#
#   kubectl create secret generic redis-credentials \
#     --namespace vhhealth-platform \
#     --from-literal=redis-password="$(openssl rand -hex 32)" \
#     --from-literal=sentinel-password="$(openssl rand -hex 32)" \
#     --dry-run=client -o yaml \
#   | kubeseal --controller-namespace vhhealth-security \
#              --controller-name sealed-secrets \
#              --format yaml \
#   > infra/kubernetes/base/redis/redis-credentials.sealed-secret.yaml
#
# `redis-password` is consumed by:
#   - redis-server (ACL password/masterauth)
#   - redis-sentinel (auth-pass on the monitored primary)
#   - redis-exporter (via --redis.password-file)
# `sentinel-password` is consumed by the Sentinel ACL and discovery probes.
# Backend credentials are resealed separately in namespace `vhhealth` because a
# Kubernetes Secret cannot cross namespaces.
#
# Optional overlap keys `redis-password-previous` and
# `sentinel-password-previous` are accepted by the generated ACL files. Follow
# the three-phase procedure in docs/REDIS_SENTINEL_HA_RUNBOOK.md; never rotate
# both planes ad hoc. All values must be at least 32 hexadecimal characters.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: redis-credentials
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: redis
    app.kubernetes.io/instance: vhhealth-redis
    app.kubernetes.io/component: credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    redis-password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    sentinel-password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    # Add only during a reviewed rotation overlap, then remove in phase 3:
    # redis-password-previous: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    # sentinel-password-previous: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: redis-credentials
      namespace: vhhealth-platform
    type: Opaque

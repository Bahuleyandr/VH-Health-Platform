# PLACEHOLDER ONLY. Replace with real kubeseal output before applying.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: keycloak-admin
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: keycloak
    app.kubernetes.io/component: admin-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/deploy-state: "held"
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    admin-password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: keycloak-admin
      namespace: vhhealth-platform
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: keycloak-database
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: keycloak
    app.kubernetes.io/component: database-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/deploy-state: "held"
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: keycloak-database
      namespace: vhhealth-platform
    type: Opaque

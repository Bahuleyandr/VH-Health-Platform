# step-ca/step-ca-secrets.sealed-secret.yaml.example
#
# step-ca needs two Kubernetes secrets:
#   - `step-ca-config`: the entire `~/.step/config/` directory (ca.json,
#     provisioner configs, certificates). Bundled from an offline `step ca init`
#     run and re-sealed whenever a new provisioner is added.
#   - `step-ca-passwords`: the CA password file (`password`) that unlocks
#     the intermediate key. The root key is NEVER loaded at runtime — it
#     lives only in an offline HSM / USB drive kept at the hospital data
#     operator's desk.
#
# Sealing workflow (run offline on a hardened workstation):
#
#   step ca init ...                        # see step-ca.yaml header
#   tar czf /tmp/step-ca-config.tar.gz -C ~/.step config
#   kubectl create secret generic step-ca-config \
#     --namespace vhhealth-security \
#     --from-file=ca.json=$HOME/.step/config/ca.json \
#     --from-file=defaults.json=$HOME/.step/config/defaults.json \
#     --from-file=intermediate_ca.crt=$HOME/.step/certs/intermediate_ca.crt \
#     --from-file=intermediate_ca_key=$HOME/.step/secrets/intermediate_ca_key \
#     --from-file=root_ca.crt=$HOME/.step/certs/root_ca.crt \
#     --dry-run=client -o yaml \
#   | kubeseal --controller-namespace vhhealth-security --format yaml \
#   > infra/kubernetes/base/step-ca/step-ca-config.sealed-secret.yaml
#
#   kubectl create secret generic step-ca-passwords \
#     --namespace vhhealth-security \
#     --from-literal=password="<ca-password>" \
#     --dry-run=client -o yaml \
#   | kubeseal --controller-namespace vhhealth-security --format yaml \
#   > infra/kubernetes/base/step-ca/step-ca-passwords.sealed-secret.yaml
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: step-ca-config
  namespace: vhhealth-security
  labels:
    app.kubernetes.io/name: step-ca
    app.kubernetes.io/component: ca-config
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    ca.json: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    defaults.json: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    intermediate_ca.crt: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    intermediate_ca_key: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    root_ca.crt: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: step-ca-config
      namespace: vhhealth-security
    type: Opaque
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: step-ca-passwords
  namespace: vhhealth-security
  labels:
    app.kubernetes.io/name: step-ca
    app.kubernetes.io/component: ca-password
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    password: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: step-ca-passwords
      namespace: vhhealth-security
    type: Opaque

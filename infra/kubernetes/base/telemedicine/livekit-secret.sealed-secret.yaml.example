# =============================================================================
# THIS IS A PLACEHOLDER.
#
# Real LiveKit secrets must be created by ops and sealed for the target cluster:
#
#   kubectl -n vhhealth-telemedicine create secret generic livekit-secret \
#     --from-literal=LIVEKIT_KEYS="<api-key>: <api-secret>" \
#     --from-literal=LIVEKIT_REDIS_PASSWORD="<redis-password>" \
#     --from-file=turn-tls.crt=/secure/path/turn.teleconsult.vhhealth.app.crt \
#     --from-file=turn-tls.key=/secure/path/turn.teleconsult.vhhealth.app.key \
#     --dry-run=client -o yaml > /tmp/livekit-secret.yaml
#
#   kubeseal -f /tmp/livekit-secret.yaml \
#     --controller-namespace=sealed-secrets \
#     --controller-name=sealed-secrets-controller \
#     --scope=strict \
#     -w infra/kubernetes/base/telemedicine/livekit-secret.sealed-secret.yaml
#
# Commit only the real SealedSecret, never plaintext. The backend runtime must
# receive matching LIVEKIT_SERVER_URL, LIVEKIT_API_KEY, and LIVEKIT_API_SECRET
# separately through the backend env secret before LIVEKIT_ENABLED=true.
# =============================================================================
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: livekit-secret
  namespace: vhhealth-telemedicine
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
    vhhealth.app/placeholder: "true"
    vhhealth.app/deploy-state: held
  labels:
    app.kubernetes.io/name: livekit
    app.kubernetes.io/component: teleconsult-media
    app.kubernetes.io/part-of: vhhealth
spec:
  template:
    metadata:
      name: livekit-secret
      namespace: vhhealth-telemedicine
    type: Opaque
  encryptedData:
    LIVEKIT_KEYS: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    LIVEKIT_REDIS_PASSWORD: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    turn-tls.crt: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
    turn-tls.key: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT

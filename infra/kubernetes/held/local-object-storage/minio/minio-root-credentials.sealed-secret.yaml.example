# minio/minio-root-credentials.sealed-secret.yaml.example — MinIO tenant root user
#
# Create the real SealedSecret:
#
#   cat > /tmp/minio-root.yaml <<'EOF'
#   apiVersion: v1
#   kind: Secret
#   metadata:
#     name: minio-root-credentials
#     namespace: vhhealth-platform
#   type: Opaque
#   stringData:
#     config.env: |
#       export MINIO_ROOT_USER="admin"
#       export MINIO_ROOT_PASSWORD="<generate-with-openssl-rand-hex-32>"
#       export MINIO_IDENTITY_OPENID_CONFIG_URL=""
#       export MINIO_IDENTITY_OPENID_CLIENT_ID=""
#       export MINIO_IDENTITY_OPENID_CLIENT_SECRET=""
#   EOF
#
#   kubeseal --controller-namespace vhhealth-security \
#            --controller-name sealed-secrets --format yaml \
#     < /tmp/minio-root.yaml \
#     > infra/kubernetes/base/minio/minio-root-credentials.sealed-secret.yaml
#
# Why a `config.env` blob rather than plain keys: that's the format the
# MinIO Operator Tenant CRD 5.x expects (`configuration.name`). The
# operator sources it as env vars at startup.
#
# The admin identity should be replaced by a short-lived STS token issued
# by Vault's MinIO secrets engine once we wire it up. Until then, the
# root user's password rotates manually every 90 days (runbook).
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: minio-root-credentials
  namespace: vhhealth-platform
  labels:
    app.kubernetes.io/name: minio
    app.kubernetes.io/instance: vhhealth-minio
    app.kubernetes.io/component: root-credentials
    app.kubernetes.io/part-of: vhhealth
    app.kubernetes.io/managed-by: kustomize
  annotations:
    vhhealth.app/placeholder: "true"
spec:
  encryptedData:
    config.env: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: minio-root-credentials
      namespace: vhhealth-platform
    type: Opaque

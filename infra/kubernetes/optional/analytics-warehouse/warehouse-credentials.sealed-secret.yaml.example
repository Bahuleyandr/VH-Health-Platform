# Three secrets to seal before enabling the module (kubeseal, same flow as
# base/cnpg/backup-credentials.sealed-secret.yaml.example):
#
#   vh-warehouse-repl-credentials  — password for the vh_warehouse_repl role
#                                    (publisher-setup-job + subscribe-job).
#   vh-dbt-credentials             — basic-auth (username MUST be vh_dbt);
#                                    consumed by the CNPG managed role AND
#                                    the dbt CronJob.
#   vh-metabase-credentials        — basic-auth (username MUST be
#                                    vh_metabase); point Metabase at
#                                    vhhealth-warehouse-rw:5432/vhhealth.
#
# Plaintext shapes (seal these; never commit unsealed):
---
apiVersion: v1
kind: Secret
metadata:
  name: vh-warehouse-repl-credentials
  namespace: vhhealth-platform
type: Opaque
stringData:
  password: "CHANGE-ME-long-random"
---
apiVersion: v1
kind: Secret
metadata:
  name: vh-dbt-credentials
  namespace: vhhealth-platform
  labels:
    cnpg.io/reload: "true"
type: kubernetes.io/basic-auth
stringData:
  username: "vh_dbt"
  password: "CHANGE-ME-long-random"
---
apiVersion: v1
kind: Secret
metadata:
  name: vh-metabase-credentials
  namespace: vhhealth-platform
  labels:
    cnpg.io/reload: "true"
type: kubernetes.io/basic-auth
stringData:
  username: "vh_metabase"
  password: "CHANGE-ME-long-random"

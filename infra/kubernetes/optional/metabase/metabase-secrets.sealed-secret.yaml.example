# Secrets to seal before enabling this optional module.
#
# This file shows plaintext shapes only. Seal with kubeseal, commit the sealed
# output, and add the sealed files to kustomization.yaml resources at enable
# time. Never commit unsealed secret values.
#
# The warehouse module owns vh-metabase-credentials (username vh_metabase);
# this module owns only Metabase application metadata and encryption secrets.
---
apiVersion: v1
kind: Secret
metadata:
  name: vh-metabase-app-db-credentials
  namespace: vhhealth-platform
  labels:
    cnpg.io/reload: "true"
type: kubernetes.io/basic-auth
stringData:
  username: "metabase_app"
  password: "CHANGE-ME-long-random"
---
apiVersion: v1
kind: Secret
metadata:
  name: vh-metabase-app-secrets
  namespace: vhhealth-platform
type: Opaque
stringData:
  encryption-secret-key: "CHANGE-ME-at-least-32-random-chars"

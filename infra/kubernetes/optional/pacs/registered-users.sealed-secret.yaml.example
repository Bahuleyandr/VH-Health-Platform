# pacs/registered-users.sealed-secret.yaml.example — Orthanc credentials
#
# Audit finding M18 (2026-06-10): RegisteredUsers previously shipped as a
# literal `"vhhealth": "CHANGE-ME-sealed-secret"` inside the orthanc-config
# ConfigMap. Credentials now come from the `orthanc-users` Secret via
# ORTHANC__REGISTERED_USERS (Orthanc env-var config overrides orthanc.json).
#
# Create the real SealedSecret:
#
#   1. Plaintext Secret locally (DO NOT COMMIT):
#        PW="$(openssl rand -base64 24)"
#        cat > /tmp/orthanc-users.yaml <<EOF
#        apiVersion: v1
#        kind: Secret
#        metadata:
#          name: orthanc-users
#          namespace: <pacs namespace>
#        type: Opaque
#        stringData:
#          registered_users_json: '{"vhhealth": "$PW"}'
#        EOF
#
#   2. Seal it:
#        kubeseal --controller-namespace vhhealth-security \
#                 --controller-name sealed-secrets \
#                 --format yaml \
#                 < /tmp/orthanc-users.yaml \
#                 > infra/kubernetes/optional/pacs/registered-users.sealed-secret.yaml
#
#   3. Commit the *sealed* file, delete the plaintext, and hand the password
#      to the OHIF/backend DICOMweb config via its own SealedSecret.
#
# Below is an illustrative (NON-FUNCTIONAL placeholder) SealedSecret so a
# dry-run `kustomize build` succeeds before the real secret is sealed.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: orthanc-users
  labels:
    app.kubernetes.io/name: orthanc
    app.kubernetes.io/part-of: vhhealth-pacs
  annotations:
    vhhealth.app/placeholder: "true"
    vhhealth.app/description: "Replace with output of kubeseal before enabling PACS."
spec:
  encryptedData:
    registered_users_json: PLACEHOLDER_REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: orthanc-users
    type: Opaque

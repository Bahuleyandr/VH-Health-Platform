[Unit]
Description=Weekly VH Health DB checks (Mon 09:00 IST)
Documentation=https://github.com/Bahuleyandr/VH-Health-Platform/tree/main/infra/onprem/vh-checks

[Timer]
# Mon 09:00 in the host's local time zone. dalekdefender's TZ is IST
# (Asia/Kolkata) per its `timedatectl` output. If the TZ ever changes,
# add `OnCalendar=Mon 03:30:00 UTC` instead so the schedule is anchored.
OnCalendar=Mon 09:00:00
Persistent=true
Unit=vh-checks.service

[Install]
WantedBy=timers.target

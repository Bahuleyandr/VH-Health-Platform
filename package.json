{
  "type": "module",
  "name": "vh-health-backend",
  "version": "1.0.0",
  "description": "VH Health API for managing patients, appointments, records, investigations, pharmacy orders, and feedback.",
  "main": "src/bin/www.js",
  "scripts": {
    "start": "node -r source-map-support/register dist/app.js",
    "dev": "nodemon --exec \"npx babel-node\" src/app.js",
    "build": "npx babel src -d dist --source-maps",
    "build:dev": "NODE_ENV=development npx babel src -d dist --source-maps inline",
    "build:prod": "cross-env NODE_ENV=production npx --no-install babel src -d dist --source-maps --config-file ./babel.config.js",
    "build:sentry": "node src/scripts/build-production.js",
    "start:built": "node -r source-map-support/register dist/app.js",
    "debug": "node --inspect -r source-map-support/register src/app.js",
    "debug:built": "node --inspect -r source-map-support/register dist/app.js",
    "clean": "rimraf dist",
    "debug:babel": "node debug-babel.js",
    "prebuild": "npm run clean",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "dotenv -e .env.local -- node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "start:local": "dotenv -e .env.local -- node src/bin/www.js",
    "start:render": "node src/bin/www.js",
    "r2:migrate-archive": "node src/scripts/r2/r2-migrate-archive.js",
    "r2:cleanup-old": "node src/scripts/r2/r2-cleanup-old.js",
    "r2:list-files": "node src/scripts/r2/r2-list-files.js",
    "db:backup": "node src/scripts/backup-db.js",
    "db:restore": "node src/scripts/restore-db.js",
    "swagger:validate": "node src/scripts/validate-swagger.js",
    "swagger:generate": "node src/scripts/yaml-to-json-swagger.js",
    "swagger:generate-complete": "node src/scripts/generate-complete-swagger.js",
    "logs:cleanup": "node src/scripts/cleanup-logs.js",
    "logs:list": "node src/scripts/list-logs.js",
    "logs:purge": "node src/scripts/purge-logs.js",
    "fix:permissions": "node src/scripts/fix-permissions.js",
    "scheduler:run-now": "node -e \"import('./src/utils/scheduler.js').then(m => m.runAllScheduledTasksNow())\"",
    "generate-admin-token": "node src/scripts/development/generateAdminToken.js",
    "convert-to-relative": "node src/scripts/development/convert-aliases-to-relative.js",
    "convert-to-aliases": "node src/scripts/development/convert-relative-to-aliases.js",
    "dev:setup": "npm run generate-admin-token && echo 'Development environment ready'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/vh-health-backend.git"
  },
  "author": "VH Health Tech Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "@aws-sdk/s3-request-presigner": "^3.844.0",
    "@aws-sdk/util-create-request": "^3.844.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-env": "^7.28.0",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.1",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@prisma/client": "^6.11.1",
    "@sentry/node": "^9.39.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "clamav.js": "^0.12.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-list-endpoints": "^7.1.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.3",
    "sharp": "^0.34.3",
    "source-map-support": "^0.5.21",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@sentry/cli": "^2.47.1",
    "@stoplight/spectral-cli": "^6.15.0",
    "@stoplight/spectral-core": "^1.20.0",
    "@stoplight/spectral-rulesets": "^1.22.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-sonarjs": "^3.0.4",
    "jest": "^30.0.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.11.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.3"
  },
  "engines": {
    "node": "22.15.0"
  },
  "keywords": [
    "vh-health",
    "healthcare-api",
    "nodejs",
    "express",
    "postgresql",
    "swagger",
    "winston",
    "api"
  ],
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/src/scripts/testing/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@controllers/(.*)$": "<rootDir>/src/controllers/$1",
      "^@routes/(.*)$": "<rootDir>/src/routes/$1",
      "^@middleware/(.*)$": "<rootDir>/src/middleware/$1",
      "^@logging/(.*)$": "<rootDir>/src/logging/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@scripts/(.*)$": "<rootDir>/src/scripts/$1"
    }
  }
}

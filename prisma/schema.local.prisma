generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_LOCAL")
}

model appointments {
  id          Int       @id @default(autoincrement())
  phone       String    @db.VarChar(15)
  doctor_name String    @db.VarChar(100)
  date        DateTime  @db.Date
  time        String    @db.VarChar(10)
  status      String?   @default("pending") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model consultations {
  id         Int       @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  file_name  String    @db.VarChar(255)
  file_type  String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model departments {
  id      Int       @id @default(autoincrement())
  name    String    @unique @db.VarChar(100)
  doctors doctors[]
}

model doctors {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(100)
  department    String       @db.VarChar(100)
  intro         String?
  image_url     String?
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  department_id Int?
  specialty     String?
  departments   departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_doctors_department_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model feedback {
  id          Int       @id @default(autoincrement())
  phonenumber String    @db.VarChar(15)
  rating      Int
  comment     String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model file_metadata {
  id          Int       @id @default(autoincrement())
  file_name   String
  file_type   String
  storage_key String    @unique
  storage_url String
  file_size   BigInt
  uploaded_by String?
  uploaded_at DateTime? @default(now()) @db.Timestamp(6)
}

model health_records {
  id         Int       @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  file_name  String    @db.VarChar(255)
  file_type  String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model investigations {
  id           Int       @id @default(autoincrement())
  phone        String    @db.VarChar(15)
  test_name    String    @db.VarChar(255)
  status       String?   @default("requested") @db.VarChar(50)
  requested_at DateTime? @default(now()) @db.Timestamp(6)
  result_file  String?
}

model pharmacy_orders {
  id         Int       @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  order_note String
  status     String?   @default("requested") @db.VarChar(50)
  ordered_at DateTime? @default(now()) @db.Timestamp(6)
}

model sos_alerts {
  id         Int       @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  latitude   String    @db.VarChar(50)
  longitude  String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model users {
  id              Int       @id @default(autoincrement())
  phone           String    @unique @db.VarChar(15)
  registered_at   DateTime? @default(now()) @db.Timestamp(6)
  name            String?
  gender          String?
  address         String?
  email           String?
  birthday        DateTime? @db.Date
  anniversary     DateTime? @db.Date
  profile_picture String?
  uid             String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}

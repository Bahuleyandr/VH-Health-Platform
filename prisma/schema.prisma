model infection_cases {
  id                  Int       @id @default(autoincrement())
  patient_uid         String    @db.Uuid
  encounter_id        String?   @db.Uuid
  organism            String    @db.VarChar(255)
  infection_site      String    @db.VarChar(100) // surgical_site, bloodstream, urinary, respiratory, wound, other

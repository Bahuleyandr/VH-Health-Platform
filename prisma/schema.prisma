// ===================================================================
// 🛡️ QUALITY & INFECTION CONTROL
// ===================================================================

model quality_incidents {
  id                  Int       @id @default(autoincrement())
  incident_number     String    @unique @db.VarChar(50)
  reported_by         String    @db.Uuid
  patient_uid         String?   @db.Uuid
  incident_type       String    @db.VarChar(50) // fall, medication_error, infection, equipment_failure, near_miss, complaint, other
  severity            String    @db.VarChar(20) // minor, moderate, major, sentinel
  description         String    @db.Text
  location            String?   @db.VarChar(100)
  date_occurred       DateTime  @db.Timestamp(6)
  root_cause          String?   @db.Text
  corrective_action   String?   @db.Text
  preventive_action   String?   @db.Text
  status              String    @default("reported") @db.VarChar(30) // reported, investigating, action_taken, resolved, closed
  investigated_by     String?   @db.Uuid
  resolved_at         DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)

  @@index([status])
  @@index([incident_type])
  @@index([severity])

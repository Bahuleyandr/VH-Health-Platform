// Schema mirrors actual PostgreSQL tables. Raw pg is used for all queries. This schema is for documentation and potential future Prisma migration.
// Unified Hospital-Grade Database Schema for VH Health Backend
// Compatible with both local and production environments

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================================================
// 👥 USER MANAGEMENT
// ===================================================================

model users {
  id              Int       @id @default(autoincrement())
  uid             String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone           String    @unique @db.VarChar(15)
  name            String?   @db.VarChar(255)
  gender          String?   @db.VarChar(20)
  address         String?   @db.Text
  email           String?   @db.VarChar(255)
  birthday        DateTime? @db.Date
  anniversary     DateTime? @db.Date
  profile_picture String?   @db.Text
  role            String?   @default("PATIENT") @db.VarChar(50)
  is_active       Boolean   @default(true)
  registered_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([role])
  @@map("users")
}

model user_devices {
  id          Int       @id @default(autoincrement())
  user_uid    String    @db.Uuid
  device_id   String    @db.VarChar(255)
  device_name String?   @db.VarChar(255)
  platform    String?   @db.VarChar(50)
  app_version String?   @db.VarChar(50)
  os_version  String?   @db.VarChar(50)
  fcm_token   String?   @db.Text
  last_active DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  @@unique([user_uid, device_id])
  @@index([user_uid])
  @@map("user_devices")
}

model user_sessions {
  id          Int       @id @default(autoincrement())
  user_id     String?   @db.Uuid
  device_type String?   @db.VarChar(50)
  platform    String?   @db.VarChar(50)
  expires_at  DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  @@index([user_id])
  @@index([expires_at])
  @@map("user_sessions")
}

model user_status_history {
  id              Int       @id @default(autoincrement())
  user_id         String    @db.Uuid
  previous_status String?   @db.VarChar(50)
  new_status      String    @db.VarChar(50)
  changed_by      String?   @db.Uuid
  change_reason   String?   @db.Text
  changed_at      DateTime  @default(now()) @db.Timestamp(6)
  ip_address      String?   @db.VarChar(45)

  @@index([user_id])
  @@map("user_status_history")
}

model user_deactivation_log {
  id                  Int       @id @default(autoincrement())
  user_id             String    @db.Uuid
  deactivated_by      String?   @db.Uuid
  deactivation_reason String?   @db.Text
  data_transferred_to String?   @db.Uuid
  deactivated_at      DateTime  @default(now()) @db.Timestamp(6)
  ip_address          String?   @db.VarChar(45)
  user_data           Json?     @db.JsonB

  @@index([user_id])
  @@map("user_deactivation_log")
}

model user_reactivation_log {
  id                  Int       @id @default(autoincrement())
  user_id             String    @db.Uuid
  reactivated_by      String?   @db.Uuid
  reactivation_reason String?   @db.Text
  reactivated_at      DateTime  @default(now()) @db.Timestamp(6)
  ip_address          String?   @db.VarChar(45)

  @@index([user_id])
  @@map("user_reactivation_log")
}

model user_role_audit {
  id             Int       @id @default(autoincrement())
  phone          String    @db.VarChar(15)
  old_role       String?   @db.VarChar(50)
  new_role       String?   @db.VarChar(50)
  changed_by_uid String?   @db.Uuid
  reason         String?   @db.Text
  action_type    String?   @db.VarChar(50)
  changed_at     DateTime  @default(now()) @db.Timestamp(6)

  @@index([phone])
  @@map("user_role_audit")
}

model user_action_logs {
  id             Int       @id @default(autoincrement())
  user_id        String?   @db.Uuid
  action         String    @db.VarChar(100)
  target_user_id String?   @db.Uuid
  details        Json?     @db.JsonB
  ip_address     String?   @db.VarChar(45)
  created_at     DateTime  @default(now()) @db.Timestamp(6)

  @@index([user_id])
  @@index([created_at])
  @@map("user_action_logs")
}

model bulk_operation_logs {
  id                Int       @id @default(autoincrement())
  operation_type    String    @db.VarChar(100)
  performed_by      String?   @db.Uuid
  total_items       Int?
  affected_count    Int?
  success_count     Int?
  error_count       Int?
  operation_details Json?     @db.JsonB
  performed_at      DateTime  @default(now()) @db.Timestamp(6)

  @@index([operation_type])
  @@map("bulk_operation_logs")
}

// ===================================================================
// 🔐 AUTHENTICATION & SESSIONS
// ===================================================================

model admins {
  uid                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username             String    @unique @db.VarChar(255)
  password_hash        String    @db.VarChar(255)
  email                String?   @db.VarChar(255)
  name                 String?   @db.VarChar(255)
  role                 String?   @default("ADMIN") @db.VarChar(50)
  permissions          String[]
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  last_login           DateTime? @db.Timestamp(6)
  created_by           String?   @db.Uuid
  deactivated_by       String?   @db.Uuid
  deactivation_reason  String?   @db.Text
  deactivated_at       DateTime? @db.Timestamp(6)
  reactivated_by       String?   @db.Uuid
  reactivated_at       DateTime? @db.Timestamp(6)

  @@index([username])
  @@map("admins")
}

model otp_sessions {
  id         Int       @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  otp        String    @db.VarChar(10)
  purpose    String    @db.VarChar(50)
  user_id    Int?
  expires_at DateTime  @db.Timestamp(6)
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@index([phone])
  @@index([expires_at])
  @@map("otp_sessions")
}

model otp_logs {
  id             Int       @id @default(autoincrement())
  phone          String    @db.VarChar(15)
  purpose        String    @db.VarChar(50)
  action         String    @db.VarChar(50)
  success        Boolean
  failure_reason String?   @db.Text
  ip_address     String?   @db.VarChar(45)
  user_agent     String?   @db.Text
  created_by     String?   @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamp(6)

  @@index([phone])
  @@index([created_at])
  @@map("otp_logs")
}

model password_reset_otps {
  id         Int       @id @default(autoincrement())
  user_id    String    @db.Uuid
  otp        String    @db.VarChar(10)
  expires_at DateTime  @db.Timestamp(6)
  used       Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_otps")
}

model auth_logs {
  id             Int       @id @default(autoincrement())
  phone          String?   @db.VarChar(15)
  user_id        String?   @db.Uuid
  action         String    @db.VarChar(100)
  success        Boolean
  failure_reason String?   @db.Text
  auth_method    String?   @db.VarChar(50)
  ip_address     String?   @db.VarChar(45)
  user_agent     String?   @db.Text
  created_at     DateTime  @default(now()) @db.Timestamp(6)

  @@index([phone])
  @@index([user_id])
  @@index([created_at])
  @@map("auth_logs")
}

// ===================================================================
// 🏥 HOSPITAL STRUCTURE
// ===================================================================

model departments {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @updatedAt @db.Timestamp(6)

  @@map("departments")
}

model department_audit_log {
  id            Int       @id @default(autoincrement())
  department_id Int?
  user_id       String?   @db.Uuid
  action        String    @db.VarChar(100)
  old_data      Json?     @db.JsonB
  new_data      Json?     @db.JsonB
  created_at    DateTime  @default(now()) @db.Timestamp(6)

  @@index([department_id])
  @@index([created_at])
  @@map("department_audit_log")
}

model doctors {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  name          String    @db.VarChar(100)
  department_id Int?
  department    String    @db.VarChar(100)
  specialty     String?   @db.VarChar(100)
  intro         String?   @db.Text
  image_url     String?   @db.Text
  is_available  Boolean   @default(true)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @updatedAt @db.Timestamp(6)

  @@index([department_id])
  @@index([is_available])
  @@map("doctors")
}

model patient_feedback {
  id          Int       @id @default(autoincrement())
  doctor_id   Int?
  rating      Float?
  review_text String?   @db.Text
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  @@index([doctor_id])
  @@map("patient_feedback")
}

// ===================================================================
// 📅 APPOINTMENTS & SCHEDULING
// ===================================================================

model appointments {
  id               Int       @id @default(autoincrement())
  uid              String?   @db.Uuid
  phone            String    @db.VarChar(15)
  doctor_id        Int?
  doctor_name      String    @db.VarChar(100)
  patient_name     String?   @db.VarChar(255)
  appointment_date DateTime  @db.Date
  appointment_time String    @db.VarChar(10)
  status           String    @default("SCHEDULED") @db.VarChar(50)
  reason           String?   @db.Text
  notes            String?   @db.Text
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([doctor_id])
  @@index([appointment_date])
  @@index([status])
  @@map("appointments")
}

// ===================================================================
// 🏥 MEDICAL RECORDS
// ===================================================================

model health_records {
  id            Int       @id @default(autoincrement())
  uid           String?   @db.Uuid
  phone         String    @db.VarChar(15)
  record_type   String?   @default("GENERAL") @db.VarChar(50)
  file_name     String    @db.VarChar(255)
  file_type     String    @db.VarChar(50)
  file_key      String?   @db.Text
  file_size     BigInt?
  privacy_level String    @default("RESTRICTED") @db.VarChar(20)
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([record_type])
  @@index([privacy_level])
  @@map("health_records")
}

model medical_records {
  id            Int       @id @default(autoincrement())
  patient_id    String?   @db.Uuid
  doctor_id     Int?
  record_type   String?   @db.VarChar(50)
  title         String?   @db.VarChar(255)
  description   String?   @db.Text
  diagnosis     String?   @db.Text
  treatment     String?   @db.Text
  medications   Json?     @db.JsonB
  lab_results   Json?     @db.JsonB
  attachments   Json?     @db.JsonB
  privacy_level String?   @default("RESTRICTED") @db.VarChar(20)
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamp(6)

  @@index([patient_id])
  @@index([doctor_id])
  @@map("medical_records")
}

model investigations {
  id           Int       @id @default(autoincrement())
  uid          String?   @db.Uuid
  phone        String    @db.VarChar(15)
  test_name    String    @db.VarChar(255)
  test_type    String?   @db.VarChar(100)
  status       String    @default("REQUESTED") @db.VarChar(50)
  result_file  String?   @db.Text
  file_key     String?   @db.Text
  priority     String?   @default("NORMAL") @db.VarChar(20)
  requested_by String?   @db.Uuid
  requested_at DateTime  @default(now()) @db.Timestamp(6)
  completed_at DateTime? @db.Timestamp(6)
  updated_at   DateTime  @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([status])
  @@index([test_type])
  @@index([priority])
  @@map("investigations")
}

model investigation_files {
  id               Int       @id @default(autoincrement())
  investigation_id Int?
  file_name        String    @db.VarChar(255)
  file_path        String?   @db.Text
  file_type        String?   @db.VarChar(50)
  file_size        BigInt?
  uploaded_by      String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamp(6)

  @@index([investigation_id])
  @@map("investigation_files")
}

model investigation_templates {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  type          String?   @db.VarChar(100)
  description   String?   @db.Text
  department_id Int?
  created_by    String?   @db.Uuid
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @updatedAt @db.Timestamp(6)

  @@index([department_id])
  @@map("investigation_templates")
}

model investigation_template_tests {
  id           Int       @id @default(autoincrement())
  template_id  Int?
  test_name    String    @db.VarChar(255)
  test_code    String?   @db.VarChar(50)
  normal_range String?   @db.VarChar(100)
  unit         String?   @db.VarChar(50)
  cost         Float?

  @@index([template_id])
  @@map("investigation_template_tests")
}

model consultations {
  id                 Int       @id @default(autoincrement())
  uid                String?   @db.Uuid
  phone              String    @db.VarChar(15)
  doctor_id          Int?
  consultation_notes String?   @db.Text
  diagnosis          String?   @db.Text
  treatment_plan     String?   @db.Text
  file_name          String?   @db.VarChar(255)
  file_type          String?   @db.VarChar(50)
  file_key           String?   @db.Text
  consulted_at       DateTime  @default(now()) @db.Timestamp(6)
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([consulted_at])
  @@map("consultations")
}

// ===================================================================
// 💊 PHARMACY MANAGEMENT
// ===================================================================

model pharmacy_orders {
  id            Int       @id @default(autoincrement())
  uid           String?   @db.Uuid
  phone         String    @db.VarChar(15)
  order_note    String    @db.Text
  medication    String?   @db.Text
  status        String    @default("PENDING") @db.VarChar(50)
  priority      String?   @default("NORMAL") @db.VarChar(20)
  file_key      String?   @db.Text
  prescribed_by String?   @db.Uuid
  dispensed_by  String?   @db.Uuid
  ordered_at    DateTime  @default(now()) @db.Timestamp(6)
  dispensed_at  DateTime? @db.Timestamp(6)
  updated_at    DateTime  @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([status])
  @@index([ordered_at])
  @@map("pharmacy_orders")
}

model medications {
  id                    Int       @id @default(autoincrement())
  name                  String    @db.VarChar(255)
  generic_name          String?   @db.VarChar(255)
  brand                 String?   @db.VarChar(100)
  category              String?   @db.VarChar(100)
  dosage                String?   @db.VarChar(100)
  form                  String?   @db.VarChar(50)
  price                 Float?
  stock_quantity        Int?
  expiry_date           DateTime? @db.Date
  manufacturer          String?   @db.VarChar(255)
  prescription_required Boolean   @default(false)
  description           String?   @db.Text
  is_active             Boolean   @default(true)
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  created_by            String?   @db.Uuid

  @@index([name])
  @@index([category])
  @@map("medications")
}

// ===================================================================
// 💬 FEEDBACK & COMMUNICATION
// ===================================================================

model feedback {
  id             Int       @id @default(autoincrement())
  uid            String?   @db.Uuid
  phone          String    @db.VarChar(15)
  rating         Int       @db.SmallInt
  comment        String?   @db.Text
  category       String?   @default("GENERAL") @db.VarChar(50)
  department_id  Int?
  doctor_id      Int?
  appointment_id Int?
  is_anonymous   Boolean   @default(false)
  status         String    @default("PENDING") @db.VarChar(50)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([rating])
  @@index([category])
  @@index([status])
  @@map("feedback")
}

// ===================================================================
// 🆘 EMERGENCY RESPONSE
// ===================================================================

model sos_alerts {
  id             Int       @id @default(autoincrement())
  uid            String?   @db.Uuid
  phone          String    @db.VarChar(15)
  latitude       Float?    @db.DoublePrecision
  longitude      Float?    @db.DoublePrecision
  location_name  String?   @db.VarChar(255)
  alert_type     String?   @default("GENERAL") @db.VarChar(50)
  severity       String    @default("MEDIUM") @db.VarChar(20)
  message        String?   @db.Text
  status         String    @default("ACTIVE") @db.VarChar(50)
  responded_by   String?   @db.Uuid
  ip_address     String?   @db.VarChar(45)
  device_info    String?   @db.Text
  raised_at      DateTime  @default(now()) @db.Timestamp(6)
  responded_at   DateTime? @db.Timestamp(6)
  resolved_at    DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  @@index([phone])
  @@index([uid])
  @@index([alert_type])
  @@index([severity])
  @@index([status])
  @@index([raised_at])
  @@map("sos_alerts")
}

// ===================================================================
// 📁 FILE MANAGEMENT
// ===================================================================

model file_metadata {
  id            Int       @id @default(autoincrement())
  file_name     String    @db.VarChar(255)
  file_type     String    @db.VarChar(100)
  storage_key   String    @unique @db.Text
  storage_url   String    @db.Text
  file_size     BigInt
  uploaded_by   String?   @db.Uuid
  scan_status   String?   @default("PENDING") @db.VarChar(50)
  scan_result   String?   @db.Text
  privacy_level String    @default("RESTRICTED") @db.VarChar(20)
  is_active     Boolean   @default(true)
  uploaded_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @updatedAt @db.Timestamp(6)

  @@index([uploaded_by])
  @@index([scan_status])
  @@index([privacy_level])
  @@index([uploaded_at])
  @@map("file_metadata")
}

model file_access_logs {
  id          Int       @id @default(autoincrement())
  file_id     Int?
  user_id     String?   @db.Uuid
  access_type String    @db.VarChar(50)
  ip_address  String?   @db.VarChar(45)
  user_agent  String?   @db.Text
  accessed_at DateTime  @default(now()) @db.Timestamp(6)
  notes       String?   @db.Text

  @@index([file_id])
  @@index([user_id])
  @@map("file_access_logs")
}

model file_deletion_log {
  id                Int       @id @default(autoincrement())
  file_id           Int?
  file_name         String?   @db.VarChar(255)
  storage_key       String?   @db.Text
  category          String?   @db.VarChar(100)
  file_size         BigInt?
  is_hipaa_protected Boolean?
  uploaded_by       String?   @db.Uuid
  deleted_by        String?   @db.Uuid
  deletion_reason   String?   @db.Text
  deletion_type     String?   @db.VarChar(50)
  deleted_at        DateTime  @default(now()) @db.Timestamp(6)
  ip_address        String?   @db.VarChar(45)

  @@index([deleted_by])
  @@map("file_deletion_log")
}

model batch_upload_logs {
  id                      Int       @id @default(autoincrement())
  batch_id                String    @db.VarChar(100)
  uploaded_by             String?   @db.Uuid
  total_files             Int?
  successful_files        Int?
  failed_files            Int?
  total_processing_time_ms Int?
  category                String?   @db.VarChar(100)
  is_hipaa_protected      Boolean?
  completed_at            DateTime  @default(now()) @db.Timestamp(6)

  @@index([uploaded_by])
  @@map("batch_upload_logs")
}

// ===================================================================
// 👥 STAFF MANAGEMENT
// ===================================================================

model staff {
  id                Int       @id @default(autoincrement())
  user_id           String?   @db.Uuid
  employee_id       String?   @db.VarChar(50)
  position          String?   @db.VarChar(100)
  department        String?   @db.VarChar(100)
  shift             String?   @db.VarChar(50)
  salary            Float?
  hire_date         DateTime? @db.Date
  join_date         DateTime? @db.Date
  supervisor_id     Int?
  emergency_contact Json?     @db.JsonB
  skills            String[]
  certifications    String[]
  notes             String?   @db.Text
  is_active         Boolean   @default(true)
  on_leave          Boolean   @default(false)
  archived          Boolean   @default(false)
  updated_by        String?   @db.Uuid
  created_by        String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)

  @@index([user_id])
  @@index([department])
  @@index([is_active])
  @@map("staff")
}

model staff_attendance {
  id            Int       @id @default(autoincrement())
  staff_id      Int
  staff_uid     String?   @db.Uuid
  type          String?   @db.VarChar(20)
  location      String?   @db.VarChar(255)
  ip_address    String?   @db.VarChar(45)
  device_info   String?   @db.Text
  check_in_time DateTime? @db.Timestamp(6)
  timestamp     DateTime  @default(now()) @db.Timestamp(6)
  created_at    DateTime  @default(now()) @db.Timestamp(6)

  @@index([staff_id])
  @@index([staff_uid])
  @@index([type])
  @@index([timestamp])
  @@map("staff_attendance")
}

model staff_devices {
  id                   Int       @id @default(autoincrement())
  staff_id             Int?
  device_id            String    @db.VarChar(255)
  device_name          String?   @db.VarChar(255)
  device_token         String?   @db.Text
  is_active            Boolean   @default(true)
  registered_at        DateTime  @default(now()) @db.Timestamp(6)
  registered_location  String?   @db.VarChar(255)
  trust_expires_at     DateTime? @db.Timestamp(6)
  last_used            DateTime? @db.Timestamp(6)

  @@index([staff_id])
  @@index([device_id])
  @@map("staff_devices")
}

model staff_auth_sessions {
  id            Int       @id @default(autoincrement())
  staff_id      Int?
  device_id     String?   @db.VarChar(255)
  session_token String    @db.Text
  expires_at    DateTime  @db.Timestamp(6)
  ip_address    String?   @db.VarChar(45)

  @@index([admitting_doctor])
  @@index([admitted_at])
  @@map("admissions")
}

// ===================================================================
// 🧠 CLINICAL DECISION SUPPORT (CDS)
// ===================================================================

model drug_interactions {
  id              Int       @id @default(autoincrement())
  drug_a          String    @db.VarChar(255)
  drug_b          String    @db.VarChar(255)
  severity        String    @db.VarChar(20) // mild, moderate, severe, contraindicated
  description     String    @db.Text
  clinical_effect String?   @db.Text
  management      String?   @db.Text
  source          String?   @db.VarChar(100) // e.g., "DrugBank", "FDA", "manual"
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  @@index([drug_a])
  @@index([drug_b])
  @@map("drug_interactions")
}

model clinical_protocols {
  id              Int       @id @default(autoincrement())
  name            String    @unique @db.VarChar(255)
  category        String    @db.VarChar(100) // dvt_prophylaxis, pain_management, sepsis, post_op, falls_prevention
  trigger_conditions Json   // conditions that trigger this protocol
  recommendations Json     // recommended actions
  priority        String    @default("medium") @db.VarChar(20)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  @@index([category])
  @@map("clinical_protocols")
}

model cds_alerts {
  id              Int       @id @default(autoincrement())
  patient_uid     String    @db.Uuid
  encounter_id    String?   @db.Uuid
  alert_type      String    @db.VarChar(50) // drug_interaction, allergy, critical_lab, protocol_reminder, duplicate_order
  severity        String    @db.VarChar(20) // info, warning, critical
  title           String    @db.VarChar(255)
  description     String    @db.Text
  source_data     Json?     // the data that triggered the alert
  acknowledged    Boolean   @default(false)
  acknowledged_by String?   @db.Uuid
  acknowledged_at DateTime? @db.Timestamp(6)
  override_reason String?   @db.Text
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  @@index([patient_uid])
  @@index([encounter_id])
  @@index([alert_type])
  @@index([acknowledged])
  @@map("cds_alerts")
}

// ===================================================================
// 🏥 DIAGNOSIS & PROBLEM LIST
// ===================================================================

model diagnoses {
  id              Int       @id @default(autoincrement())
  patient_uid     String    @db.Uuid
  encounter_id    String?   @db.Uuid
  icd10_code      String?   @db.VarChar(10)
  icd10_description String? @db.VarChar(500)
  description     String    @db.Text
  diagnosis_type  String    @default("secondary") @db.VarChar(20) // primary, secondary, admitting, discharge
  status          String    @default("active") @db.VarChar(20) // active, resolved, chronic, recurrent
  onset_date      DateTime? @db.Date
  resolved_date   DateTime? @db.Date
  severity        String?   @db.VarChar(20) // mild, moderate, severe
  diagnosed_by    String    @db.Uuid
  notes           String?   @db.Text
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @db.Timestamp(6)

  @@index([patient_uid])
  @@index([encounter_id])
  @@index([icd10_code])
  @@index([status])
  @@map("diagnoses")
}

model icd10_codes {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(10)
  description     String    @db.VarChar(500)
  category        String    @db.VarChar(255)
  chapter         String?   @db.VarChar(10)
  is_billable     Boolean   @default(true)

  @@index([code])
  @@index([description])
  @@map("icd10_codes")
}

// ===================================================================
// CPOE — Computerized Provider Order Entry
// ===================================================================

model clinical_orders {
  id              Int       @id @default(autoincrement())
  order_number    String    @unique @db.VarChar(50)
  encounter_id    String?   @db.Uuid
  patient_uid     String    @db.Uuid
  order_type      String    @db.VarChar(30) // medication, investigation, nursing, diet, activity, consultation
  priority        String    @default("routine") @db.VarChar(20) // stat, urgent, routine, prn
  details         Json      // Order-specific details (see below)
  status          String    @default("ordered") @db.VarChar(30) // ordered, verified, in_progress, completed, cancelled, discontinued
  ordered_by      String    @db.Uuid
  verified_by     String?   @db.Uuid
  verified_at     DateTime? @db.Timestamp(6)
  completed_by    String?   @db.Uuid
  completed_at    DateTime? @db.Timestamp(6)
  cancelled_by    String?   @db.Uuid
  cancel_reason   String?   @db.Text
  start_date      DateTime? @db.Timestamp(6)
  end_date        DateTime? @db.Timestamp(6)
  notes           String?   @db.Text
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  @@index([patient_uid])
  @@index([encounter_id])
  @@index([order_type])
  @@index([status])
  @@index([ordered_by])
  @@map("clinical_orders")
}

model order_sets {
  id              Int       @id @default(autoincrement())
  name            String    @unique @db.VarChar(255)
  description     String?   @db.Text
  category        String    @db.VarChar(100) // post_op, admission, icu, general
  orders          Json      // Array of order templates
  created_by      String    @db.Uuid
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  @@index([category])
  @@map("order_sets")
}

// ===================================================================
// Vitals Charting
// ===================================================================

model vitals_chart {
  id              Int       @id @default(autoincrement())
  patient_uid     String    @db.Uuid
  encounter_id    String?   @db.Uuid
  heart_rate      Int?

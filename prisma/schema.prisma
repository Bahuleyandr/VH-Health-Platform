  culture_date        DateTime? @db.Date
  antibiotic_sensitivity Json?
  isolation_required  Boolean   @default(false)
  isolation_type      String?   @db.VarChar(50) // contact, droplet, airborne, protective
  status              String    @default("active") @db.VarChar(20) // active, treated, resolved, deceased
  treatment_notes     String?   @db.Text
  reported_by         String    @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamp(6)

  @@index([patient_uid])
  @@index([organism])
  @@index([status])
  @@map("infection_cases")
}

// ===================================================================
// 🔄 REFERRAL MANAGEMENT

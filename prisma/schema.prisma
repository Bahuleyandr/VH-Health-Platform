// ===================================================================
// 🏥 OPERATING THEATRE
// ===================================================================

model ot_schedules {
  id                  Int       @id @default(autoincrement())
  patient_uid         String    @db.Uuid
  encounter_id        String?   @db.Uuid
  surgeon             String    @db.Uuid
  anesthetist         String?   @db.Uuid
  procedure_name      String    @db.VarChar(255)
  procedure_code      String?   @db.VarChar(20)
  ot_room             String?   @db.VarChar(20)
  scheduled_date      DateTime  @db.Date
  scheduled_time      String?   @db.VarChar(10)
  estimated_duration  Int?      // minutes
  actual_duration     Int?
  status              String    @default("scheduled") @db.VarChar(30) // scheduled, pre_op, in_progress, post_op, completed, cancelled
  pre_op_checklist    Json?
  equipment_needed    String[]  @default([])
  blood_arranged      Boolean   @default(false)
  consent_obtained    Boolean   @default(false)
  post_op_notes       String?   @db.Text
  complications       String?   @db.Text

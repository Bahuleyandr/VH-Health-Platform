// ===================================================================
// 🩸 BLOOD BANK
// ===================================================================

model blood_requests {
  id                  Int       @id @default(autoincrement())
  patient_uid         String    @db.Uuid
  encounter_id        String?   @db.Uuid
  blood_group         String    @db.VarChar(10) // A+, A-, B+, B-, AB+, AB-, O+, O-
  component           String    @db.VarChar(30) // whole_blood, prbc, ffp, platelets, cryoprecipitate
  units               Int
  urgency             String    @default("routine") @db.VarChar(20) // routine, urgent, emergency
  clinical_indication String    @db.Text
  cross_match_status  String    @default("pending") @db.VarChar(20) // pending, compatible, incompatible
  cross_matched_by    String?   @db.Uuid
  cross_matched_at    DateTime? @db.Timestamp(6)
  issued              Boolean   @default(false)
  issued_by           String?   @db.Uuid
  issued_at           DateTime? @db.Timestamp(6)
  transfused          Boolean   @default(false)
  transfusion_reaction String? @db.Text
  status              String    @default("requested") @db.VarChar(20) // requested, cross_matched, issued, transfused, cancelled
  ordered_by          String    @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamp(6)

  @@index([patient_uid])
  @@index([blood_group])
  @@index([status])
  @@map("blood_requests")
}

// ===================================================================
// 🏥 ABDM (Ayushman Bharat Digital Mission) — Consent & Data Exchange
// ===================================================================

model abdm_consents {
  id                  Int       @id @default(autoincrement())
  consent_id          String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_uid         String    @db.Uuid
  hip_id              String?   @db.VarChar(100)
  hiu_id              String?   @db.VarChar(100)
  purpose             String    @db.VarChar(50) // CAREMGT, BREAK_THE_GLASS, PUBHLTH, HPAYMT, DSRCH
  hi_types            String[]  @default([]) // OPConsultation, Prescription, DischargeSummary, DiagnosticReport, ImmunizationRecord
  date_range_from     DateTime? @db.Date
  date_range_to       DateTime? @db.Date
  expiry_date         DateTime  @db.Timestamp(6)
  status              String    @default("REQUESTED") @db.VarChar(20) // REQUESTED, GRANTED, DENIED, REVOKED, EXPIRED
  consent_artifact    Json?
  requester_name      String?   @db.VarChar(255)
  granted_at          DateTime? @db.Timestamp(6)
  revoked_at          DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)

  @@index([patient_uid])
  @@index([status])
  @@map("abdm_consents")
}

model abdm_data_requests {
  id                  Int       @id @default(autoincrement())
  transaction_id      String    @unique @db.VarChar(100)
  consent_id          String    @db.Uuid
  patient_uid         String    @db.Uuid
  hi_types            String[]  @default([])
  date_range_from     DateTime? @db.Date
  date_range_to       DateTime? @db.Date
  key_material        Json?     // Public key for encryption
  status              String    @default("REQUESTED") @db.VarChar(20) // REQUESTED, PROCESSING, DELIVERED, FAILED
  delivered_at        DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)

  @@index([consent_id])
  @@index([patient_uid])
  @@map("abdm_data_requests")
}

model step_logs {
  id           Int      @id @default(autoincrement())
  patient_uid  String   @db.Uuid
  log_date     DateTime @db.Date
  steps        Int      @default(0)
  distance_km  Decimal  @db.Decimal(8, 3) @default(0)
  active_min   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  @@unique([patient_uid, log_date])
  @@index([patient_uid])
  @@index([log_date])
  @@map("step_logs")
}

model step_profile {
  id                   Int      @id @default(autoincrement())
  patient_uid          String   @unique @db.Uuid
  leaderboard_name     String   @db.VarChar(30)
  avatar_color         String?  @db.VarChar(7)
  opt_out_leaderboard  Boolean  @default(false)
  total_steps          BigInt   @default(0)
  total_distance_km    Decimal  @db.Decimal(10, 3) @default(0)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @updatedAt @db.Timestamp(6)

  @@map("step_profile")
}

model step_sessions {
  id           Int       @id @default(autoincrement())
  patient_uid  String    @db.Uuid
  started_at   DateTime  @db.Timestamp(6)
  ended_at     DateTime? @db.Timestamp(6)
  steps        Int       @default(0)
  distance_km  Decimal   @db.Decimal(8, 3) @default(0)
  duration_sec Int       @default(0)
  route_points Json?
  created_at   DateTime  @default(now()) @db.Timestamp(6)

  @@index([patient_uid])
  @@index([started_at])
  @@map("step_sessions")
}

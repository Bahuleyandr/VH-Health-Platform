generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_RENDER")
}

model appointments {
  id          Int       @id @default(autoincrement())
  phone       String    @db.VarChar(15)
  doctor_name String
  date        DateTime  @db.Date
  time        String
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model consultations {
  id                 Int       @id @default(autoincrement())
  phone              String?   @db.VarChar(15)
  consultation_notes String?
  consulted_at       DateTime? @default(now()) @db.Timestamp(6)
  file_name          String?
  file_type          String?   @db.VarChar(50)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
}

model departments {
  id      Int       @id @default(autoincrement())
  name    String    @unique @db.VarChar(100)
  doctors doctors[]
}

model doctors {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(100)
  department    String       @db.VarChar(100)
  intro         String?
  image_url     String?
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  department_id Int?
  specialty     String?
  departments   departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_doctors_department_id")
}

model feedback {
  id          Int       @id @default(autoincrement())
  phone       String?   @db.VarChar(15)
  message     String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  phonenumber String?   @db.VarChar(15)
  rating      Int?
  comment     String?
}

model file_metadata {
  id          Int       @id @default(autoincrement())
  file_name   String
  file_type   String
  storage_key String    @unique
  storage_url String
  file_size   BigInt
  uploaded_by String?
  uploaded_at DateTime? @default(now()) @db.Timestamp(6)
}

model health_records {
  id         Int       @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  file_name  String
  file_type  String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model investigations {
  id           Int       @id @default(autoincrement())
  phone        String    @db.VarChar(15)
  test_name    String
  requested_at DateTime? @default(now()) @db.Timestamp(6)
  result_file  String?
  status       String?   @default("pending") @db.VarChar(50)
}

model pharmacy_orders {
  id         Int       @id @default(autoincrement())
  phone      String    @db.VarChar(15)
  order_note String?
  status     String?   @default("pending") @db.VarChar(50)
  placed_at  DateTime? @default(now()) @db.Timestamp(6)
}

model sos_alerts {
  id         Int       @id @default(autoincrement())
  phone      String?   @db.VarChar(15)
  latitude   Float?
  longitude  Float?
  alert_type String?   @db.VarChar(50)
  raised_at  DateTime? @default(now()) @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model staff_attendance {
  id        Int       @id @default(autoincrement())
  staff_id  Int
  timestamp DateTime? @default(now()) @db.Timestamp(6)
  type      String?   @db.VarChar(10)
}

model users {
  id              Int       @id @default(autoincrement())
  phone           String    @unique @db.VarChar(15)
  name            String?
  gender          String?
  address         String?
  email           String?
  birthday        DateTime? @db.Date
  anniversary     DateTime? @db.Date
  profile_picture String?
  registered_at   DateTime? @default(now()) @db.Timestamp(6)
  uid             String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}
